<mxfile host="app.diagrams.net" modified="2026-11-23T00:00:00Z" agent="Cypher" version="24.7.17" type="device" pages="1"><diagram name="FN-00 — Mapa geral de navegação (revisado)" id="FN-00-REVISADO"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1760" pageHeight="1040" background="#F5F3EA" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="f00-bgcon" value="" style="rounded=1;arcSize=8;html=1;fillColor=#EEF3EA;strokeColor=#D2DDD0;strokeWidth=1.2;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="64" y="166" width="1038" height="212" as="geometry"/></mxCell><mxCell id="f00-bgadm" value="" style="rounded=1;arcSize=8;html=1;fillColor=#F2F2EB;strokeColor=#D4D9CE;strokeWidth=1.2;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="1128" y="166" width="570" height="212" as="geometry"/></mxCell><mxCell id="f00-eyebrow" value="&lt;b style='font-size:13px;letter-spacing:1.5px;color:#537A51'&gt;CYPHER  •  DOCUMENTAÇÃO DE NAVEGAÇÃO&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontColor=#23412F;fontSize=14;spacing=0;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="64" y="22" width="1600" height="30" as="geometry"/></mxCell><mxCell id="f00-heading" value="&lt;b style='font-size:30px;color:#203C29'&gt;FN-00  |  Mapa geral de navegação&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontColor=#23412F;fontSize=14;spacing=0;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="64" y="57" width="1600" height="53" as="geometry"/></mxCell><mxCell id="f00-subhead" value="&lt;span style='font-size:15px;color:#526957'&gt;Visão macro dos acessos e destinos • referência para FN-01 a FN-09&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontColor=#23412F;fontSize=14;spacing=0;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="64" y="112" width="1600" height="35" as="geometry"/></mxCell><mxCell id="f00-conlabel" value="&lt;b style='font-size:13px;letter-spacing:1px;color:#56705A'&gt;ACESSO CONVENCIONAL  ·  CONSUMIDOR OU PROFISSIONAL&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontColor=#23412F;fontSize=14;spacing=0;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="84" y="180" width="960" height="30" as="geometry"/></mxCell><mxCell id="f00-admlabel" value="&lt;b style='font-size:13px;letter-spacing:1px;color:#56705A'&gt;ACESSO ADMINISTRATIVO  ·  INDEPENDENTE&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontColor=#23412F;fontSize=14;spacing=0;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="1146" y="180" width="515" height="30" as="geometry"/></mxCell><mxCell id="f00-auth" value="&lt;div style=&quot;font-family:Arial;font-weight:700;font-size:16px;line-height:1.3&quot;&gt;Login / Cadastro&lt;/div&gt;&lt;div style=&quot;font-family:Arial;font-size:11px;line-height:1.3;margin-top:5px;color:#E0EDE0&quot;&gt;/login • /register&lt;/div&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=#294A35;strokeColor=#294A35;strokeWidth=1.6;fontColor=#FFFFFF;fontSize=16;spacing=10;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="90" y="234" width="210" height="75" as="geometry"/></mxCell><mxCell id="f00-session" value="&lt;div style=&quot;font-family:Arial;font-weight:700;font-size:16px;line-height:1.3&quot;&gt;Acesso autorizado&lt;/div&gt;&lt;div style=&quot;font-family:Arial;font-size:11px;line-height:1.3;margin-top:5px;color:#46664D&quot;&gt;Conta ativa + e-mail confirmado&lt;/div&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=#DCE8DA;strokeColor=#A3B8A2;strokeWidth=1.6;fontColor=#183322;fontSize=15;spacing=10;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="344" y="234" width="208" height="75" as="geometry"/></mxCell><mxCell id="f00-home" value="&lt;div style=&quot;font-family:Arial;font-weight:700;font-size:16px;line-height:1.3&quot;&gt;Descoberta&lt;/div&gt;&lt;div style=&quot;font-family:Arial;font-size:11px;line-height:1.3;margin-top:5px;color:#E0EDE0&quot;&gt;Página inicial&lt;/div&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=#537A51;strokeColor=#537A51;strokeWidth=1.6;fontColor=#FFFFFF;fontSize=16;spacing=10;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="594" y="234" width="190" height="75" as="geometry"/></mxCell><mxCell id="f00-hub" value="&lt;div style=&quot;font-size:17px;font-weight:700&quot;&gt;Menu / atalhos&lt;/div&gt;&lt;div style=&quot;font-size:12px;margin-top:4px&quot;&gt;Componente de navegação&lt;/div&gt;" style="rounded=1;arcSize=7;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=#FFFEFA;strokeColor=#8AA18E;strokeWidth=1.6;dashed=1;dashPattern=5 4;fontColor=#27432D;fontSize=16;spacing=8;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="828" y="234" width="228" height="75" as="geometry"/></mxCell><mxCell id="f00-connotice" value="&lt;span style='font-size:12px'&gt;Cadastro, recuperação e conversão são detalhados no FN-01. O menu permanece disponível nas áreas autorizadas.&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;strokeColor=none;fillColor=none;fontColor=#596C5D;fontSize=13;spacing=0;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="87" y="324" width="987" height="38" as="geometry"/></mxCell><mxCell id="f00-adminlogin" value="&lt;div style=&quot;font-family:Arial;font-weight:700;font-size:16px;line-height:1.3&quot;&gt;Login administrativo&lt;/div&gt;&lt;div style=&quot;font-family:Arial;font-size:11px;line-height:1.3;margin-top:5px;color:#E0EDE0&quot;&gt;/admin/login&lt;/div&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=#294A35;strokeColor=#294A35;strokeWidth=1.6;fontColor=#FFFFFF;fontSize=16;spacing=10;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="1151" y="234" width="220" height="75" as="geometry"/></mxCell><mxCell id="f00-adminpanel" value="&lt;div style=&quot;font-family:Arial;font-weight:700;font-size:16px;line-height:1.3&quot;&gt;Painel administrativo&lt;/div&gt;&lt;div style=&quot;font-family:Arial;font-size:11px;line-height:1.3;margin-top:5px;color:#E0EDE0&quot;&gt;/admin&lt;/div&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=#294A35;strokeColor=#294A35;strokeWidth=1.6;fontColor=#FFFFFF;fontSize=16;spacing=10;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="1414" y="234" width="240" height="75" as="geometry"/></mxCell><mxCell id="f00-adminnotice" value="&lt;span style='font-size:12px'&gt;Gestão por papel: Administrador Geral, Moderador e Editor (FN-09). Sem perfil público profissional.&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;strokeColor=none;fillColor=none;fontColor=#596C5D;fontSize=13;spacing=0;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="1150" y="320" width="520" height="47" as="geometry"/></mxCell><mxCell id="f00-explore" value="&lt;div style=&quot;font-family:Arial&quot;&gt;&lt;div style=&quot;font-size:17px;font-weight:700;color:#294A35&quot;&gt;EXPLORAR&lt;/div&gt;&lt;div style=&quot;font-size:12px;color:#627666;margin-top:4px&quot;&gt;Acessível às contas convencionais autenticadas&lt;/div&gt;&lt;div style=&quot;margin-top:15px&quot;&gt;&lt;div style=&quot;font-size:15px;line-height:1.35;padding:10px 0;border-bottom:1px solid #E1E7DF;color:#1D3326&quot;&gt;Buscar pessoas → Perfil profissional → Portfólio&lt;span style=&quot;font-size:12px;color:#67816C&quot;&gt;  · FN-02 / FN-03&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:1.35;padding:10px 0;border-bottom:1px solid #E1E7DF;color:#1D3326&quot;&gt;Obras e lançamentos → Ficha&lt;span style=&quot;font-size:12px;color:#67816C&quot;&gt;  · FN-02 / FN-04&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:1.35;padding:10px 0;border-bottom:1px solid #E1E7DF;color:#1D3326&quot;&gt;Banco de Beats → Ficha / Ofertas&lt;span style=&quot;font-size:12px;color:#67816C&quot;&gt;  · FN-05&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:1.35;padding:10px 0;border-bottom:1px solid #E1E7DF;color:#1D3326&quot;&gt;Eventos → Ficha / Participação&lt;span style=&quot;font-size:12px;color:#67816C&quot;&gt;  · FN-06&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:1.35;padding:10px 0;border-bottom:1px solid #E1E7DF;color:#1D3326&quot;&gt;Oportunidades → Ficha / Candidatura&lt;span style=&quot;font-size:12px;color:#67816C&quot;&gt;  · FN-07&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:1.35;padding:10px 0;border-bottom:1px solid #E1E7DF;color:#1D3326&quot;&gt;Cypher Central → Guias&lt;span style=&quot;font-size:12px;color:#67816C&quot;&gt;  · RF-126–131&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;div style=&quot;font-size:12px;line-height:1.45;color:#5E725F;margin-top:13px&quot;&gt;Cada linha representa um destino próprio; não uma sequência entre os conteúdos.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=7;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fillColor=#FFFEFA;strokeColor=#C6D5C4;strokeWidth=1.5;fontColor=#1C3224;fontSize=15;spacing=22;spacingTop=19;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="64" y="502" width="508" height="428" as="geometry"/></mxCell><mxCell id="f00-account" value="&lt;div style=&quot;font-family:Arial&quot;&gt;&lt;div style=&quot;font-size:17px;font-weight:700;color:#294A35&quot;&gt;CONTA E INTERAÇÕES&lt;/div&gt;&lt;div style=&quot;font-size:12px;color:#627666;margin-top:4px&quot;&gt;Ações pessoais; disponibilidade sujeita à permissão&lt;/div&gt;&lt;div style=&quot;margin-top:15px&quot;&gt;&lt;div style=&quot;font-size:15px;line-height:1.35;padding:10px 0;border-bottom:1px solid #E1E7DF;color:#1D3326&quot;&gt;Meu perfil → Editar / Privacidade&lt;span style=&quot;font-size:12px;color:#67816C&quot;&gt;  · FN-03&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:1.35;padding:10px 0;border-bottom:1px solid #E1E7DF;color:#1D3326&quot;&gt;Configurações da conta&lt;span style=&quot;font-size:12px;color:#67816C&quot;&gt;  · RF-019&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:1.35;padding:10px 0;border-bottom:1px solid #E1E7DF;color:#1D3326&quot;&gt;Seguindo / Salvos&lt;span style=&quot;font-size:12px;color:#67816C&quot;&gt;  · FN-08&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:1.35;padding:10px 0;border-bottom:1px solid #E1E7DF;color:#1D3326&quot;&gt;Mensagens privadas / Notificações&lt;span style=&quot;font-size:12px;color:#67816C&quot;&gt;  · FN-08&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:1.35;padding:10px 0;border-bottom:1px solid #E1E7DF;color:#1D3326&quot;&gt;Minhas Compras → Licenças de teste&lt;span style=&quot;font-size:12px;color:#67816C&quot;&gt;  · FN-05&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:1.35;padding:10px 0;border-bottom:1px solid #E1E7DF;color:#1D3326&quot;&gt;Consumidor → Ativação profissional&lt;span style=&quot;font-size:12px;color:#67816C&quot;&gt;  · FN-01&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;div style=&quot;font-size:12px;line-height:1.45;color:#5E725F;margin-top:13px&quot;&gt;Perfil de Consumidor é privado; não existe uma segunda conta ao profissionalizar.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=7;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fillColor=#FFFEFA;strokeColor=#C6D5C4;strokeWidth=1.5;fontColor=#1C3224;fontSize=15;spacing=22;spacingTop=19;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="625" y="502" width="506" height="428" as="geometry"/></mxCell><mxCell id="f00-prof" value="&lt;div style=&quot;font-family:Arial&quot;&gt;&lt;div style=&quot;font-size:17px;font-weight:700;color:#294A35&quot;&gt;ÁREA PROFISSIONAL&lt;/div&gt;&lt;div style=&quot;font-size:12px;color:#627666;margin-top:4px&quot;&gt;Exclusiva de contas com atuação profissional ativa&lt;/div&gt;&lt;div style=&quot;margin-top:15px&quot;&gt;&lt;div style=&quot;font-size:15px;line-height:1.35;padding:10px 0;border-bottom:1px solid #E1E7DF;color:#1D3326&quot;&gt;Espaço de Trabalho → Acervo / Fichas&lt;span style=&quot;font-size:12px;color:#67816C&quot;&gt;  · FN-04&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:1.35;padding:10px 0;border-bottom:1px solid #E1E7DF;color:#1D3326&quot;&gt;Publicar → Escolher modalidade permitida&lt;span style=&quot;font-size:12px;color:#67816C&quot;&gt;  · FN-04&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:1.35;padding:10px 0;border-bottom:1px solid #E1E7DF;color:#1D3326&quot;&gt;Obras, beats, eventos, projetos e galerias&lt;span style=&quot;font-size:12px;color:#67816C&quot;&gt;  · FN-04–06&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:1.35;padding:10px 0;border-bottom:1px solid #E1E7DF;color:#1D3326&quot;&gt;Chamadas e oportunidades próprias&lt;span style=&quot;font-size:12px;color:#67816C&quot;&gt;  · FN-07&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:1.35;padding:10px 0;border-bottom:1px solid #E1E7DF;color:#1D3326&quot;&gt;Portfólio / Selo no perfil unificado&lt;span style=&quot;font-size:12px;color:#67816C&quot;&gt;  · FN-03&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:1.35;padding:10px 0;border-bottom:1px solid #E1E7DF;color:#1D3326&quot;&gt;Collabs / Avaliações profissionais&lt;span style=&quot;font-size:12px;color:#67816C&quot;&gt;  · FN-08&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;div style=&quot;font-size:12px;line-height:1.45;color:#5E725F;margin-top:13px&quot;&gt;Publicações são alternativas, nunca etapas sucessivas. Exigem profissão compatível, vínculo legítimo e autorização.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=7;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fillColor=#FFFEFA;strokeColor=#C6D5C4;strokeWidth=1.5;fontColor=#1C3224;fontSize=15;spacing=22;spacingTop=19;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="1182" y="502" width="516" height="428" as="geometry"/></mxCell><mxCell id="f00-notes" value="&lt;b&gt;LEITURA:&lt;/b&gt; Setas indicam o acesso entre áreas. Os três cartões inferiores agrupam destinos independentes (não representam uma página adicional)." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;strokeColor=none;fillColor=none;fontColor=#596C5D;fontSize=13;spacing=0;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="64" y="959" width="1620" height="29" as="geometry"/></mxCell><mxCell id="f00-footer" value="&lt;b&gt;BASE:&lt;/b&gt; RN-001–046; RF-001–029, RF-056–069 e RF-088–146. Fluxo da versão final documentada; não comprova que todas as telas já estejam implementadas. Consumidor só solicita publicação excepcional mediante mediação/triagem (FN-07)." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;strokeColor=none;fillColor=none;fontColor=#596C5D;fontSize=13;spacing=0;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="64" y="990" width="1640" height="42" as="geometry"/></mxCell><mxCell id="f00-e-auth" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#83998A;strokeWidth=2;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="f00-auth" target="f00-session" value=""><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="f00-e-session" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#83998A;strokeWidth=2;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="f00-session" target="f00-home" value=""><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="f00-e-home" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#83998A;strokeWidth=2;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="f00-home" target="f00-hub" value=""><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="f00-e-admin" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#83998A;strokeWidth=2;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="f00-adminlogin" target="f00-adminpanel" value=""><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="f00-e-explore" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#819788;strokeWidth=2;endArrow=block;endFill=1;exitX=0.22;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="f00-hub" target="f00-explore" value=""><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="879" y="408"/><mxPoint x="318" y="408"/></Array></mxGeometry></mxCell><mxCell id="f00-e-account" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#819788;strokeWidth=2;endArrow=block;endFill=1;exitX=0.51;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="f00-hub" target="f00-account" value=""><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="944" y="435"/><mxPoint x="878" y="435"/></Array></mxGeometry></mxCell><mxCell id="f00-e-prof" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#819788;strokeWidth=2;endArrow=block;endFill=1;exitX=0.78;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="f00-hub" target="f00-prof" value=""><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1013" y="408"/><mxPoint x="1440" y="408"/></Array></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>