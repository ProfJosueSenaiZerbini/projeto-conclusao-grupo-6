<%- include('../partials/cabecalho', { title, stylesheet }) %>
<div class="app-shell">
<%- include('../partials/barra-lateral', { path }) %>
<main class="main-shell">
<%- include('../partials/barra-superior', { breadcrumb: 'Visão geral', showSearch: true }) %>
<div class="page-content">
<div class="page-header">
  <div>
    <div class="eyebrow">
      QUINTA-FEIRA · 01 OUT 2026
    </div>
    <h1>
      A cena se move quando
      <em>
        a gente se conecta.
      </em>
    </h1>
    <p>
      Bom te ver,<%= usuario.name %>. Aqui está o que acontece no seu
            espaço.
    </p>
  </div>
</div>
<section class="hero-grid">
  <div class="hero-card lime-card">
    <span class="pill pill-dark">
      SEU CICLO
    </span>
    <h2>
      Descobrir.  
Conectar.
      <span>
        Criar.
      </span>
    </h2>
    <p>
      O Cypher organiza o caminho entre uma oportunidade e a próxima obra.
    </p>
    <div class="cycle-stamp">
      <span>
        01
      </span>
      <div>
        <strong>
          Próximo passo
        </strong>
        <b>
          Encontrar colaboradores
        </b>
      </div>
      <span class="lucide-icon" aria-hidden="true">
        <%- icones.arrowRight %>
      </span>
    </div>
  </div>
  <div class="stat-stack">
    <a class="stat-card stat-yellow stat-link" href="/works" aria-label="Abrir Obras:<%= estatisticasObras.emAndamento %>em andamento" >
      <span>
        Obras em andamento
      </span>
      <strong>
        <%= String( estatisticasObras.emAndamento ).padStart(2, '0') %>
      </strong>
      <small>
        Ver catálogo de Obras
        <span class="lucide-icon" aria-hidden="true">
          <%- icones.arrowUpRight %>
        </span>
      </small>
    </a>
    <div class="stat-card stat-white">
      <span>
        Conexões profissionais
      </span>
      <strong>
        28
      </strong>
      <small>
        4 aguardando resposta
      </small>
    </div>
  </div>
  <article class="accent-note hit-month-card">
    <span class="lucide-icon hit-month-icon" aria-hidden="true" >
      <%- icones.audioLines %>
    </span>
    <span>
      HIT DO MÊS
    </span>
    <p>
      <%= hitDoMes.titulo %>
    </p>
    <strong>
      <%= hitDoMes.artista %>
    </strong>
    <small>
      <%= hitDoMes.genero %>
      ·<%= hitDoMes.duracao %>
    </small>
    <small class="hit-month-artist-label">
      ARTISTA DO MÊS ·<%= hitDoMes.rotulo %>
    </small>
  </article>
</section>
<div class="section-heading">
  <div>
    <div class="eyebrow">
      SEU MAPA AGORA
    </div>
    <h2>
      O que pede sua atenção
    </h2>
  </div>
  <a href="/events" class="text-link">
    Ver oportunidades
    <span class="lucide-icon" aria-hidden="true">
      <%- icones.arrowUpRight %>
    </span>
  </a>
</div>
<section class="attention-grid">
  <div class="agenda-card card-surface">
    <div class="card-heading">
      <div>
        <span class="eyebrow">
          PRÓXIMOS EVENTOS
        </span>
        <h3>
          Na sua rota
        </h3>
      </div>
    </div>
    <% eventos.slice(0,2).forEach(evento => { %>
      <a class="event-row" href="/events" aria-label="Ver oportunidade<%= evento.title %>" >
        <div class="date-tile date-<%= evento.color %>">
          <strong>
            <%= evento.date.split(' ')[0] %>
          </strong>
          <span>
            <%= evento.date.split(' ')[1] %>
          </span>
        </div>
        <div class="row-info">
          <strong>
            <%= evento.title %>
          </strong>
          <span>
            <%= evento.category %>
            ·<%= evento.location %>
          </span>
        </div>
        <span class="lucide-icon" aria-hidden="true">
          <%- icones.chevronRight %>
        </span>
      </a>
    <% }) %>
    <a href="/events" class="card-footer-link">
      Explorar oportunidades
      <span class="lucide-icon" aria-hidden="true">
        <%- icones.arrowUpRight %>
      </span>
    </a>
  </div>
  <div class="people-card card-surface">
    <div class="card-heading">
      <div>
        <span class="eyebrow">
          PESSOAS PARA CONHECER
        </span>
        <h3>
          Conexões que fazem sentido
        </h3>
      </div>
    </div>
    <% pessoas.slice(0,3).forEach(pessoa => { %>
      <a class="person-row" href="/search" aria-label="Encontrar<%= pessoa.name %>" >
        <div class="avatar avatar-<%= pessoa.tone %>">
          <%= pessoa.initials %>
        </div>
        <div class="row-info">
          <strong>
            <%= pessoa.name %>
          </strong>
          <span>
            <%= pessoa.role %>
            ·<%= pessoa.city %>
          </span>
        </div>
        <span class="lucide-icon" aria-hidden="true">
          <%- icones.arrowUpRight %>
        </span>
      </a>
    <% }) %>
    <a href="/search" class="card-footer-link">
      Buscar na cena
      <span class="lucide-icon" aria-hidden="true">
        <%- icones.arrowUpRight %>
      </span>
    </a>
  </div>
</section>
</div>
</main>
</div>
<%- include('../partials/fim-pagina') %>
