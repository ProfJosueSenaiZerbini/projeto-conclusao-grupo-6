<%- include('../partials/cabecalho', { title, stylesheet }) %>
<div class="app-shell">
<%- include('../partials/barra-lateral', { path }) %>
<main class="main-shell">
<%- include('../partials/barra-superior', { breadcrumb: 'Notificações' }) %>
<div class="page-content notifications-page">
<div class="page-header">
  <div>
    <div class="eyebrow">
      CENTRAL DE ATIVIDADES
    </div>
    <h1>
      Notificações
    </h1>
    <p>
      Acompanhe as atualizações reais relacionadas ao seu trabalho na Cypher.
    </p>
  </div>
  <% if (quantidadeNaoLidas > 0) { %>
    <form method="post" action="/notificacoes/marcar-todas-lidas">
      <button class="button button-outline" type="submit">
        Marcar todas como lidas
      </button>
    </form>
  <% } %>
</div>
<% if (notificacoes.length) { %>
  <section class="notifications-history card-surface" aria-label="Histórico de notificações">
    <% notificacoes.forEach(notificacao => { %>
      <article class="notification-history-item<%= notificacao.lida ? '' : ' notification-history-item-unread' %>">
        <div class="notification-history-mark" aria-hidden="true">
          <%- icones.bell %>
        </div>
        <div class="notification-history-copy">
          <strong>
            <%= notificacao.titulo %>
          </strong>
          <p>
            <%= notificacao.mensagem %>
          </p>
          <small>
            <%= notificacao.criadaEm %>
          </small>
        </div>
        <div class="notification-history-actions">
          <% if (notificacao.url) { %>
            <a class="text-link" href="<%= notificacao.url %>">
              Abrir
            </a>
          <% } %>
          <% if (!notificacao.lida) { %>
            <form method="post" action="/notificacoes/<%= encodeURIComponent(notificacao.id) %>/lida">
              <button class="button button-outline" type="submit">
                Marcar como lida
              </button>
            </form>
          <% } %>
        </div>
      </article>
    <% }) %>
  </section>
<% } else { %>
  <section class="notifications-empty card-surface">
    <span class="lucide-icon" aria-hidden="true">
      <%- icones.bell %>
    </span>
    <h2>
      Nenhuma notificação por enquanto
    </h2>
    <p>
      As atividades reais da sua conta aparecerão aqui quando acontecerem.
    </p>
  </section>
<% } %>
</div>
</main>
</div>
<%- include('../partials/fim-pagina') %>
