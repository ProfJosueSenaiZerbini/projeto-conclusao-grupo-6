<%- include('../partials/cabecalho',{title,stylesheet}) %>
<div class="dc-shell pt-shell">
<%- include('../partials/barra-lateral',{path}) %><div class="dc-page">
<%- include('../partials/componentes/cabecalho-descoberta',{titulo:'Trabalhos e galerias',tituloId:'pt-titulo',descricao:'Projetos, imagens e outras expressões da cena.'}) %>
<main class="pt-page" aria-labelledby="pt-titulo">
<% if(tela==='lista'){ %>
<header class="pt-heading pt-list-heading"><div><span class="op-eyebrow">ACERVO DA CENA / TRABALHOS</span><h2><%= meus?'Meus projetos e trabalhos':'Projetos e expressões' %></h2><p>Conheça projetos, galerias e experiências de quem faz a cena acontecer.</p></div><% if(podeCriar){ %><a class="pt-button pt-primary" href="/trabalhos-e-galerias/novo"><%- icones.plus %> Criar trabalho</a><% } %></header>
<section class="pt-catalog" aria-label="Explorar trabalhos">
<form class="pt-filters" method="get" action="/trabalhos-e-galerias"><label class="pt-search">Pesquisar trabalhos<input type="search" name="q" maxlength="120" value="<%= q %>" placeholder="Título, descrição ou profissional"></label><label>Formato<select name="modalidade"><option value="">Todos os formatos</option><% formatos.forEach(f=>{ %><option value="<%= f.id %>" <%= modalidade===f.id?'selected':'' %>><%= f.nome %></option><% }) %></select></label><details class="pt-more" <%= visibilidade||meus||ordem!=='recentes'?'open':'' %>><summary>Mais filtros<%= visibilidade||meus||ordem!=='recentes'?' • ativo':'' %></summary><div class="pt-more-fields"><label>Visibilidade<select name="visibilidade"><option value="">Todas</option><option value="publicos" <%= visibilidade==='publicos'?'selected':'' %>>Visíveis na Cypher</option><option value="privados" <%= visibilidade==='privados'?'selected':'' %>>Privados</option></select></label><label>Ordenar por<select name="ordem"><option value="recentes" <%= ordem==='recentes'?'selected':'' %>>Mais recentes</option><option value="antigos" <%= ordem==='antigos'?'selected':'' %>>Mais antigos</option><option value="titulo" <%= ordem==='titulo'?'selected':'' %>>Título (A–Z)</option></select></label><label class="pt-check"><input type="checkbox" name="meus" value="sim" <%= meus?'checked':'' %>> meus trabalho</label></div></details><div class="pt-filter-actions"><button class="pt-button pt-primary" type="submit">Aplicar filtros</button><a class="pt-clear" href="/trabalhos-e-galerias">Limpar</a></div></form>
<div class="pt-results"><p role="status"><strong><%= itens.length %></strong> <%= itens.length===1?'trabalho encontrado':'trabalhos encontrados' %></p></div>
<div class="pt-grid"><% itens.forEach(p=>{const capa=p.itens.find(i=>i.mime.startsWith('image/')); const formato=formatos.find(f=>f.id===p.modalidade)?.nome||'Projeto'; %><a class="pt-card" href="/trabalhos-e-galerias/<%= p.id %>"><div class="pt-card-art"><% if(capa){ %><img src="<%= capa.url %>" alt="" loading="lazy"><% }else{ %><span aria-hidden="true"><%- icones[({visual:'brush',audiovisual:'clapperboard',audio:'headphones',danca:'footprints',texto:'pen',tecnico:'sliders'})[p.modalidade]||'briefcase'] %></span><% } %><span class="pt-card-format"><%= formato %></span></div><div class="pt-card-body"><div class="pt-card-meta"><span><%= p.publico?'Visível na Cypher':'Privado' %></span><span><%= p.itens.length %> <%= p.itens.length===1?'material':'materiais' %></span></div><h3><%= p.titulo %></h3><p class="pt-card-author">por <%= p.autor %></p><p class="pt-card-description"><%= p.descricao %></p><span class="pt-card-link">Ver trabalho <span aria-hidden="true">→</span></span></div></a><% }) %></div>
<% if(!itens.length){ %><div class="pt-empty"><%- icones.briefcase %><h3>Nenhum trabalho encontrado.</h3><p><%= q||modalidade||visibilidade||meus?'Tente outros termos ou ajuste os filtros para explorar o acervo.':'Os trabalhos publicados aparecerão aqui.' %></p><% if(q||modalidade||visibilidade||meus){ %><a class="pt-button" href="/trabalhos-e-galerias">Limpar filtros</a><% }else if(podeCriar){ %><a class="pt-button pt-primary" href="/trabalhos-e-galerias/novo">Criar trabalho</a><% } %></div><% } %>
</section>
<% }else{ const p=projeto; %>
<a class="et-back" href="/trabalhos-e-galerias<%= p.autor_id===usuario.id?'?meus=sim':'' %>">← Voltar aos trabalhos</a>
<% if(salvo){ %><p class="pt-feedback" role="status">Trabalho salvo.</p><% } %>
<header class="pt-heading"><div><span class="op-eyebrow"><%= formatos.find(f=>f.id===p.modalidade)?.nome||'Projeto' %> · <%= p.publico?'Visível na Cypher':'Privado' %></span><h2><%= p.titulo %></h2><p><%= p.autor %></p></div><% if(p.autor_id===usuario.id){ %><a class="pt-button" href="/trabalhos-e-galerias/<%= p.id %>/editar">Editar trabalho</a><% } %></header>
<%- include('../partials/componentes/acoes-conteudo', { tipo:'projeto', id:p.id, denuncia: 'Denunciar este trabalho' }) %>
<% if(p.autor_id===usuario.id){ %><a class="ci-button" href="/publicacoes/projeto/<%= p.id %>/midias">Enviar mídia do trabalho</a><% } %>
<%- include('../partials/componentes/midias-publicacao',{tipo:'projeto',id:p.id}) %>
<section class="pt-panel"><h3>Sobre o trabalho</h3><p class="pt-prose"><%= p.descricao %></p><p class="pt-note">Informações e resultados declarados pelo responsável. A presença na equipe não comprova crédito confirmado ou Collab concluída.</p><dl class="pt-facts"><% [['objetivo','Objetivo'],['papel','Função exercida'],['inicio','Início'],['fim','Fim'],['equipe','Equipe / participantes'],['entregas','Entregas'],['resultados','Resultados']].forEach(([k,n])=>{if(p[k]){ %><div><dt><%= n %></dt><dd class="pt-prose"><%= p[k] %></dd></div><% }}) %><div><dt>Atuações</dt><dd><%= p.profissoes.map(id=>profissoes.find(f=>f.id===id)?.rotulo||id).join(' · ')||'Não informadas' %></dd></div></dl><% if(p.texto){ %><h3>Texto / relato</h3><div class="pt-prose"><%= p.texto %></div><% } %></section>
<section class="pt-panel"><h3>Materiais e trabalhos relacionados</h3><div class="pt-gallery"><% p.itens.forEach(i=>{ %><figure><% if(i.mime.startsWith('image/')){ %><a href="<%= i.url %>" target="_blank" rel="noopener"><img src="<%= i.url %>" alt="<%= i.legenda||i.nome %>" loading="lazy"></a><% }else if(i.mime.startsWith('video/')){ %><video controls preload="metadata" src="<%= i.url %>" aria-label="<%= i.legenda||i.nome %>"></video><% }else if(i.mime.startsWith('audio/')){ %><audio controls preload="metadata" src="<%= i.url %>" aria-label="<%= i.legenda||i.nome %>"></audio><% }else{ %><a class="pt-button" href="<%= i.url %>" <%- i.mime==='link'?'target="_blank" rel="noopener noreferrer"':'' %>><%= i.nome %> <%- icones.externalLink %></a><% } %><figcaption><%= i.legenda||i.nome %><% if(i.mime==='link'){ %><small>Link externo</small><% } %></figcaption></figure><% }) %></div><% if(!p.itens.length){ %><p class="pt-note">Nenhum material disponível para sua conta.</p><% } %></section>
<% if(p.autor_id===usuario.id){ %><details class="pt-panel"><summary>Retirar trabalho</summary><form action="/trabalhos-e-galerias/<%= p.id %>/retirar" method="post"><p>O trabalho deixará de ser exibido. Seus arquivos e os registros vinculados serão preservados.</p><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="pt-button pt-danger">Confirmar retirada</button></form></details><% } %>
<% } %>
</main><%- include('../partials/navegacao-mobile',{rotaAtual:path}) %></div></div>
<%- include('../partials/fim-pagina') %>
