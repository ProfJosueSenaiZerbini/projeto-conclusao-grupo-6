<%- include('../partials/cabecalho', { title, stylesheet }) %>
<main class="public-profile-page">
<div class="public-profile-brand">
  <a class="logo" href="/login" aria-label="Cypher — entrar">
    <span class="logo-mark" aria-hidden="true">
      <span>
      </span>
      <span>
      </span>
      <span>
      </span>
    </span>
    <span class="logo-word">
      CYPHER
    </span>
  </a>
  <a class="button button-outline" href="<%= authenticated ? '/profile' : '/login' %>">
    <%= authenticated ? 'Meu perfil' : 'Entrar' %>
  </a>
</div>
<% if (!perfil) { %>
<%- include('../partials/componentes/estado-vazio', {
      classe: 'profile-section card-surface',
      variacao: 'destaque',
      titulo: 'Este perfil não está disponível',
      descricao: 'O endereço pode estar incorreto ou a pessoa optou por manter o perfil privado.',
      acaoPrincipal: { href: '/login', label: 'Acessar Cypher' }
    }) %>
<% } else { %>
<div class="profile-layout public-profile-layout">
<section class="profile-hero" aria-labelledby="public-profile-name">
  <div class="profile-hero-main">
    <div class="profile-avatar-frame" aria-hidden="true"><div class="avatar avatar-hero"><%= perfil.initials %></div></div>
    <div class="profile-hero-copy">
      <p class="profile-hero-eyebrow">CYPHER · PERFIL PROFISSIONAL</p>
      <h1 id="public-profile-name"><%= perfil.name %></h1>
      <p class="profile-hero-meta"><%= perfil.categories.join(' · ') || perfil.role %></p>
      <p class="profile-hero-handle"><%= perfil.handle %><%= perfil.city ? ` · ${perfil.city}` : '' %></p>
      <div class="profile-hero-tags" aria-label="Categorias profissionais">
        <% perfil.categories.forEach((categoria, indice) => { %><span class="profile-category-chip<%= indice % 2 ? ' is-muted' : '' %>"><%= categoria %></span><% }) %>
        <% if (!perfil.categories.length) { %><span class="profile-category-chip is-muted">Nenhuma categoria compartilhada</span><% } %>
      </div>
      <p class="profile-kicker<%= perfil.availability ? (perfil.availability === 'indisponivel' ? ' is-unavailable' : ' is-available') : ' is-unknown' %>"><% if (perfil.availability) { %><span class="status-dot" aria-hidden="true"></span><% } %><%= perfil.availabilityLabel %></p>
    </div>
  </div>
</section>
<div class="profile-id-strip">
  <span class="lucide-icon" aria-hidden="true">
    <%- icones.tag %>
  </span>
  <div>
    <small>
      ID CYPHER · IDENTIFICADOR PÚBLICO
    </small>
    <strong>
      <%= perfil.publicCode %>
    </strong>
  </div>
  <span class="immutable-label">
    Imutável
  </span>
</div>
<nav class="profile-section-nav" aria-label="Seções do perfil" data-profile-section-nav>
  <a href="#sobre-publico">Sobre</a>
  <a href="#catalogo-publico">Catálogo</a>
  <a href="#equipamentos-publicos">Equipamentos</a>
  <a href="#atuacao-publica">Atuação profissional</a>
</nav>
<div class="profile-columns">
  <div class="profile-column-main">
    <section class="profile-section card-surface profile-about" id="sobre-publico" aria-labelledby="public-about-title">
      <div class="eyebrow">
        PERFIL PROFISSIONAL
      </div>
      <h3 id="public-about-title">
        <%= perfil.role %>
      </h3>
      <p class="bio">
        <%= perfil.biography || 'Apresentação profissional não informada.' %>
      </p>
      <% if (perfil.contact) { %>
        <div class="profile-public-contact">
          <span>
            Contato profissional
          </span>
          <strong>
            <%= perfil.contact %>
          </strong>
        </div>
      <% } %>
    </section>
<section class="profile-section card-surface public-works-section" id="catalogo-publico" aria-labelledby="public-works-title">
<div class="eyebrow">
  CATÁLOGO PÚBLICO
</div>
<div class="profile-catalog-heading"><h3 id="public-works-title">Obras lançadas</h3><span class="profile-catalog-count"><%= obras.length %> <%= obras.length === 1 ? 'obra' : 'obras' %></span></div>
<% if (obras.length) { %>
  <div class="public-works-list">
    <% obras.forEach((obra, index) => { %>
      <article class="public-work-card">
        <div class="public-work-heading">
          <div>
            <span class="work-index index-<%= index %>">
              0<%= index + 1 %>
            </span>
            <h4>
              <%= obra.title %>
            </h4>
          </div>
          <span class="status-label">
            <%= obra.type %>
          </span>
        </div>
        <p class="public-work-meta">
          <%= obra.genre || 'Gênero não informado' %>
          <%= obra.releaseDate ? ` · ${obra.releaseDate.split('-').reverse().join('/')}` : '' %>
          <%= obra.role ? ` · ${obra.role}` : '' %>
        </p>
        <% if (obra.listenLink) { %>
          <a class="text-link" href="<%= obra.listenLink %>" target="_blank" rel="noopener noreferrer">
            Ouvir obra
            <span class="lucide-icon" aria-hidden="true">
              <%- icones.arrowUpRight %>
            </span>
          </a>
        <% } %>
        <% if (obra.lyrics) { %>
          <div class="public-work-lyrics">
            <span>
              LETRA
            </span>
            <p>
              <%= obra.lyrics %>
            </p>
          </div>
        <% } %>
      </article>
    <% }) %>
  </div>
<% } else { %>
<%- include('../partials/componentes/estado-vazio', {
          classe: 'profile-empty-state',
          variacao: 'compacta',
          titulo: 'Nenhuma obra lançada publicada'
        }) %>
<% } %>
</section>
  </div>
  <aside class="profile-column-side">
    <section class="profile-section card-surface profile-equipment" id="equipamentos-publicos" aria-labelledby="public-equipment-title">
      <div class="eyebrow">
        EQUIPAMENTOS
      </div>
      <h3 id="public-equipment-title">
        Ferramentas de trabalho
      </h3>
      <% if (perfil.equipment.length) { %>
        <div class="gear-list">
          <% perfil.equipment.forEach(equipamento => { %>
            <span>
              <i class="lucide-icon" aria-hidden="true">
                <%- icones.audioLines %>
              </i>
              <%= equipamento %>
            </span>
          <% }) %>
        </div>
      <% } else { %>
      <%- include('../partials/componentes/estado-vazio', {
              classe: 'profile-empty-state',
              variacao: 'compacta',
              titulo: 'Nenhum equipamento informado'
            }) %>
    <% } %>
    </section>
    <section class="profile-section card-surface profile-stats" aria-label="Informações públicas do perfil">
      <div class="eyebrow">NA CYPHER</div>
      <h3>Presença</h3>
      <dl>
        <div><dt>Obras lançadas públicas</dt><dd><%= obras.length %></dd></div>
        <div><dt>Na Cypher desde</dt><dd><%= new Date(perfil.createdAt).toLocaleDateString('pt-BR', { month: 'short', year: 'numeric' }) %></dd></div>
      </dl>
    </section>
  </aside>
</div>
<section class="profile-section card-surface professional-category-section" id="atuacao-publica" aria-labelledby="public-category-title">
  <div class="eyebrow">ATUAÇÃO PROFISSIONAL</div>
  <h3 id="public-category-title">Categorias e trajetória compartilhada</h3>
  <p>As respostas são filtradas no servidor de acordo com as preferências de visibilidade desta pessoa e sua relação de colaboração registrada.</p>
  <% if (perfil.categories.length) { %>
    <div class="professional-category-cards">
      <% perfil.categories.forEach(categoria => { %>
        <a class="professional-category-card<%= atuacaoSelecionada?.categoria === categoria ? ' is-selected' : '' %>" href="?atuacao=<%= encodeURIComponent(categoria) %>" aria-current="<%= atuacaoSelecionada?.categoria === categoria ? 'page' : 'false' %>">
          <span>Categoria profissional</span>
          <strong><%= categoria %></strong>
          <span>Ver trajetória</span>
        </a>
      <% }) %>
    </div>
  <% } else { %>
    <p class="profile-field-note">Nenhuma categoria profissional foi compartilhada publicamente.</p>
  <% } %>
  <% if (atuacaoSelecionada) {
    const questionarioSelecionado = questionariosAtuacao.find(item => item.categoria === atuacaoSelecionada.categoria);
    let temRespostaVisivel = false;
  %>
    <article class="professional-category-detail" aria-labelledby="public-category-detail-title">
      <h4 id="public-category-detail-title"><%= atuacaoSelecionada.categoria %></h4>
      <% (questionarioSelecionado?.perguntas ?? []).forEach(pergunta => {
        const valor = atuacaoSelecionada.respostas[pergunta.campo];
        if (valor !== undefined && valor !== '') {
          temRespostaVisivel = true;
      %>
        <div class="professional-category-answer">
          <strong><%= pergunta.pergunta %></strong>
          <p><%= formatarRespostaAtuacao(valor) %></p>
        </div>
      <% } }) %>
      <% if (!temRespostaVisivel) { %>
        <p class="profile-field-note">Nenhum detalhe desta categoria foi compartilhado com você.</p>
      <% } %>
    </article>
  <% } %>
</section>

</div>
<% } %>
<%- include('../partials/fim-pagina') %>
