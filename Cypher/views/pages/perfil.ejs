<%- include('../partials/cabecalho', { title, stylesheet }) %>
<div class="app-shell">
<%- include('../partials/barra-lateral', { path }) %>
<main class="main-shell">
<%- include('../partials/barra-superior', { breadcrumb: 'Meu perfil' }) %>
<div class="page-content">
<div class="page-header">
  <div>
    <div class="eyebrow">
      SEU ESPAÇO PROFISSIONAL
    </div>
    <h1>
      <%= usuario.name %>
    </h1>
    <p>
      <%= usuario.role %>
      <%= usuario.city ? ` · ${usuario.city}` : '' %>
    </p>
  </div>
  <div class="profile-header-actions">
    <% if (!usuario.demonstracao) { %>
      <% if (editando) { %>
        <a class="button button-outline" href="/profile">
          Cancelar edição
        </a>
      <% } else { %>
        <a class="button button-outline" href="/profile?editar=1#editar-perfil">
          <span class="lucide-icon" aria-hidden="true">
            <%- icones.settings %>
          </span>
          Editar perfil
        </a>
      <% } %>
      <% if (usuario.profilePublic) { %>
        <a class="button button-dark" href="/p/<%= publicSlug %>">
          Ver perfil público
        </a>
      <% } %>
    <% } %>
  </div>
</div>
<% if (salvo) { %>
  <p class="profile-message profile-message-success" role="status">
    Perfil atualizado.
  </p>
<% } %>
<% if (erro) { %>
  <p class="profile-message profile-message-error" role="alert">
    <%= erro %>
  </p>
<% } %>
<% if (editando && !usuario.demonstracao) { %>
  <section class="profile-edit-panel card-surface" id="editar-perfil" aria-labelledby="profile-edit-title">
    <div class="eyebrow">
      INFORMAÇÕES PROFISSIONAIS
    </div>
    <h2 id="profile-edit-title">
      Editar perfil
    </h2>
    <p>
      Atualize as informações que ajudam outros profissionais a conhecer seu trabalho.
    </p>
    <form method="post" action="/profile" class="profile-edit-form" data-register-form>
      <div class="form-grid">
        <label>
          Nome artístico
          <input name="nome" value="<%= valores.nome %>" minlength="2" maxlength="80" autocomplete="nickname" required>
        </label>
        <label>
          Cidade e estado
          <input name="cidade" value="<%= valores.cidade %>" maxlength="100" placeholder="Ex.: São Paulo, SP" autocomplete="address-level2">
        </label>
      </div>
      <label>
        Biografia
        <textarea name="biografia" maxlength="500" rows="4" placeholder="Conte um pouco sobre sua trajetória e seu trabalho">
          <%= valores.biografia %>
        </textarea>
      </label>
      <label>
        Contato profissional
        <input name="contato" value="<%= valores.contato %>" maxlength="200" placeholder="E-mail, Instagram ou outro canal de contato">
      </label>
      <fieldset class="profile-category-fieldset category-fieldset">
        <legend>
          Categorias profissionais
        </legend>
        <div class="profile-category-grid">
          <% categoriasDisponiveis.forEach(categoria => { %>
            <label class="profile-category-option category-option">
              <input type="checkbox" name="categorias" value="<%= categoria %>"<%= categoria === 'Outros' ? 'data-category-other' : '' %><%= valores.categorias.includes(categoria) ? 'checked' : '' %>>
              <span>
                <%= categoria %>
              </span>
            </label>
          <% }) %>
        </div>
        <p class="category-validation" data-category-validation role="alert" hidden>
          Selecione pelo menos uma categoria.
        </p>
      </fieldset>
      <div class="profile-other-category" data-other-category-field<%= valores.categorias.includes('Outros') ? '' : 'hidden' %>>
        <label>
          Categoria personalizada
          <input id="categoria-personalizada" name="outraCategoria" value="<%= valores.outraCategoria %>" maxlength="60" minlength="2"<%= valores.categorias.includes('Outros') ? 'required' : '' %>>
        </label>
      </div>
      <label>
        Status profissional
        <select name="disponibilidade" data-profile-status>
          <option value="">
            Não informar um status agora
          </option>
          <% statusOptions.forEach(opcao => { %>
            <option value="<%= opcao.value %>" data-categorias="<%= opcao.categorias.join('|') %>"<%= valores.disponibilidade === opcao.value ? 'selected' : '' %>>
              <%= opcao.label %>
            </option>
          <% }) %>
        </select>
        <small>
          As opções consideram as categorias selecionadas acima.
        </small>
      </label>
      <label>
        Gêneros e estilos musicais
        <span class="profile-field-optional">
          (um por linha, até 8)
        </span>
        <textarea name="generos" maxlength="400" rows="3" placeholder="Rap alternativo&#10;Boom bap">
          <%= valores.generos %>
        </textarea>
      </label>
      <label id="equipamentos">
        Equipamentos e ferramentas profissionais
        <span class="profile-field-optional">
          (um por linha, até 12)
        </span>
        <textarea name="equipamentos" maxlength="1000" rows="4" placeholder="Microfone, interface, DAW ou outra ferramenta">
          <%= valores.equipamentos %>
        </textarea>
      </label>
      <div class="profile-edit-actions">
        <button class="button button-lime" type="submit">
          Salvar alterações
        </button>
        <a class="button button-outline" href="/profile">
          Cancelar
        </a>
      </div>
    </form>
  </section>
<% } %>
<section class="profile-hero">
  <div class="profile-hero-main">
    <div class="avatar avatar-hero">
      <%= usuario.initials %>
    </div>
    <div>
      <div class="profile-kicker">
        <span class="status-dot" aria-hidden="true">
        </span>
        <%= usuario.availabilityLabel %>
      </div>
      <h2>
        <%= usuario.name %>
      </h2>
      <p>
        <%= usuario.handle %>
      </p>
      <div class="tag-line big">
        <% usuario.genres.forEach(genero => { %>
          <span>
            <%= genero %>
          </span>
        <% }) %>
        <% if (!usuario.genres.length) { %>
          <span>
            Adicione seus gêneros no perfil
          </span>
        <% } %>
      </div>
    </div>
  </div>
  <% if (usuario.reputation > 0) { %>
    <div class="profile-rep">
      <span>
        REPUTAÇÃO
      </span>
      <strong>
        <%= usuario.reputation %>
      </strong>
      <small>
        profissional
      </small>
    </div>
  <% } %>
</section>
<div class="profile-id-strip">
  <span class="lucide-icon" aria-hidden="true">
    <%- icones.badgeCheck %>
  </span>
  <div>
    <small>
      ID CYPHER · IDENTIFICADOR PÚBLICO
    </small>
    <strong>
      <%= usuario.publicCode %>
    </strong>
  </div>
  <span class="immutable-label">
    Imutável
  </span>
</div>
<div class="profile-columns">
  <div class="profile-column-main">
    <section class="profile-section card-surface">
      <div class="eyebrow">
        SOBRE
      </div>
      <h3>
        Biografia
      </h3>
      <p class="bio">
        <%= usuario.biography || 'Adicione uma apresentação para contar sobre seu trabalho.' %>
      </p>
      <div class="profile-info-grid">
        <div>
          <span>
            Categorias profissionais
          </span>
          <strong>
            <%= usuario.role %>
          </strong>
        </div>
        <div>
          <span>
            Status profissional
          </span>
          <strong>
            <%= usuario.availabilityLabel %>
          </strong>
        </div>
        <div>
          <span>
            Contato
          </span>
          <strong>
            <%= usuario.contact || 'Não informado' %>
          </strong>
        </div>
        <div>
          <span>
            No Cypher desde
          </span>
          <strong>
          <%= new Date(usuario.createdAt).toLocaleDateString('pt-BR', { month: 'long', year: 'numeric' }) %>
        </strong>
      </div>
    </div>
  </section>
  <section class="profile-section card-surface">
    <div class="profile-catalog-heading">
      <div class="eyebrow">
        CATÁLOGO
      </div>
      <a href="/works" class="text-link">
        Ver catálogo completo
        <span class="lucide-icon" aria-hidden="true">
          <%- icones.arrowUpRight %>
        </span>
      </a>
    </div>
    <h3>
      Obras recentes
    </h3>
    <% if (obras.length) { %>
      <% obras.slice(0, 5).forEach((obra, i) => { %>
        <a class="profile-work" href="/works" aria-label="Abrir catálogo de Obras:<%= obra.title %>">
          <div class="work-index index-<%= i %>">
            0<%= i + 1 %>
          </div>
          <div>
            <strong>
              <%= obra.title %>
            </strong>
            <span>
              <%= obra.meta %>
              <%= obra.role ? ` · ${obra.role}` : '' %>
            </span>
          </div>
          <span class="status-label">
            <%= obra.status %>
          </span>
        </a>
      <% }) %>
    <% } else { %>
    <%- include('../partials/componentes/estado-vazio', {
                classe: 'profile-empty-state',
                variacao: 'compacta',
                titulo: 'Nenhuma obra vinculada',
                descricao: 'Cadastre uma obra para acompanhar seu catálogo.'
              }) %>
  <% } %>
</section>
</div>
<aside class="profile-column-side">
<div class="profile-section card-surface">
  <div class="eyebrow">
    EQUIPAMENTOS
  </div>
  <h3>
    Meu setup
  </h3>
  <% if (usuario.equipment.length) { %>
    <div class="gear-list">
      <% usuario.equipment.forEach((equipamento, index) => { %>
        <span>
          <i class="lucide-icon" aria-hidden="true">
            <%- index === 0 ? icones.mic : (index === 1 ? icones.audioLines : icones.music) %>
          </i>
          <%= equipamento %>
        </span>
      <% }) %>
    </div>
  <% } else { %>
  <%- include('../partials/componentes/estado-vazio', {
                classe: 'profile-empty-state',
                variacao: 'compacta',
                titulo: 'Nenhum equipamento informado'
              }) %>
<% } %>
<% if (!usuario.demonstracao) { %>
  <a class="button button-outline full" href="/profile?editar=1#equipamentos">
    <span class="lucide-icon" aria-hidden="true">
      <%- icones.settings %>
    </span>
    Gerenciar setup
  </a>
<% } %>
</div>
<div class="profile-section lime-mini">
<span>
  SEU ESPAÇO PROFISSIONAL
</span>
<strong>
  Informações atualizadas
</strong>
<p>
  Mantenha seus dados profissionais claros para facilitar novas colaborações.
</p>
</div>
</aside>
</div>
</div>
</main>
</div>
<%- include('../partials/fim-pagina') %>
