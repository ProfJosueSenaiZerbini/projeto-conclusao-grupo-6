<%- include('../partials/cabecalho', { title, stylesheet }) %>
<div class="app-shell">
<%- include('../partials/barra-lateral', { path }) %>
<main class="main-shell">
<%- include('../partials/barra-superior', { breadcrumb: 'Meu perfil' }) %>
<div class="page-content profile-page-content">
<% if (salvo) { %>
  <p class="profile-message profile-message-success" role="status">
    Perfil atualizado.
  </p>
<% } %>
<% if (generoPendente) { %>
  <p class="profile-message profile-message-success" role="status">
    Sua sugestão de gênero foi enviada para análise. Ela só será exibida no perfil após aprovação.
  </p>
<% } %>
<% if (categoriaPropostaMensagem) { %>
  <p class="profile-message<%= categoriaPropostaErro ? 'profile-message-error' : 'profile-message-success' %>" role="status">
    <%= categoriaPropostaMensagem %>
  </p>
<% } %>
<% if (erro) { %>
  <p class="profile-message profile-message-error" role="alert">
    <%= erro %>
  </p>
<% } %>
<% if (editando && !usuario.demonstracao) { %>
  <section class="profile-edit-panel card-surface" id="editar-perfil" aria-labelledby="profile-edit-title">
    <div class="eyebrow">
      INFORMAÇÕES PROFISSIONAIS
    </div>
    <h2 id="profile-edit-title">
      Editar perfil
    </h2>
    <p>
      Atualize as informações que ajudam outros profissionais a conhecer seu trabalho.
    </p>
    <% if (categoriasBloqueadas) { %>
      <p class="profile-policy-notice" role="status">
        Categorias profissionais ficam bloqueadas até
        <strong>
          <%= proximaAlteracaoCategorias %>
        </strong>
        . Você ainda pode editar os outros dados do perfil.
      </p>
    <% } else if (excecaoCategoriaDisponivel) { %>
      <p class="profile-policy-notice" role="status">
        A equipe autorizou uma alteração excepcional de categorias. Ao confirmar, inicia-se um novo prazo de 60 dias.
      </p>
    <% } %>
    <form method="post" action="/profile" class="profile-edit-form" data-register-form data-atuacao-form>
      <div class="form-grid">
        <label>
          Nome artístico
          <input name="nome" value="<%= valores.nome %>" minlength="2" maxlength="80" autocomplete="nickname" required>
        </label>
        <label>
          Cidade e estado
          <input name="cidade" value="<%= valores.cidade %>" maxlength="100" placeholder="Ex.: São Paulo, SP" autocomplete="address-level2">
        </label>
      </div>
      <label>
        Biografia
        <textarea name="biografia" maxlength="500" rows="4" placeholder="Conte um pouco sobre sua trajetória e seu trabalho">
          <%= valores.biografia %>
        </textarea>
      </label>
      <label>
        Contato profissional
        <input name="contato" value="<%= valores.contato %>" maxlength="200" placeholder="E-mail, Instagram ou outro canal de contato">
      </label>
      <fieldset class="profile-category-fieldset category-fieldset"<%= categoriasBloqueadas ? ' disabled' : '' %>>
        <legend>
          Categorias profissionais
        </legend>
        <div class="profile-category-grid">
          <% categoriasDisponiveis.forEach(categoria => { %>
            <label class="profile-category-option category-option">
              <input type="checkbox" name="categorias" value="<%= categoria %>"<%= categoria === 'Outros' ? 'data-category-other' : '' %><%= (categoriasBloqueadas ? usuario.categories : valores.categorias).includes(categoria) ? 'checked' : '' %>>
              <span>
                <%= categoria %>
              </span>
            </label>
          <% }) %>
        </div>
        <p class="category-validation" data-category-validation role="alert" hidden>
          Selecione pelo menos uma categoria.
        </p>
      </fieldset>
      <% if (categoriasBloqueadas) { usuario.categories.forEach(categoria => { %>
        <input type="hidden" name="categorias" value="<%= categoria %>">
      <% }); } %>
      <section class="professional-questionnaires" aria-labelledby="profile-questionnaires-title">
        <h3 id="profile-questionnaires-title">Atuação e trajetória por categoria</h3>
        <p>Atualizar essas respostas não altera o prazo de mudança de categorias. Os detalhes específicos são opcionais e não concedem cargos ou permissões.</p>
        <% questionariosAtuacao.forEach((questionario, indice) => { %>
          <%- include('../partials/componentes/questionario-atuacao', {
            categoriaAtuacao: questionario.categoria,
            perguntasAtuacao: questionario.perguntas,
            idQuestionario: `perfil-atuacao-${indice}`,
            legada: questionario.legada,
            atuacoesExistentes,
            formatarRespostaAtuacao
          }) %>
        <% }) %>
      </section>
      <input type="hidden" name="respostasAtuacoesJson" data-respostas-atuacoes-json value="{}">
      <input type="hidden" name="visibilidadesAtuacoesJson" data-visibilidades-atuacoes-json value="{}">
      <label>
        Status profissional
        <select name="disponibilidade" data-profile-status>
          <option value="">
            Não informar um status agora
          </option>
          <% statusOptions.forEach(opcao => { %>
            <option value="<%= opcao.value %>" data-categorias="<%= opcao.categorias.join('|') %>"<%= valores.disponibilidade === opcao.value ? 'selected' : '' %>>
              <%= opcao.label %>
            </option>
          <% }) %>
        </select>
        <small>
          As opções consideram as categorias selecionadas acima.
        </small>
      </label>
      <fieldset class="profile-category-fieldset profile-genre-fieldset">
        <legend>
          Gêneros e estilos musicais · selecione até 8
        </legend>
        <div class="profile-category-grid">
          <% generosDisponiveis.forEach(genero => { %>
            <label class="profile-category-option profile-genre-option">
              <input type="checkbox" name="generos" value="<%= genero %>"<%= valores.generos.includes(genero) ? 'checked' : '' %>>
              <span>
                <%= genero %>
              </span>
            </label>
          <% }) %>
          <label class="profile-category-option profile-genre-option">
            <input type="checkbox" name="generos" value="Outro" data-genre-other<%= valores.outroGenero ? 'checked' : '' %>>
            <span>
              Outro
            </span>
          </label>
        </div>
      </fieldset>
      <div class="profile-other-category" data-other-genre-field<%= valores.outroGenero ? '' : 'hidden' %>>
        <label>
          Sugira outro gênero
          <input id="genero-personalizado" name="outroGenero" value="<%= valores.outroGenero %>" maxlength="40" minlength="2" placeholder="Ex.: Drill brasileiro">
          <small>
            Essa sugestão será analisada pela equipe e não aparecerá publicamente antes da aprovação.
          </small>
        </label>
      </div>
      <% if (usuario.genres.some(genero => !generosDisponiveis.includes(genero))) { %>
        <p class="profile-field-note">
          Gêneros personalizados já aprovados são mantidos no seu perfil. Para sugerir outro, use “Outro”.
        </p>
      <% } %>
    <label id="profile-equipment-input">
        Equipamentos e ferramentas profissionais
        <span class="profile-field-optional">
          (um por linha, até 12)
        </span>
        <textarea name="equipamentos" maxlength="1000" rows="4" placeholder="Microfone, interface, DAW ou outra ferramenta">
          <%= valores.equipamentos %>
        </textarea>
      </label>
      <div class="profile-edit-actions">
        <button class="button button-lime" type="submit">
          Salvar alterações
        </button>
        <a class="button button-outline" href="/profile">
          Cancelar
        </a>
      </div>
    </form>
    <% if (categoriasBloqueadas && !excecaoCategoriaDisponivel) { %>
      <section class="profile-category-request profile-exception-request" aria-labelledby="profile-exception-title">
        <div>
          <h3 id="profile-exception-title">
            Solicitar alteração antes do prazo
          </h3>
          <p>
            Escolha as categorias que deseja manter, adicionar ou substituir e explique o motivo. A equipe avaliará as respostas e o histórico; enviar o pedido não altera o prazo nem libera a mudança.
          </p>
        </div>
        <% if (solicitacaoExcecao?.status === 'pendente') { %>
          <p class="profile-policy-notice" role="status">
            Sua solicitação foi enviada e aguarda análise da equipe. Não é necessário enviá-la novamente.
          </p>
          <% if (solicitacaoExcecao.categoriasSolicitadas.length) { %>
            <p class="profile-field-note">Categorias solicitadas: <%= solicitacaoExcecao.categoriasSolicitadas.join(', ') %></p>
          <% } %>
          <% if (solicitacaoExcecao.historico.length) { %>
            <ol class="category-request-thread" aria-label="Mensagens sobre a solicitação">
              <% solicitacaoExcecao.historico.forEach(mensagem => { %>
                <li class="category-request-message category-request-message-<%= mensagem.autorTipo %>">
                  <strong><%= mensagem.autorTipo === 'administrador' ? 'Equipe Cypher' : 'Você' %></strong>
                  <p><%= mensagem.mensagem %></p>
                  <time datetime="<%= mensagem.criadaEm %>"><%= new Date(`${mensagem.criadaEm.replace(' ', 'T')}Z`).toLocaleString('pt-BR') %></time>
                </li>
              <% }) %>
            </ol>
            <% const ultimaMensagemSolicitacao = solicitacaoExcecao.historico[solicitacaoExcecao.historico.length - 1]; %>
            <% if (ultimaMensagemSolicitacao?.autorTipo === 'administrador') { %>
              <form method="post" action="/profile/categorias/solicitacoes/<%= solicitacaoExcecao.id %>/responder" class="profile-exception-request-form">
                <label for="profile-exception-reply">Responder à equipe
                  <textarea id="profile-exception-reply" name="mensagem" minlength="5" maxlength="1000" rows="3" required></textarea>
                </label>
                <button class="button button-lime" type="submit">Enviar resposta</button>
              </form>
            <% } %>
          <% } %>
        <% } else { %>
          <% if (solicitacaoExcecao?.status === 'rejeitado') { %>
            <p class="profile-policy-notice profile-exception-decision" role="status">
              Solicitação anterior recusada: <%= solicitacaoExcecao.motivoRevisao %>
            </p>
          <% } else if (solicitacaoExcecao?.status === 'aprovado') { %>
            <p class="profile-policy-notice" role="status">
              Uma solicitação anterior foi aprovada. Se uma nova alteração ainda estiver bloqueada, você pode enviar outro pedido.
            </p>
          <% } %>
          <form method="post" action="/profile/categorias/solicitar-excecao" class="profile-exception-request-form" data-atuacao-form>
            <fieldset class="profile-category-fieldset">
              <legend>Categorias após a alteração solicitada</legend>
              <div class="profile-category-grid">
                <% categoriasDisponiveis.filter(categoria => categoria !== categoriaLegadaRapperMC).forEach(categoria => { %>
                  <label class="profile-category-option">
                    <input type="checkbox" name="categorias" value="<%= categoria %>" <%= categoriasSolicitadas.includes(categoria) ? 'checked' : '' %>>
                    <span><%= categoria %></span>
                  </label>
                <% }) %>
                <% if (usuario.categories.includes(categoriaLegadaRapperMC)) { %>
                  <label class="profile-category-option">
                    <input type="checkbox" name="categorias" value="<%= categoriaLegadaRapperMC %>" <%= categoriasSolicitadas.includes(categoriaLegadaRapperMC) ? 'checked' : '' %>>
                    <span><%= categoriaLegadaRapperMC %> (legada)</span>
                  </label>
                <% } %>
              </div>
            </fieldset>
            <section class="professional-questionnaires" aria-label="Respostas da alteração solicitada">
              <% questionariosAtuacao.forEach((questionario, indice) => { %>
                <%- include('../partials/componentes/questionario-atuacao', {
                  categoriaAtuacao: questionario.categoria,
                  perguntasAtuacao: questionario.perguntas,
                  idQuestionario: `pedido-atuacao-${indice}`,
                  legada: questionario.legada,
                  atuacoesExistentes: atuacoesSolicitadas,
                  formatarRespostaAtuacao
                }) %>
              <% }) %>
            </section>
            <input type="hidden" name="respostasAtuacoesJson" data-respostas-atuacoes-json value="{}">
            <input type="hidden" name="visibilidadesAtuacoesJson" data-visibilidades-atuacoes-json value="{}">
            <label for="profile-exception-reason">Por que deseja adicionar ou modificar essa categoria?
              <select id="profile-exception-reason" name="motivoCodigo" required>
                <option value="">Selecione um motivo</option>
                <option value="recente">Comecei a atuar nessa área recentemente</option>
                <option value="novos_trabalhos">Passei a desenvolver novos tipos de trabalho</option>
                <option value="atualizar">Quero corrigir ou atualizar informações do meu perfil</option>
                <option value="categoria_incorreta">Selecionei a categoria incorreta anteriormente</option>
                <option value="ampliar">Quero ampliar minha atuação e buscar oportunidades nessa área</option>
                <option value="outro">Outro motivo</option>
              </select>
            </label>
            <label>Explique, se selecionou “Outro”
              <textarea name="motivoOutro" minlength="10" maxlength="500" rows="3" placeholder="Explique brevemente (obrigatório para Outro)"></textarea>
            </label>
            <button class="button button-lime" type="submit">
              Enviar para análise
            </button>
          </form>
        <% } %>
      </section>
    <% } %>
    <form method="post" action="/profile/categorias/sugerir" class="profile-category-request">
      <div>
        <h3>
          Sugerir nova categoria profissional
        </h3>
        <p>
          Se aprovada pela equipe, ela será adicionada às opções disponíveis para todos. O pedido não altera suas categorias atuais nem o prazo de 60 dias.
        </p>
      </div>
      <label>
        Categoria sugerida
        <input name="categoria" minlength="2" maxlength="60" required placeholder="Ex.: engenheiro de áudio">
      </label>
      <button class="button button-outline" type="submit">
        Enviar para análise
      </button>
    </form>
  </section>
<% } %>
<div class="profile-layout">
<section class="profile-hero" aria-labelledby="profile-hero-name">
  <div class="profile-hero-main">
    <div class="profile-avatar-frame" aria-hidden="true"><div class="avatar avatar-hero"><%= usuario.initials %></div></div>
    <div class="profile-hero-copy">
      <p class="profile-hero-eyebrow">CYPHER · ESPAÇO PROFISSIONAL</p>
      <h1 id="profile-hero-name"><%= usuario.name %></h1>
      <p class="profile-hero-meta"><%= usuario.categories.join(' · ') || usuario.role %></p>
      <p class="profile-hero-handle"><%= usuario.handle %><%= usuario.city ? ` · ${usuario.city}` : '' %></p>
      <div class="profile-hero-tags" aria-label="Categorias profissionais">
        <% usuario.categories.forEach((categoria, indice) => { %>
          <span class="profile-category-chip<%= indice % 2 ? ' is-muted' : '' %>"><%= categoria %></span>
        <% }) %>
        <% if (!usuario.categories.length) { %><span class="profile-category-chip is-muted">Nenhuma categoria informada</span><% } %>
      </div>
      <p class="profile-kicker<%= usuario.availability ? (usuario.availability === 'indisponivel' ? ' is-unavailable' : ' is-available') : ' is-unknown' %>"><% if (usuario.availability) { %><span class="status-dot" aria-hidden="true"></span><% } %><%= usuario.availabilityLabel %></p>
    </div>
  </div>
  <div class="profile-hero-actions">
    <% if (!usuario.demonstracao) { %>
      <% if (editando) { %>
        <a class="button button-outline" href="/profile">Cancelar edição</a>
      <% } else { %>
        <a class="button button-lime" href="/profile?editar=1#editar-perfil"><span class="lucide-icon" aria-hidden="true"><%- icones.settings %></span>Editar perfil</a>
      <% } %>
      <% if (usuario.profilePublic) { %><a class="profile-public-link" href="/p/<%= publicSlug %>">Ver perfil público <span aria-hidden="true">↗</span></a><% } %>
    <% } %>
  </div>
</section>
<div class="profile-id-strip">
  <span class="lucide-icon" aria-hidden="true">
    <%- icones.tag %>
  </span>
  <div>
    <small>
      ID CYPHER · IDENTIFICADOR PÚBLICO
    </small>
    <strong>
      <%= usuario.publicCode %>
    </strong>
  </div>
  <span class="immutable-label">
    Imutável
  </span>
</div>
<nav class="profile-section-nav" aria-label="Seções do perfil" data-profile-section-nav>
  <a href="#sobre">Sobre</a>
  <a href="#catalogo">Catálogo</a>
  <a href="#equipamentos">Equipamentos</a>
  <a href="#atuacao-profissional">Atuação profissional</a>
</nav>
<div class="profile-columns">
  <div class="profile-column-main">
    <section class="profile-section card-surface profile-about" id="sobre" aria-labelledby="profile-about-title">
      <div class="eyebrow">
        SOBRE
      </div>
      <h3 id="profile-about-title">
        Sobre <%= usuario.name %>
      </h3>
      <p class="bio">
        <%= usuario.biography || 'Adicione uma apresentação para contar sobre seu trabalho.' %>
      </p>
      <div class="profile-info-grid">
        <div>
          <span>
            Categorias profissionais
          </span>
          <strong>
            <%= usuario.role %>
          </strong>
        </div>
        <div>
          <span>
            Status profissional
          </span>
          <strong>
            <%= usuario.availabilityLabel %>
          </strong>
        </div>
        <% if (usuario.contact) { %><div>
          <span>
            Contato
          </span>
          <strong>
            <%= usuario.contact %>
          </strong>
        </div><% } %>
        <div>
          <span>
            No Cypher desde
          </span>
          <strong>
          <%= new Date(usuario.createdAt).toLocaleDateString('pt-BR', { month: 'long', year: 'numeric' }) %>
        </strong>
      </div>
    </div>
  </section>
  <section class="profile-section card-surface profile-catalog" id="catalogo" aria-labelledby="profile-catalog-title">
    <div class="profile-catalog-heading">
      <div class="eyebrow">
        CATÁLOGO
      </div>
      <a href="/works" class="button button-outline profile-catalog-link">
        Ver catálogo <span class="lucide-icon" aria-hidden="true"><%- icones.arrowUpRight %></span>
      </a>
    </div>
    <h3 id="profile-catalog-title">Obras recentes</h3>
    <p class="profile-section-intro">Últimas obras cadastradas na Cypher.</p>
    <% if (obras.length) { %>
      <div class="profile-work-grid">
      <% obras.slice(0, 4).forEach((obra, i) => { %>
        <a class="profile-work-card" href="/works" aria-label="Abrir catálogo: <%= obra.title %>">
          <span class="profile-work-art profile-work-art-<%= i %>" aria-hidden="true"><span><%= String(obra.type || 'OBRA').slice(0, 2).toLocaleUpperCase('pt-BR') %></span><i> CYPHER </i></span>
          <span class="profile-work-title"><%= obra.title %></span>
          <span class="profile-work-meta"><%= obra.type %><%= obra.meta ? ` · ${obra.meta}` : '' %></span>
          <span class="profile-work-status<%= obra.status === 'Lançado' ? ' is-released' : '' %>"><%= obra.status %></span>
          <% if (obra.role) { %><span class="profile-work-credit"><%= obra.role %></span><% } %>
        </a>
      <% }) %>
      </div>
    <% } else { %>
    <%- include('../partials/componentes/estado-vazio', {
                classe: 'profile-empty-state',
                variacao: 'compacta',
                titulo: 'Nenhuma obra vinculada',
                descricao: 'Cadastre uma obra para acompanhar seu catálogo.'
              }) %>
  <% } %>
</section>
</div>
<aside class="profile-column-side">
<div class="profile-section card-surface profile-equipment" id="equipamentos" aria-labelledby="profile-equipment-title">
  <div class="eyebrow">
    EQUIPAMENTOS
  </div>
  <h3 id="profile-equipment-title">
    Meu setup
  </h3>
  <p class="profile-section-intro">Ferramentas informadas no perfil.</p>
  <% if (usuario.equipment.length) { %>
    <div class="gear-list">
      <% usuario.equipment.forEach((equipamento, index) => { %>
        <span>
          <i class="lucide-icon" aria-hidden="true">
            <%- index === 0 ? icones.mic : (index === 1 ? icones.audioLines : icones.music) %>
          </i>
          <%= equipamento %>
        </span>
      <% }) %>
    </div>
  <% } else { %>
  <%- include('../partials/componentes/estado-vazio', {
                classe: 'profile-empty-state',
                variacao: 'compacta',
                titulo: 'Nenhum equipamento informado'
              }) %>
<% } %>
<% if (!usuario.demonstracao) { %>
  <a class="button button-outline full" href="/profile?editar=1#profile-equipment-input">
    <span class="lucide-icon" aria-hidden="true">
      <%- icones.settings %>
    </span>
    Gerenciar setup
  </a>
<% } %>
</div>
<div class="profile-section card-surface profile-stats" aria-label="Informações do perfil">
  <div class="eyebrow">NA CYPHER</div>
  <h3>Seu espaço</h3>
  <dl>
    <div><dt>Obras recentes listadas</dt><dd><%= obras.length %></dd></div>
    <div><dt>Desde</dt><dd><%= new Date(usuario.createdAt).toLocaleDateString('pt-BR', { month: 'short', year: 'numeric' }) %></dd></div>
    <% if (usuario.reputation > 0) { %><div><dt>Reputação registrada</dt><dd><%= usuario.reputation %></dd></div><% } %>
  </dl>
</div>
</aside>
</div>
<section class="profile-section card-surface professional-category-section" id="atuacao-profissional" aria-labelledby="professional-category-title">
  <div class="eyebrow">ATUAÇÃO PROFISSIONAL</div>
  <h3 id="professional-category-title">Suas categorias e trajetória declarada</h3>
  <p>Respostas organizadas por função. Este perfil não possui uma linha do tempo de marcos verificados; detalhes e visibilidades podem ser atualizados na edição.</p>
  <% if (usuario.categories.length) { %>
    <div class="professional-category-cards">
      <% usuario.categories.forEach(categoria => { %>
        <a class="professional-category-card<%= atuacaoSelecionada?.categoria === categoria ? ' is-selected' : '' %>" href="/profile?atuacao=<%= encodeURIComponent(categoria) %>" aria-current="<%= atuacaoSelecionada?.categoria === categoria ? 'page' : 'false' %>">
          <span>Categoria profissional</span>
          <strong><%= categoria %></strong>
          <span>Ver trajetória</span>
        </a>
      <% }) %>
    </div>
  <% } else { %>
    <p class="profile-field-note">Adicione uma categoria profissional para organizar sua trajetória.</p>
  <% } %>
  <% if (atuacaoSelecionada) {
    const questionarioSelecionado = questionariosAtuacao.find(item => item.categoria === atuacaoSelecionada.categoria);
    const respostasSelecionadas = atuacaoSelecionada.respostas;
  %>
    <article class="professional-category-detail" aria-labelledby="professional-category-detail-title">
      <h4 id="professional-category-detail-title"><%= atuacaoSelecionada.categoria %></h4>
      <% let temRespostaVisivel = false; %>
      <% (questionarioSelecionado?.perguntas ?? []).forEach(pergunta => {
        const valor = respostasSelecionadas[pergunta.campo];
        if (valor !== undefined && valor !== '') {
          temRespostaVisivel = true;
      %>
        <div class="professional-category-answer">
          <strong><%= pergunta.pergunta %></strong>
          <p><%= formatarRespostaAtuacao(valor, pergunta.opcoes) %></p>
        </div>
      <% } }) %>
      <% if (!temRespostaVisivel) { %>
        <p class="profile-field-note">Nenhum detalhe foi preenchido ou compartilhado para esta categoria.</p>
      <% } %>
      <a class="text-link" href="/profile?editar=1#editar-perfil">Editar respostas</a>
    </article>
  <% } %>
</section>
</div>
</div>
</main>
</main>
