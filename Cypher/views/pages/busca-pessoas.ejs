<%- include('../partials/cabecalho', { title, stylesheet }) %>
<div class="app-shell">
<%- include('../partials/barra-lateral', { path }) %>
<main class="main-shell">
<%- include('../partials/barra-superior', { breadcrumb: 'Buscar pessoas' }) %>
<div class="page-content">
<div class="page-header">
  <div>
    <div class="eyebrow">
      EXPLORAR A CENA
    </div>
    <h1>
      Buscar pessoas
    </h1>
    <p>
      Encontre profissionais por função, localização e estilo — sem ruído.
    </p>
  </div>
</div>
<div class="search-toolbar">
  <label class="search-field" for="busca-profissionais">
    <span class="lucide-icon" aria-hidden="true">
      <%- icones.search %>
    </span>
    <input id="busca-profissionais" type="search" data-filter placeholder="Busque por nome, função, cidade ou estilo" aria-label="Buscar profissionais">
  </label>
</div>
<div class="results-meta">
  <span>
    Profissionais encontrados
  </span>
  <span>
    Mais relevantes
  </span>
</div>
<div class="people-grid">
  <% pessoas.forEach(pessoa => { %>
    <article class="profile-card" data-search-item>
      <div class="profile-card-top tone-<%= pessoa.tone %>">
        <div class="avatar avatar-<%= pessoa.tone %>">
          <%= pessoa.initials %>
        </div>
        <span class="availability">
          <i>
          </i>
          Disponível
        </span>
      </div>
      <div class="profile-card-body">
        <h3>
          <%= pessoa.name %>
        </h3>
        <p class="role-line">
          <%= pessoa.role %>
        </p>
        <div class="profile-detail">
          <span class="lucide-icon" aria-hidden="true">
            <%- icones.mapPin %>
          </span>
          <%= pessoa.city %>
        </div>
        <div class="tag-line">
          <span>
            <%= pessoa.tag %>
          </span>
        </div>
        <div class="profile-card-actions">
          <button class="button button-dark small" type="button" data-toast="Solicitação enviada para<%= pessoa.name %>">
            Conectar
          </button>
        </div>
      </div>
    </article>
  <% }) %>
</div>
</div>
</main>
</div>
<%- include('../partials/fim-pagina') %>
