<%- include('../partials/cabecalho', { title, stylesheet }) %>
<div class="auth-page">
<div class="auth-art">
  <div class="auth-brand">
    <div class="logo">
      <span class="logo-mark" aria-hidden="true">
        <span>
        </span>
        <span>
        </span>
        <span>
        </span>
      </span>
      <span class="logo-word">
        CYPHER
      </span>
    </div>
    <span>
      ECOSSISTEMA PROFISSIONAL DA CENA UNDERGROUND
    </span>
  </div>
  <div class="auth-quote">
    <span>
      01 — CONECTAR
    </span>
    <h1>
      Seu próximo
      <br>
      <em>
        passo começa aqui.
      </em>
    </h1>
    <p>
      Um perfil profissional bem cuidado é o começo de novas oportunidades.
    </p>
  </div>
</div>
<div class="auth-panel">
  <div class="auth-panel-inner">
    <div class="eyebrow">
      PRIMEIRO PASSO
    </div>
    <h2>
      Crie seu espaço.
    </h2>
    <p class="auth-description">
      Selecione todas as formas como você participa da cena underground.
    </p>
    <% if (erro) { %>
      <p class="auth-message auth-message-error" role="alert">
        <%= erro %>
      </p>
    <% } %>
    <form method="post" action="/register" data-register-form data-atuacao-form>
      <label>
        Nome completo
        <input name="name" value="<%= nome %>" placeholder="Seu nome" minlength="2" maxlength="80" autocomplete="name" required>
      </label>
      <label>
        E-mail
        <input type="email" name="email" value="<%= email %>" placeholder="voce@email.com" maxlength="254" autocomplete="email" required>
      </label>
      <label>
        Senha
        <input type="password" name="password" placeholder="Mínimo de 8 caracteres" minlength="8" maxlength="128" autocomplete="new-password" required>
      </label>
      <fieldset class="category-fieldset">
        <legend class="eyebrow category-label">
          SUAS CATEGORIAS
          <span>
            (selecione todas as aplicáveis)
          </span>
        </legend>
        <div class="category-grid">
          <% categoriasDisponiveis.filter(categoria => categoria !== 'Outros').forEach(categoria => { %>
            <label class="category-option">
              <input type="checkbox" name="categorias" value="<%= categoria %>"<%= categoriasSelecionadas.includes(categoria) ? 'checked' : '' %>>
              <span>
                <%= categoria %>
              </span>
              <span class="category-check lucide-icon" aria-hidden="true">
                <%- icones.check %>
              </span>
            </label>
          <% }) %>
          <label class="category-option other-option">
            <input type="checkbox" name="categorias" value="Outros" data-category-other<%= categoriasSelecionadas.includes('Outros') ? 'checked' : '' %>>
            <span>
              Outros
            </span>
            <span class="category-check lucide-icon" aria-hidden="true">
              <%- icones.check %>
            </span>
          </label>
        </div>
        <p class="category-validation" data-category-validation role="alert" hidden>
          Selecione pelo menos uma categoria.
        </p>
        <p class="category-approval-note" data-category-approval-note>
          Categorias profissionais não concedem acesso administrativo nem capacidades especiais. Novos nomes são analisados e só entram nas opções após aprovação.
        </p>
      </fieldset>
      <div class="other-category-field" data-other-category-field hidden>
        <label for="categoria-personalizada">
          Qual categoria deseja sugerir?
        </label>
        <input id="categoria-personalizada" name="outraCategoria" value="<%= outraCategoria %>" maxlength="60" placeholder="Ex.: engenheiro de áudio">
        <small>
          Ao concluir o cadastro, esta sugestão será enviada à equipe. Ela não ficará disponível até ser aprovada.
        </small>
      </div>
      <section class="professional-questionnaires" aria-labelledby="register-questionnaires-title">
        <h3 id="register-questionnaires-title">Sua trajetória por categoria</h3>
        <p>Ao selecionar uma função, responda às perguntas gerais. Os detalhes específicos são opcionais e não comprovam nem concedem permissões profissionais.</p>
        <% questionariosAtuacao.forEach((questionario, indice) => { %>
          <%- include('../partials/componentes/questionario-atuacao', {
            categoriaAtuacao: questionario.categoria,
            perguntasAtuacao: questionario.perguntas,
            idQuestionario: `cadastro-atuacao-${indice}`,
            legada: questionario.legada,
            atuacoesExistentes: atuacoesExistentes || [],
            formatarRespostaAtuacao
          }) %>
        <% }) %>
      </section>
      <input type="hidden" name="respostasAtuacoesJson" data-respostas-atuacoes-json value="{}">
      <input type="hidden" name="visibilidadesAtuacoesJson" data-visibilidades-atuacoes-json value="{}">
      <div class="ctag-note">
        <span class="lucide-icon" aria-hidden="true">
          <%- icones.badgeCheck %>
        </span>
        <span>
          Ao criar a conta, você recebe uma
          <strong>
            C-Tag única e imutável
          </strong>
          . Ela será gerada ao criar sua conta.
        </span>
      </div>
      <button class="button button-lime full" type="submit">
        Continuar
        <span class="lucide-icon" aria-hidden="true">
          <%- icones.arrowUpRight %>
        </span>
      </button>
    </form>
    <p class="auth-switch">
      Já tem uma conta?
      <a href="/login">
        Entrar
      </a>
    </p>
  </div>
</div>
</div>
<script src="/js/questionario-atuacoes.js" defer></script>
<%- include('../partials/fim-pagina') %>
