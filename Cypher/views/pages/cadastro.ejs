<%- include('../partials/cabecalho', { title, stylesheet }) %>
<%
  const descricoesCategorias = {
    'Rapper': 'Voz, escrita e presença na cultura rap.',
    'MC': 'Apresentações, batalhas, rodas e condução de eventos.',
    'Letrista': 'Criação de letras, temas e narrativas.',
    'Compositor': 'Melodias, harmonias e composições musicais.',
    'Beatmaker': 'Criação de beats, bases e instrumentais.',
    'Produtor musical': 'Desenvolvimento e finalização de produções.',
    'DJ': 'Seleção musical, sets e apresentações.',
    'Empresário': 'Gestão, serviços e negócios da cena musical.',
    'Organizador de eventos': 'Produção de encontros e eventos culturais.',
    'Outros': 'Sugira uma atuação ainda não listada.'
  };
%>
<div class="auth-page auth-page--register">
  <aside class="auth-art" aria-label="Identidade Cypher">
    <div class="auth-brand">
      <div class="logo">
        <span class="logo-mark" aria-hidden="true"><span></span><span></span><span></span></span>
        <span class="logo-word">CYPHER</span>
      </div>
      <span>ECOSSISTEMA PROFISSIONAL DA CENA UNDERGROUND</span>
    </div>
    <div class="auth-quote">
      <span>01 — CONECTAR</span>
      <h1>Seu próximo<br><em>passo começa aqui.</em></h1>
      <p>Um perfil profissional bem cuidado é o começo de novas oportunidades.</p>
    </div>
    <div class="auth-art-footer">
      <div class="auth-bars" aria-hidden="true"><i></i><i></i><i></i><i></i></div>
      <p>Uma cena forte começa com quem constrói junto.</p>
    </div>
  </aside>
  <main class="auth-panel auth-panel--register">
    <div class="auth-panel-inner auth-panel-inner--register">
      <div class="eyebrow">CADASTRO CYPHER</div>
      <h2 data-register-title>Crie seu espaço.</h2>
      <p class="auth-description" data-register-description>Vamos começar pelos dados essenciais da sua conta.</p>
      <% if (erro) { %><p class="auth-message auth-message-error" role="alert"><%= erro %></p><% } %>
      <form method="post" action="/register" data-register-form data-atuacao-form data-start-stage="<%= etapaInicial ?? 'conta' %>">
        <ol class="register-step-indicator" aria-label="Etapas do cadastro">
          <li data-step-indicator="conta" aria-current="step"><span>1</span><span>Conta</span></li>
          <li data-step-indicator="categorias"><span>2</span><span>Atuação</span></li>
          <li data-step-indicator="questionarios"><span>3</span><span>Trajetória</span></li>
        </ol>
        <section class="register-stage" data-register-stage="conta" aria-labelledby="register-account-title">
          <div class="register-stage-heading">
            <span class="register-stage-kicker">ETAPA 1 DE 3</span>
            <h3 id="register-account-title">Dados da conta</h3>
            <p>Use seus dados de acesso. Sua conta só será criada ao concluir o cadastro.</p>
          </div>
          <div class="register-account-fields">
            <label for="register-name">Nome completo
              <input id="register-name" name="name" value="<%= nome %>" placeholder="Seu nome" minlength="2" maxlength="80" autocomplete="name" required>
            </label>
            <label for="register-email">E-mail
              <input id="register-email" type="email" name="email" value="<%= email %>" placeholder="voce@email.com" maxlength="254" autocomplete="email" required>
            </label>
            <label for="register-password">Senha
              <input id="register-password" type="password" name="password" placeholder="Mínimo de 8 caracteres" minlength="8" maxlength="128" autocomplete="new-password" required>
              <small>A senha não será guardada no navegador se você recarregar a página.</small>
            </label>
          </div>
          <p class="register-inline-error" data-stage-error role="alert" hidden></p>
          <button class="button button-lime full register-next" type="button" data-account-next>Próximo <span aria-hidden="true">→</span></button>
        </section>
        <section class="register-stage" data-register-stage="categorias" aria-labelledby="register-categories-title" hidden>
          <div class="register-stage-heading">
            <span class="register-stage-kicker">ETAPA 2 DE 3</span>
            <h3 id="register-categories-title">Como você atua na cena?</h3>
            <p>Escolha uma ou mais categorias. Seus questionários serão apresentados depois, um de cada vez.</p>
          </div>
          <fieldset class="category-fieldset">
            <legend class="category-label">SUAS CATEGORIAS <span>(selecione todas as aplicáveis)</span></legend>
            <div class="category-grid category-grid--cards">
              <% categoriasDisponiveis.filter(categoria => categoria !== 'Outros').forEach(categoria => { %>
                <label class="category-option category-option--card<%= categoriasSelecionadas.includes(categoria) ? ' selected' : '' %>">
                  <input type="checkbox" name="categorias" value="<%= categoria %>"<%= categoriasSelecionadas.includes(categoria) ? ' checked' : '' %>>
                  <span class="category-option-copy"><strong><%= categoria %></strong><small><%= descricoesCategorias[categoria] ?? 'Compartilhe sua atuação profissional na Cypher.' %></small></span>
                  <span class="category-check lucide-icon" aria-hidden="true"><%- icones.check %></span>
                </label>
              <% }) %>
              <label class="category-option category-option--card other-option<%= categoriasSelecionadas.includes('Outros') ? ' selected' : '' %>">
                <input type="checkbox" name="categorias" value="Outros" data-category-other<%= categoriasSelecionadas.includes('Outros') ? ' checked' : '' %>>
                <span class="category-option-copy"><strong>Outra atuação</strong><small><%= descricoesCategorias.Outros %></small></span>
                <span class="category-check lucide-icon" aria-hidden="true"><%- icones.check %></span>
              </label>
            </div>
            <p class="category-validation" data-category-validation role="alert" hidden>Selecione pelo menos uma categoria para continuar.</p>
            <p class="category-approval-note" data-category-approval-note>Categorias profissionais não concedem acesso administrativo nem capacidades especiais. Novos nomes são analisados e só entram nas opções após aprovação.</p>
          </fieldset>
          <div class="other-category-field" data-other-category-field hidden>
            <label for="categoria-personalizada">Qual categoria deseja sugerir?</label>
            <input id="categoria-personalizada" name="outraCategoria" value="<%= outraCategoria %>" minlength="2" maxlength="60" placeholder="Ex.: engenheiro de áudio">
            <small>A sugestão será enviada à equipe e só ficará disponível após aprovação.</small>
          </div>
          <p class="register-inline-error" data-stage-error role="alert" hidden></p>
          <div class="register-navigation">
            <button class="button button-outline" type="button" data-register-back>Voltar</button>
            <button class="button button-lime" type="button" data-categories-next>Continuar <span aria-hidden="true">→</span></button>
          </div>
        </section>
        <section class="register-stage" data-register-stage="questionarios" aria-labelledby="register-questionnaires-title" hidden>
          <div class="register-stage-heading">
            <span class="register-stage-kicker">ETAPA 3 DE 3</span>
            <h3 id="register-questionnaires-title">Sua trajetória profissional</h3>
            <p>Responda uma pergunta por vez. Detalhes específicos são opcionais e não concedem permissões profissionais.</p>
          </div>
          <div class="questionnaire-progress" data-questionnaire-progress aria-live="polite">
            <div class="questionnaire-progress__labels"><span data-question-current>Pergunta 1 de 1</span><span data-question-answered>0 respondidas · faltam 1</span></div>
            <div class="questionnaire-progress__track" role="progressbar" aria-label="Progresso das perguntas" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0"><span data-question-progress-bar></span></div>
            <span class="questionnaire-progress__percent" data-question-percent>0%</span>
          </div>
          <p class="questionnaire-category-context" data-question-category aria-live="polite"></p>
          <section class="professional-questionnaires" aria-label="Questionário profissional">
            <% questionariosAtuacao.forEach((questionario, indice) => { %>
              <%- include('../partials/componentes/questionario-atuacao', {
                categoriaAtuacao: questionario.categoria,
                perguntasAtuacao: questionario.perguntas,
                idQuestionario: `cadastro-atuacao-${indice}`,
                legada: questionario.legada,
                atuacoesExistentes: atuacoesExistentes || [],
                formatarRespostaAtuacao
              }) %>
            <% }) %>
          </section>
          <p class="register-inline-error" data-stage-error role="alert" hidden></p>
          <div class="register-navigation">
            <button class="button button-outline" type="button" data-register-back>Voltar</button>
            <button class="button button-outline" type="button" data-question-previous hidden>Pergunta anterior</button>
            <button class="button button-lime" type="button" data-question-next>Próxima pergunta <span aria-hidden="true">→</span></button>
            <button class="button button-lime" type="submit" data-register-submit hidden>Finalizar cadastro <span aria-hidden="true">→</span></button>
          </div>
        </section>
        <input type="hidden" name="respostasAtuacoesJson" data-respostas-atuacoes-json value="{}">
        <input type="hidden" name="visibilidadesAtuacoesJson" data-visibilidades-atuacoes-json value="{}">
        <div class="ctag-note" data-register-ctag hidden><span class="lucide-icon" aria-hidden="true"><%- icones.badgeCheck %></span><span>Ao concluir, será gerada uma <strong>C-Tag única e imutável</strong> para sua conta.</span></div>
      </form>
      <p class="auth-switch">Já tem uma conta? <a href="/login">Entrar</a></p>
    </div>
  </main>
</div>
<script src="/js/questionario-atuacoes.js" defer></script>
<%- include('../partials/fim-pagina') %>
