<%- include('../partials/cabecalho', { title, stylesheet }) %>
<div class="app-shell">
<%- include('../partials/barra-lateral', { path }) %>
<main class="main-shell">
<%- include('../partials/barra-superior', { breadcrumb: 'Configurações' }) %>
<div class="page-content settings-page">
<div class="settings-intro">
  <div>
    <div class="eyebrow">
      CONTROLE DO SEU ESPAÇO
    </div>
    <h1>
      Configurações
    </h1>
    <p>
      Controle sua conta e a forma como você vive a cena dentro do Cypher.
    </p>
  </div>
  <div class="settings-mark">
    <span>
      06
    </span>
    <small>
      áreas de controle
    </small>
  </div>
</div>
<% if (mensagem) { %>
  <p class="settings-message settings-message-success" role="status">
    <%= mensagem %>
  </p>
<% } %>
<% if (erro) { %>
  <p class="settings-message settings-message-error" role="alert">
    <%= erro %>
  </p>
<% } %>
<div class="settings-layout">
  <aside class="settings-index" aria-label="Seções de configurações">
    <div class="settings-index-label">
      NESTA PÁGINA
    </div>
    <a class="settings-index-link active" href="#conta" data-settings-link aria-current="location">
      <span>
        01
      </span>
      Conta
    </a>
    <a class="settings-index-link" href="#perfil" data-settings-link>
      <span>
        02
      </span>
      Perfil profissional
    </a>
    <a class="settings-index-link" href="#privacidade" data-settings-link>
      <span>
        03
      </span>
      Privacidade e visibilidade
    </a>
    <a class="settings-index-link" href="#descoberta" data-settings-link>
      <span>
        04
      </span>
      Descoberta
    </a>
    <a class="settings-index-link" href="#aparencia" data-settings-link>
      <span>
        05
      </span>
      Aparência
    </a>
    <a class="settings-index-link" href="#ajuda" data-settings-link>
      <span>
        06
      </span>
      Ajuda e sobre
    </a>
  </aside>
  <div class="settings-content">
    <section id="conta" class="settings-section">
      <div class="eyebrow">
        CONTA
      </div>
      <h2>
        Sua conta
      </h2>
      <p>
        Os dados que identificam seu acesso ao Cypher.
      </p>
      <div class="account-summary">
        <div class="avatar avatar-yellow">
          <%= usuario.initials %>
        </div>
        <div>
          <strong>
            <%= usuario.name %>
          </strong>
          <span>
            <%= usuario.role %>
          </span>
        </div>
        <span class="account-status">
          <i>
          </i>
          Ativa
        </span>
      </div>
      <div class="settings-data-grid">
        <div class="settings-data">
          <span>
            E-mail
          </span>
          <strong>
            <%= usuario.email || 'Não informado' %>
          </strong>
        </div>
        <div class="settings-data">
          <span>
            Tipo de conta
          </span>
          <strong>
            <%= usuario.tipoConta === 'organizador' ? 'Organizador' : 'Profissional' %>
          </strong>
        </div>
        <div class="settings-data">
          <span>
            Status profissional
          </span>
          <strong>
            <%= usuario.availabilityLabel %>
          </strong>
        </div>
        <div class="settings-data ctag-setting">
          <span>
            ID Cypher imutável
          </span>
          <strong>
            <%= usuario.publicCode %>
          </strong>
        </div>
      </div>
    </section>
    <section id="perfil" class="settings-section">
      <div class="eyebrow">
        PERFIL PROFISSIONAL
      </div>
      <h2>
        Como você aparece
      </h2>
      <p>
        Mantenha sua identidade profissional clara para a cena.
      </p>
      <div class="settings-link-list">
        <a class="settings-link-row" href="/profile?editar=1#editar-perfil">
          <span class="settings-link-icon lucide-icon" aria-hidden="true">
            <%- icones.user %>
          </span>
          <span>
            <strong>
              Editar perfil
            </strong>
            <small>
              Identidade, biografia, categorias e C-Tag
            </small>
          </span>
          <span class="lucide-icon" aria-hidden="true">
            <%- icones.arrowUpRight %>
          </span>
        </a>
        <a class="settings-link-row" href="/works">
          <span class="settings-link-icon lucide-icon" aria-hidden="true">
            <%- icones.fileMusic %>
          </span>
          <span>
            <strong>
              Obras
            </strong>
            <small>
              Consulte o catálogo de obras
            </small>
          </span>
          <span class="lucide-icon" aria-hidden="true">
            <%- icones.arrowUpRight %>
          </span>
        </a>
      </div>
    </section>
    <section id="privacidade" class="settings-section">
      <div class="eyebrow">
        PRIVACIDADE E VISIBILIDADE
      </div>
      <h2>
        Você decide o que aparece
      </h2>
      <p>
        As opções abaixo controlam os dados exibidos na página pública do seu perfil.
      </p>
      <% if (!usuario.demonstracao) { %>
        <form method="post" action="/settings/privacy" class="privacy-form">
          <label class="privacy-option">
            <span>
              <strong>
                Perfil público
              </strong>
              <small>
                Permite abrir seu perfil pelo link compartilhável.
              </small>
            </span>
            <input type="checkbox" name="perfilPublico"<%= usuario.profilePublic ? 'checked' : '' %>>
          </label>
          <label class="privacy-option">
            <span>
              <strong>
                Mostrar localização
              </strong>
              <small>
                Exibe cidade e estado no perfil público.
              </small>
            </span>
            <input type="checkbox" name="localizacaoPublica"<%= usuario.locationPublic ? 'checked' : '' %>>
          </label>
          <label class="privacy-option">
            <span>
              <strong>
                Mostrar contato profissional
              </strong>
              <small>
                Exibe o contato informado no seu perfil. Seu e-mail de acesso não é publicado.
              </small>
            </span>
            <input type="checkbox" name="contatoPublico"<%= usuario.contactPublic ? 'checked' : '' %>>
          </label>
          <button class="button button-lime" type="submit">
            Salvar visibilidade
          </button>
        </form>
        <% if (usuario.profilePublic) { %>
          <p class="public-profile-link">
            Link do perfil:
            <a href="/p/<%= usuario.handle.replace(/^@/, '') %>">
              /p/<%= usuario.handle.replace(/^@/, '') %>
            </a>
          </p>
        <% } %>
      <% } else { %>
        <p class="settings-note">
          As preferências de visibilidade ficam disponíveis para contas pessoais.
        </p>
      <% } %>
    </section>
    <section id="descoberta" class="settings-section">
      <div class="eyebrow">
        DESCOBERTA
      </div>
      <h2>
        Informações profissionais
      </h2>
      <p>
        Essas informações ajudam a apresentar seu trabalho no Cypher.
      </p>
      <div class="settings-data-grid">
        <div class="settings-data">
          <span>
            Região principal
          </span>
          <strong>
            <%= usuario.city || 'Não informada' %>
          </strong>
        </div>
        <div class="settings-data">
          <span>
            Gêneros e estilos
          </span>
          <strong>
            <%= usuario.genres.length ? usuario.genres.join(' · ') : 'Não informados' %>
          </strong>
        </div>
      </div>
      <% if (!usuario.demonstracao) { %>
        <a class="button button-outline" href="/profile?editar=1#editar-perfil">
          Atualizar informações
        </a>
      <% } %>
    </section>
    <section id="aparencia" class="settings-section">
      <div class="eyebrow">
        APARÊNCIA
      </div>
      <h2>
        Escolha o clima da interface
      </h2>
      <div class="theme-mode-options">
        <button class="button button-outline theme-mode-choice" type="button" data-theme-mode="light" aria-pressed="true">
          Claro
        </button>
        <button class="button button-outline theme-mode-choice" type="button" data-theme-mode="dark" aria-pressed="false">
          Escuro
        </button>
      </div>
    </section>
    <section id="ajuda" class="settings-section">
      <div class="eyebrow">
        AJUDA E SOBRE
      </div>
      <h2>
        Continue no caminho
      </h2>
      <a class="settings-link-row" href="/central">
        <span class="settings-link-icon lucide-icon" aria-hidden="true">
          <%- icones.circleHelp %>
        </span>
        <span>
          <strong>
            Cypher Central
          </strong>
          <small>
            Guias e respostas da plataforma
          </small>
        </span>
        <span class="lucide-icon" aria-hidden="true">
          <%- icones.arrowUpRight %>
        </span>
      </a>
    </section>
    <form method="post" action="/logout" class="settings-signout">
      <div>
        <div class="eyebrow">
          FIM DO CAMINHO
        </div>
        <h2>
          Sair da conta
        </h2>
        <p>
          Encerre seu acesso a este espaço e retorne à tela de login.
        </p>
      </div>
      <button class="button button-outline danger-button" type="submit">
        <span class="lucide-icon" aria-hidden="true">
          <%- icones.arrowLeft %>
        </span>
        Sair da conta
      </button>
    </form>
    <% if (!usuario.demonstracao) { %>
      <section class="settings-section account-delete-section">
        <div class="eyebrow">
          ENCERRAMENTO DE CONTA
        </div>
        <h2>
          Excluir conta
        </h2>
        <p>
          A exclusão remove seu perfil e encerra suas sessões. Contas com obras, eventos ou beats próprios precisam remover ou transferir esses registros antes; créditos em obras de outras pessoas permanecem identificados pelo nome registrado.
        </p>
        <details class="account-delete-details">
          <summary>
            Continuar com a exclusão
          </summary>
          <form method="post" action="/settings/delete-account" class="account-delete-form">
            <label>
              Senha atual
              <input type="password" name="password" autocomplete="current-password" maxlength="128" required>
            </label>
            <label>
              Digite EXCLUIR para confirmar
              <input type="text" name="confirmacao" autocomplete="off" required>
            </label>
            <button class="button button-outline danger-button" type="submit">
              Excluir minha conta
            </button>
          </form>
        </details>
      </section>
    <% } %>
  </div>
</div>
</div>
</main>
</div>
<%- include('../partials/fim-pagina') %>
