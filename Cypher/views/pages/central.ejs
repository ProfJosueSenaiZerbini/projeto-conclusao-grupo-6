<%- include('../partials/cabecalho', { title, stylesheet }) %>
<div class="app-shell">
<%- include('../partials/barra-lateral', { path }) %>
<main class="main-shell">
<%- include('../partials/barra-superior', { breadcrumb: 'Cypher Central' }) %>
<div class="page-content">
<div class="page-header">
  <div>
    <div class="eyebrow">
      CONHECIMENTO COMPARTILHADO
    </div>
    <h1>
      Cypher Central
    </h1>
    <p>
      Informação direta para cuidar melhor da sua carreira e das suas
            obras.
    </p>
  </div>
</div>
<form class="central-search" data-central-search>
  <span class="lucide-icon" aria-hidden="true">
    <%- icones.search %>
  </span>
  <input type="search" placeholder="O que você quer entender hoje?" aria-label="Buscar na Cypher Central" >
  <button class="button button-dark" type="submit">
    Buscar
  </button>
</form>
<div class="central-layout">
  <div>
    <div class="eyebrow">
      PERGUNTAS FREQUENTES
    </div>
    <h2 class="central-section-title">
      Comece por aqui
    </h2>
    <div class="faq-list">
      <% faqs.forEach((faq, i) => { %>
        <div class="faq-item<%= i === 0 ? ' open' : '' %>" data-faq-item >
          <button type="button" data-faq aria-expanded="<%= i === 0 ? 'true' : 'false' %>" >
            <span>
              <b>
                0<%= i + 1 %>
              </b>
              <%= faq.q %>
            </span>
            <span class="lucide-icon faq-chevron" aria-hidden="true" >
              <%- icones.chevronDown %>
            </span>
          </button>
          <p>
            <%= faq.a %>
          </p>
        </div>
      <% }) %>
    </div>
  </div>
  <aside class="knowledge-aside">
    <div class="knowledge-pattern">
      <span>
        GUIA RÁPIDO
      </span>
      <h3>
        Organize antes de lançar.
      </h3>
      <p>
        Um bom registro de créditos evita ruído lá na frente.
      </p>
    </div>
    <div class="article-list">
      <div class="eyebrow">
        ARTIGOS RECENTES
      </div>
      <a href="/central">
        Direitos autorais sem juridiquês
        <span class="lucide-icon" aria-hidden="true">
          <%- icones.arrowUpRight %>
        </span>
      </a>
      <a href="/central">
        O que guardar no seu histórico
        <span class="lucide-icon" aria-hidden="true">
          <%- icones.arrowUpRight %>
        </span>
      </a>
      <a href="/central">
        Reputação é presença
        <span class="lucide-icon" aria-hidden="true">
          <%- icones.arrowUpRight %>
        </span>
      </a>
    </div>
  </aside>
</div>
</div>
</main>
</div>
<%- include('../partials/fim-pagina') %>
