<%- include('../partials/cabecalho', {title, stylesheet, mapaInterativo: typeof usaMapaInterativo !== 'undefined' && usaMapaInterativo}) %>
<div class="dc-shell ev-page">
 <a class="dc-skip" href="#evento-conteudo">Pular para o conteúdo</a>
 <%- include('../partials/barra-lateral',{path}) %>
 <div class="dc-page">
  <%- include('../partials/componentes/cabecalho-descoberta',{titulo:tela==='mapa'?'Eventos no mapa':'Eventos',tituloId:'titulo-evento',descricao:'Encontre a cena. Faça parte do encontro.'}) %>
  <main class="dc-content" id="evento-conteudo" tabindex="-1">
   <a class="ev-back" href="/eventos"><%- icones.arrowLeft %> Voltar à agenda</a>
   <% if(erro){ %><p class="ev-notice" role="alert"><%= erro %></p><% } %>
   <% if(tela==='mapa'){ %>
    <header class="dc-heading"><h2>Próximos eventos</h2><span><%= pontos.length %> <%= pontos.length === 1 ? 'evento' : 'eventos' %> no mapa</span></header>
    <form method="get" action="/eventos/mapa" class="ev-form ev-map-filter">
      <label>Cidade<select name="cidade"><option value="">Todas as cidades</option><% cidades.forEach(cidadeOpcao=>{ %><option value="<%= cidadeOpcao.id %>"<%= cidade===cidadeOpcao.id?' selected':'' %>><%= cidadeOpcao.label %></option><% }) %></select></label>
      <button class="ev-secondary">Mostrar no mapa</button>
    </form>
    <p class="ev-muted">Só aparecem no mapa eventos com local confirmado. Os demais continuam na agenda.</p>
    <% if(pontos.length){ %>
    <div class="ev-map-layout">
      <section aria-label="Mapa interativo" class="ev-panel ev-map-shell">
        <p data-map-status class="ev-muted" role="status" hidden></p>
        <div class="ev-map" role="region" aria-label="Pinos dos eventos. A lista também está disponível." data-event-map data-selecionado="<%= escolhido %>" hidden></div>
        <noscript><p class="ev-muted">O mapa interativo precisa de JavaScript. Use a lista para abrir os eventos.</p></noscript>
      </section>
      <section class="ev-panel ev-map-list" aria-labelledby="ev-mapa-lista">
        <h3 id="ev-mapa-lista">Eventos nesta área</h3>
        <ul><% pontos.forEach(p=>{ %>
          <li data-marker="<%= p.id %>" data-lat="<%= p.latitude %>" data-lon="<%= p.longitude %>">
            <a class="ev-map-choice" href="/eventos/<%= encodeURIComponent(p.id) %>"><strong><%= p.titulo %></strong><span><%= p.quando %></span><span><%= p.local %></span></a>
            <button type="button" class="ev-secondary" aria-label="Ver no mapa: <%= p.titulo %>" hidden>Ver pino</button>
          </li>
        <% }) %></ul>
      </section>
    </div>
    <% } else{ %><div class="dc-empty"><%- icones.mapPin %><div><strong>Nenhum local confirmado para os próximos eventos.</strong><p>Você ainda pode consultá-los na agenda.</p></div></div><% } %>
   <% } else if(tela==='ficha'){ const e=f.evento,c=f.config,base='/eventos/'+encodeURIComponent(e.id); const valor=(nome,padrao='')=>typeof formulario[nome]==='string'?formulario[nome]:padrao; %>
    <% const cartaz = include("../partials/componentes/midias-publicacao", { tipo: "evento", id: e.id }).trim();
       const creditos = include("../partials/componentes/creditos-ficha", { tipo: "evento", id: e.id }).trim();
       const metricas = [["Interessados", f.totais.interessados], ["Inscrições", f.totais.inscritos], ["Confirmados", f.totais.confirmados], ["Presentes", f.totais.presentes]];
       const destaques = metricas.filter(([nome,total]) => !f.dono && total > 0 && ["Interessados","Confirmados"].includes(nome));
       const exibirExperiencia = Boolean(f.avaliacao || f.avaliavel || f.feedback.total);
       const destino = c.estado === "ativo" && e.situacao !== "Cancelado" ? pontoEvento(c) : null; %>
    <header class="ev-hero">
      <div class="ev-hero-copy">
        <span class="dc-stamp"><%= e.categoria %> · <%= c.estado==="cancelado" ? "Cancelado" : !c.inicio_em && !c.fim_em ? "Programação a confirmar" : e.situacao %></span>
        <h2><%= e.titulo %></h2>
        <p class="ev-organizador">Organização: <strong><%= e.organizador %></strong></p>
        <% if (e.descricao) { %><p class="ev-descricao"><%= e.descricao %></p><% } %>
        <% if (destaques.length) { %><dl class="ev-highlights"><% destaques.forEach(([nome,total]) => { %><div><dd><%= total %></dd><dt><%= nome.toLowerCase() %></dt></div><% }) %></dl><% } %>
      </div>
      <aside class="ev-hero-facts" aria-label="Quando e onde">
        <div class="ev-date">
          <span aria-hidden="true"><%- icones.calendarDays %></span>
          <strong><%= data(c.inicio_em) %></strong>
          <span>Até <%= data(c.fim_em) %></span>
        </div>
        <div class="ev-hero-place">
          <span aria-hidden="true"><%- icones.mapPin %></span>
          <strong><%= e.local || "Local a confirmar" %></strong>
          <% if (e.formato) { %><span><%= e.formato %></span><% } %>
        </div>
        <% if(destino){ %><div class="ev-mapa-detalhe">
          <iframe class="ev-map ev-map-compacto" title="Mapa de <%= e.titulo %>" src="<%= previaMapa(destino) %>" loading="lazy" referrerpolicy="strict-origin-when-cross-origin"></iframe>
          <p class="ev-map-credit">© <a href="https://www.openstreetmap.org/copyright">colaboradores do OpenStreetMap</a></p>
          <a class="ev-secondary" href="https://www.google.com/maps/dir/?api=1&amp;destination=<%= encodeURIComponent(destino.latitude+','+destino.longitude) %>" target="_blank" rel="noopener noreferrer"><%- icones.mapPin %> Como chegar</a>
        </div><% } %>
      </aside>
      <div class="ev-hero-toolbar">
        <nav class="ev-jump" aria-label="Seções do evento">
          <a href="#participacao">Participação</a><a href="#local">Regras e acesso</a><a href="#experiencia">Depois do evento</a><% if(f.dono){ %><a href="#gestao">Gestão</a><% } %>
        </nav>
        <div class="ev-social"><%- include("../partials/componentes/acoes-conteudo", { tipo:"evento", id:e.id, ocultarSalvar:!f.dono, denuncia:"Denunciar este evento" }) %></div>
      </div>
    </header>
    <% if(c.estado==="cancelado"){ %><p class="ev-notice" role="status"><strong>Evento cancelado.</strong> <%= c.motivo_cancelamento %></p><% } %>
    <div class="ev-columns">
      <div class="ev-section-stack ev-section-primary">
        <section class="ev-panel" id="participacao"><header class="dc-heading"><h2>Sua participação</h2></header>
      <% if(f.dono){ %><p>Você é responsável pela organização deste evento.</p><a class="dc-primary" href="#gestao">Gerenciar inscrições</a>
      <% }else{ %>
       <div class="ev-actions"><% for(const [acao,rotulo,ativo] of [['interesse','Tenho interesse',f.acompanhamento?.interessado],['salvar','Salvar evento',f.acompanhamento?.salvo]]){ %><form method="post" action="<%= base %>/acompanhar"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="acao" value="<%= acao %>"><input type="hidden" name="ativo" value="<%= ativo?'nao':'sim' %>"><% if (acao === 'salvar') { %><%- include('../partials/componentes/botao-salvar', { salvo: !!ativo, alvo: e.titulo, desabilitado: c.estado === 'cancelado' }) %><% } else { %><button class="ev-secondary" aria-pressed="<%= !!ativo %>"<% if(c.estado==='cancelado'){ %> disabled<% } %>><%= ativo?'✓ ':'' %><%= rotulo %></button><% } %></form><% } %></div>
       <p class="ev-muted">Interesse e salvamento não reservam vaga nem comprovam presença.</p>
       <% if(f.inscricao){ %><p class="ev-status"><%= estados[f.inscricao.estado] %></p><% if(f.inscricao.resposta){ %><p><%= f.inscricao.resposta %></p><% } %><% if(['confirmada','pendente'].includes(f.inscricao.estado)&&!f.presenca){ %><form method="post" action="<%= base %>/inscricao/cancelar"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="ev-text-button">Cancelar minha inscrição</button></form><% } %><% } %>
       <% if(f.aberto&&(!f.inscricao||f.inscricao.estado==='cancelada')){ %><form class="ev-form" method="post" action="<%= base %>/inscricao"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>Apresentação à organização <small>Opcional</small><textarea name="justificativa" maxlength="1000" rows="3"><%= valor('justificativa') %></textarea></label><label class="ev-check"><input type="checkbox" name="aceite" value="sim" required> Li e aceito os critérios de participação.</label><button class="dc-primary"><%= e.tipo_participacao==='aprovacao'?'Solicitar inscrição':'Confirmar inscrição' %></button></form>
       <% }else if(!f.inscricao){ %><p class="ev-notice"><%= c.estado==="cancelado" || ["Cancelado","Encerrado"].includes(e.situacao) ? "As inscrições estão encerradas." : !c.inicio_em || !c.fim_em ? "A organização ainda precisa confirmar os horários para abrir as inscrições." : "As inscrições para este evento estão encerradas." %></p><% } %>
       <% if(f.presenca){ %><p class="ev-status">Comparecimento reconhecido pela organização.</p><% } %>
       <details class="ev-details"><summary>Lembretes deste evento</summary><form class="ev-form" method="post" action="<%= base %>/acompanhar"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="acao" value="preferencias"><p class="ev-muted">Avisos na Cypher para eventos salvos, de seu interesse ou com inscrição ativa.</p><label class="ev-check"><input type="checkbox" name="lembrar24" value="sim"<% if(f.acompanhamento?.lembrar24??true){ %> checked<% } %>> Até 24 horas antes</label><label class="ev-check"><input type="checkbox" name="lembrarDia" value="sim"<% if(f.acompanhamento?.lembrar_dia??true){ %> checked<% } %>> No dia do evento</label><button class="ev-secondary">Salvar preferências</button></form></details>
      <% } %>
     </section>

      </div>
      <div class="ev-section-stack ev-section-secondary">
     <section class="ev-panel" id="local"><header class="dc-heading"><h2>Regras e acesso</h2></header><dl class="ev-facts"><div><dt>Admissão</dt><dd><%= e.tipo_participacao==='aprovacao'?'Mediante aprovação da organização':'Aberta, conforme as vagas disponíveis' %></dd></div><div><dt>Vagas</dt><dd><%= c.capacidade===null?'Sem limite informado':f.vagas+' disponíveis de '+c.capacidade %></dd></div><div><dt>Condições</dt><dd><%= c.criterios||e.inscricao||'A organização ainda precisa confirmar os critérios.' %></dd></div><% if(e.premio){ %><div><dt>Destaque</dt><dd><%= e.premio %></dd></div><% } %></dl>
      <% if(f.edicoes.length>1){ %><details class="ev-details"><summary>Outras edições</summary><ul><% f.edicoes.forEach(ed=>{ %><li><a href="/eventos/<%= encodeURIComponent(ed.id) %>"><%= ed.titulo %> · <%= ed.data_texto %></a></li><% }) %></ul></details><% } %>
     </section>
        <% if(cartaz || creditos || f.dono){ %>
          <section class="ev-panel ev-recursos" aria-labelledby="ev-recursos">
            <header class="dc-heading"><h2 id="ev-recursos">Cartaz e créditos</h2></header>
            <%- cartaz %><%- creditos %>
            <% if(f.dono){ %><div class="ev-actions"><a class="ev-secondary" href="/publicacoes/evento/<%= encodeURIComponent(e.id) %>/midias">Enviar cartaz</a><a class="ev-secondary" href="/creditos/gerir/evento/<%= encodeURIComponent(e.id) %>">Gerenciar créditos</a></div><% } %>
          </section>
        <% } %>
    <section class="ev-panel<%= exibirExperiencia ? "" : " ev-panel-compact" %>" id="experiencia"><header class="dc-heading"><h2>Depois do evento</h2><% if (f.feedback.total) { %><span><%= f.feedback.total %> avaliações · <%= f.feedback.positivas %> positivas</span><% } %></header>
     <% if(f.avaliacao){ %><p class="ev-status">Sua experiência foi <%= f.avaliacao.positiva?'positiva':'negativa' %>.</p><p><%= f.avaliacao.justificativa %></p>
     <% }else if(f.avaliavel&&!f.dono){ %><form class="ev-form" method="post" action="<%= base %>/avaliacao"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><fieldset><legend>Como foi a experiência?</legend><label class="ev-check"><input type="radio" name="positiva" value="sim" required> Positiva</label><label class="ev-check"><input type="radio" name="positiva" value="nao" required> Negativa</label></fieldset><label>Conte o que aconteceu <small>Obrigatório em experiências negativas, com pelo menos 10 caracteres.</small><textarea name="justificativa" maxlength="1500" rows="3"><%= valor('justificativa') %></textarea></label><button class="dc-primary">Registrar experiência</button></form>
     <% }else{ %><p class="ev-muted">As avaliações abrem após o encerramento para quem teve a presença confirmada.</p><% } %>
     <% if(f.avaliavel&&!f.dono&&!f.reclamacoes.length){ %><details class="ev-details"><summary>Preciso tratar um problema com a organização</summary><form class="ev-form" method="post" action="<%= base %>/reclamacoes"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><p>A organização recebe a reclamação primeiro e pode reconhecer ou contestar o relato.</p><label>O que aconteceu?<textarea name="descricao" required minlength="20" maxlength="3000" rows="4"><%= valor('descricao') %></textarea></label><label>Referências e evidências <small>Compartilhe somente o necessário para analisar o problema.</small><textarea name="evidencias" maxlength="3000" rows="3"><%= valor('evidencias') %></textarea></label><button class="ev-secondary">Enviar à organização</button></form></details><% } %>
    </section>
      </div>
    </div>
    <% if(f.dono){ %><section class="ev-panel" id="gestao"><header class="dc-heading"><h2>Gestão do evento</h2><a href="<%= base %>/editar">Editar informações <%- icones.arrowUpRight %></a></header><p class="ev-muted">A lista de inscrições e os registros de conferência ficam disponíveis apenas à organização.</p>
     <dl class="ev-metrics" aria-label="Resumo da participação"><% metricas.forEach(([nome,total]) => { %><div><dt><%= nome %></dt><dd><%= total %></dd></div><% }) %></dl>
     <% if(!f.inscricoes.length){ %><p>Ainda não há inscrições.</p><% } %><div class="ev-registration-list"><% f.inscricoes.forEach(i=>{ %><article class="ev-registration"><div><h3><%= i.nome %></h3><span><%= i.identificador %> · <%= estados[i.estado] %></span><% if(i.justificativa){ %><p><%= i.justificativa %></p><% } %><% if(i.presenca_em){ %><p class="ev-status">Presença registrada</p><% } %></div>
      <% if(i.estado==='pendente'&&f.aberto){ %><form class="ev-form" method="post" action="<%= base %>/inscricoes/<%= encodeURIComponent(i.usuario_id) %>/decisao"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="versao" value="<%= i.versao %>"><label>Decisão<select name="estado"><option value="confirmada">Aprovar inscrição</option><option value="recusada">Recusar inscrição</option></select></label><label>Justificativa ao participante<textarea name="resposta" required minlength="10" maxlength="1000" rows="2"></textarea></label><button class="ev-secondary">Comunicar decisão</button></form><% } %>
      <% if(i.estado==='confirmada'&&c.inicio_em&&Date.now()>=c.inicio_em&&c.estado==='ativo'){ %><form class="ev-form" method="post" action="<%= base %>/inscricoes/<%= encodeURIComponent(i.usuario_id) %>/presenca"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="acao" value="<%= i.presenca_em?'revogar':'registrar' %>"><label><%= i.presenca_em?'Motivo da correção':'Como o comparecimento foi conferido?' %><textarea name="evidencia" required minlength="10" maxlength="1200" rows="2" placeholder="Ex.: conferência da lista na entrada"></textarea></label><button class="ev-secondary"><%= i.presenca_em?'Corrigir presença':'Registrar comparecimento' %></button></form><% } %>
     </article><% }) %></div>
     <% if(c.estado==='ativo'){ %><details class="ev-details"><summary>Cancelar evento</summary><form class="ev-form" method="post" action="<%= base %>/cancelar"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="versao" value="<%= c.versao %>"><p>Inscrições são canceladas e as pessoas afetadas recebem um aviso. O histórico desta edição é preservado.</p><label>Motivo do cancelamento<textarea name="motivo" required minlength="10" maxlength="1500" rows="3"></textarea></label><button class="ev-secondary ev-danger">Confirmar cancelamento</button></form></details><% } %>
     <details class="ev-details"><summary>Histórico de alterações</summary><ol class="ev-history"><% f.historico.forEach(h=>{ %><li><strong><%= h.acao.replaceAll('_',' ') %></strong><span><%= data(h.criada_em) %></span></li><% }) %></ol></details>
    </section><% } %>
    <% if(f.reclamacoes.length){ %><section class="ev-panel" id="reclamacoes"><header class="dc-heading"><h2>Reclamações</h2></header><div class="ev-registration-list"><% f.reclamacoes.forEach(r=>{ %><article class="ev-registration"><div><h3><%= f.dono?r.nome:'Seu relato' %></h3><span class="ev-status"><%= ({pendente:'Aguardando organização',reconhecida:'Problema reconhecido',contestada:'Relato contestado',moderacao:'Encaminhado à moderação'})[r.estado] %></span><p class="ev-preserve"><%= r.descricao %></p><% if(r.evidencias){ %><details class="ev-details"><summary>Evidências compartilhadas</summary><p class="ev-preserve"><%= r.evidencias %></p></details><% } %><% if(r.resposta){ %><p class="ev-preserve"><strong>Organização:</strong> <%= r.resposta %></p><% } %></div>
     <% if(f.dono&&r.estado==='pendente'){ %><form class="ev-form" method="post" action="<%= base %>/reclamacoes/<%= encodeURIComponent(r.id) %>/responder"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>Posicionamento<select name="estado"><option value="reconhecida">Reconhecer o problema</option><option value="contestada">Contestar o relato</option></select></label><label>Resposta ao participante<textarea name="resposta" required minlength="20" maxlength="3000" rows="3"></textarea></label><button class="ev-secondary">Enviar resposta</button></form><% } %>
     <% if(!f.dono&&r.estado==='contestada'){ %><form method="post" action="<%= base %>/reclamacoes/<%= encodeURIComponent(r.id) %>/encaminhar"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="ev-secondary">Pedir análise à moderação</button></form><% } %>
     <% if(!f.dono&&r.caso_suporte_id){ %><a class="ev-secondary" href="/suporte/<%= encodeURIComponent(r.caso_suporte_id) %>">Acompanhar análise</a><% } %>
    </article><% }) %></div></section><% } %>
   <% } %>
  </main>
  <%- include('../partials/navegacao-mobile',{rotaAtual:'/eventos'}) %>
 </div>
</div>
<%- include('../partials/fim-pagina') %>
