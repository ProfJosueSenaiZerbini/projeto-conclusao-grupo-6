<%- include('../partials/cabecalho', { title, stylesheet }) %>
<div class="app-shell">
<%- include('../partials/barra-lateral', { path }) %>
<main class="main-shell">
<%- include('../partials/barra-superior', { breadcrumb: 'Obras' }) %>
<div class="page-content">
<div class="page-header">
  <div>
    <div class="eyebrow">
      ORGANIZAÇÃO PROFISSIONAL
    </div>
    <h1>
      Obras
    </h1>
    <p>
      Um lugar claro para guardar sua trajetória e reconhecer quem constrói com você.
    </p>
  </div>
  <a class="button button-lime" href="/works/new">
    <span class="lucide-icon" aria-hidden="true">
      <%- icones.plus %>
    </span>
    Cadastrar obra
  </a>
</div>
<% if (mensagem) { %>
  <div class="form-feedback success-feedback" role="status">
    <span class="lucide-icon" aria-hidden="true">
      <%- icones.circleCheck %>
    </span>
    <%= mensagem %>
  </div>
<% } %>
<div class="works-overview">
  <section class="work-overview-card catalog-summary">
    <div>
      <span>
        CATÁLOGO · PRINCIPAL / PARTICIPAÇÕES
      </span>
      <strong>
        <%= estatisticasObras.publicadasComoArtista %>
        /<%= estatisticasObras.participacoesComoFeat %>
      </strong>
      <p>
        Lançamentos como artista principal / participações em obras
      </p>
    </div>
    <a href="#catalogo-obras" class="overview-link">
      Ver catálogo
      <span class="lucide-icon" aria-hidden="true">
        <%- icones.arrowUpRight %>
      </span>
    </a>
  </section>
  <section class="work-overview-card in-progress-summary">
    <span>
      EM ANDAMENTO
    </span>
    <strong>
      <%= String(estatisticasObras.emAndamento).padStart(2, '0') %>
    </strong>
    <p>
      Obras que ainda pedem atenção
    </p>
    <span class="lucide-icon summary-watermark" aria-hidden="true">
      <%- icones.audioLines %>
    </span>
  </section>
</div>
<div class="works-toolbar" id="catalogo-obras">
  <div>
    <div class="eyebrow">
      SEU CATÁLOGO
    </div>
    <h2>
      Obras e trabalhos musicais
    </h2>
  </div>
  <span class="catalog-count">
    <%= obras.length %>
    <%= obras.length === 1 ? 'obra' : 'obras' %>
  </span>
</div>
<form class="catalog-filters card-surface" method="get" action="/works">
  <div class="catalog-filter-heading">
    <div>
      <div class="eyebrow">
        ORGANIZAÇÃO
      </div>
      <strong>
        Filtrar catálogo
      </strong>
    </div>
    <% if (Object.values(filtrosCatalogo).some(Boolean)) { %>
      <a class="text-link" href="/works#catalogo-obras">
        Limpar filtros
      </a>
    <% } %>
  </div>
  <div class="catalog-filter-grid">
    <label>
      Status
      <select name="status">
        <option value="">
          Todos os status
        </option>
        <% opcoesFiltroCatalogo.status.forEach(opcao => { %>
          <option value="<%= opcao.value %>"<%= filtrosCatalogo.status === opcao.value ? 'selected' : '' %>>
            <%= opcao.label %>
          </option>
        <% }) %>
      </select>
    </label>
    <label>
      Tipo de obra
      <select name="tipo">
        <option value="">
          Todos os tipos
        </option>
        <% opcoesFiltroCatalogo.tipo.forEach(opcao => { %>
          <option value="<%= opcao.value %>"<%= filtrosCatalogo.tipo === opcao.value ? 'selected' : '' %>>
            <%= opcao.label %>
          </option>
        <% }) %>
      </select>
    </label>
    <label>
      Gênero musical
      <select name="genero">
        <option value="">
          Todos os gêneros
        </option>
        <% opcoesFiltroCatalogo.genero.forEach(opcao => { %>
          <option value="<%= opcao.value %>"<%= filtrosCatalogo.genero === opcao.value ? 'selected' : '' %>>
            <%= opcao.label %>
          </option>
        <% }) %>
      </select>
    </label>
    <label>
      Papel na obra
      <select name="papel">
        <option value="">
          Todos os papéis
        </option>
        <% opcoesFiltroCatalogo.papel.forEach(opcao => { %>
          <option value="<%= opcao.value %>"<%= filtrosCatalogo.papel === opcao.value ? 'selected' : '' %>>
            <%= opcao.label %>
          </option>
        <% }) %>
      </select>
    </label>
    <label>
      Ordenar por
      <select name="ordem">
        <% opcoesFiltroCatalogo.ordem.forEach(opcao => { %>
          <option value="<%= opcao.value %>"<%= filtrosCatalogo.ordem === opcao.value ? 'selected' : '' %>>
            <%= opcao.label %>
          </option>
        <% }) %>
      </select>
    </label>
    <button class="button button-dark catalog-filter-submit" type="submit">
      Aplicar filtros
    </button>
  </div>
</form>
<% if (obras.length) { %>
  <div class="catalog-sections">
    <% catalogoGrupos.forEach(grupo => { %>
      <section class="catalog-section" aria-labelledby="catalogo-<%= grupo.id %>">
        <div class="catalog-section-heading">
          <div>
            <div class="eyebrow">
              <%= grupo.titulo.toUpperCase() %>
            </div>
            <h3 id="catalogo-<%= grupo.id %>">
              <%= grupo.titulo %>
            </h3>
            <p>
              <%= grupo.descricao %>
            </p>
          </div>
          <span class="catalog-section-count">
            <%= grupo.obras.length %>
          </span>
        </div>
        <% if (grupo.obras.length) { %>
          <div class="works-card-list">
            <% grupo.obras.forEach((obra, i) => { %>
            <%- include('../partials/cartao-obra', { obra, i }) %>
          <% }) %>
        </div>
      <% } else { %>
        <p class="catalog-section-empty">
          Nenhum registro nesta seção.
        </p>
      <% } %>
    </section>
  <% }) %>
</div>
<% } else { %>
<%- include('../partials/componentes/estado-vazio', {
          classe: 'works-empty-state card-surface',
          variacao: 'destaque',
          icone: icones.fileMusic,
          eyebrow: 'SEU CATÁLOGO',
          titulo: 'Nenhuma obra encontrada',
          descricao: Object.values(filtrosCatalogo).some(Boolean)
            ? 'Nenhum registro corresponde aos filtros atuais. Ajuste a busca ou limpe os filtros.'
            : 'Registre uma obra para acompanhar seus dados, créditos e participações neste espaço.',
          acaoPrincipal: Object.values(filtrosCatalogo).some(Boolean)
            ? { href: '/works#catalogo-obras', label: 'Limpar filtros' }
            : { href: '/works/new', label: 'Cadastrar primeira obra' }
        }) %>
<% } %>
</div>
</main>
</div>
<dialog class="detail-dialog work-detail-dialog" id="detalhe-obra" aria-labelledby="detalhe-obra-titulo">
<div class="detail-dialog-header">
<span class="detail-kicker">
FICHA DA OBRA
</span>
<button class="icon-button detail-close" type="button" data-dialog-close aria-label="Fechar detalhe">
<span class="lucide-icon" aria-hidden="true">
<%- icones.x %>
</span>
</button>
</div>
<h2 id="detalhe-obra-titulo" data-work-title-detail>
</h2>
<div class="detail-tags">
<span data-work-type-detail>
</span>
<span data-work-status-detail>
</span>
</div>
<p class="work-detail-meta" data-work-meta-detail>
</p>
<section class="detail-section">
<h3>
Sobre
</h3>
<p data-work-description-detail>
</p>
<a class="text-link work-listen-link" data-work-listen-link target="_blank" rel="noopener noreferrer" hidden>
Abrir link de escuta
<span class="lucide-icon" aria-hidden="true">
<%- icones.arrowUpRight %>
</span>
</a>
</section>
<div class="detail-facts work-detail-facts">
<div>
<small>
PAPEL NA OBRA
</small>
<b data-work-role-detail>
</b>
</div>
<div>
<small>
CRÉDITOS ASSOCIADOS
</small>
<b data-work-credits-detail>
</b>
</div>
<div>
<small>
BPM
</small>
<b data-work-bpm-detail>
</b>
</div>
</div>
<div class="detail-facts work-detail-facts">
<div>
<small>
ISRC
</small>
<b data-work-isrc-detail>
</b>
</div>
<div>
<small>
ISWC
</small>
<b data-work-iswc-detail>
</b>
</div>
</div>
<section class="detail-section">
<h3>
Créditos e participações
</h3>
<div class="work-credit-detail-list" data-work-credit-list aria-live="polite">
</div>
</section>
<div class="work-detail-actions">
<a class="button button-outline" data-work-edit href="#">
Editar obra
</a>
<form method="post" action="#" data-work-delete>
<button class="button button-outline danger-button" type="submit">
Excluir obra
</button>
</form>
</div>
</dialog>
<%- include('../partials/fim-pagina') %>
