<%- include('../partials/cabecalho', { title, stylesheet }) %>
<div class="app-shell">
<%- include('../partials/barra-lateral', { path }) %>
<main class="main-shell">
<%- include('../partials/barra-superior', { breadcrumb: 'Oportunidades' }) %>
<div class="page-content">
<div class="page-header">
  <div>
    <div class="eyebrow">
      OPORTUNIDADES
    </div>
    <h1>
      A cena está chamando.
    </h1>
    <p>
      Eventos, encontros e espaços para colocar seu trabalho em movimento.
    </p>
  </div>
  <div class="page-header-actions">
    <% if (podeGerenciar) { %>
      <a class="button button-lime" href="/events/new">
        <span class="lucide-icon" aria-hidden="true">
          <%- icones.plus %>
        </span>
        Cadastrar evento
      </a>
    <% } %>
  </div>
</div>
<% if (mensagem) { %>
  <div class="form-feedback success-feedback" role="status">
    <%= mensagem %>
  </div>
<% } %>
<% if (erro) { %>
  <div class="form-feedback error-feedback" role="alert">
    <%= erro === 'permissao' ? 'Somente contas de organizador podem cadastrar e gerenciar eventos.' : erro === 'evento' ? 'O evento não foi encontrado ou não pertence à sua conta.' : erro %>
  </div>
<% } %>
<p class="interest-explainer" data-interest-notice role="status" hidden>
  Ao marcar interesse, você sinaliza aos organizadores que está ativo na cena. Eles poderão notificar você antes ou depois do lançamento do evento. Este protótipo não envia notificações.
</p>
<form class="events-filters" method="get" action="/events">
  <label>
    Categoria
    <select name="categoria">
      <option value="">
        Todas
      </option>
      <% opcoesCategorias.forEach(categoria => { %>
        <option value="<%= categoria %>"<%= filtros.categoria === categoria ? 'selected' : '' %>>
          <%= categoria %>
        </option>
      <% }) %>
    </select>
  </label>
  <label>
    Localização
    <input name="localizacao" value="<%= filtros.localizacao %>" placeholder="Cidade ou espaço">
  </label>
  <label>
    Formato
    <select name="formato">
      <option value="">
        Todos
      </option>
      <% opcoesFormatos.forEach(formato => { %>
        <option value="<%= formato %>"<%= filtros.formato === formato ? 'selected' : '' %>>
          <%= formato %>
        </option>
      <% }) %>
    </select>
  </label>
  <label>
    Período
    <select name="periodo">
      <option value="todos"<%= filtros.periodo === 'todos' ? 'selected' : '' %>>
        Todos
      </option>
      <option value="proximos"<%= filtros.periodo === 'proximos' ? 'selected' : '' %>>
        Próximos
      </option>
      <option value="passados"<%= filtros.periodo === 'passados' ? 'selected' : '' %>>
        Passados
      </option>
    </select>
  </label>
  <label>
    Ordenar
    <select name="ordem">
      <option value="recentes"<%= filtros.ordem === 'recentes' ? 'selected' : '' %>>
        Mais recentes
      </option>
      <option value="data"<%= filtros.ordem === 'data' ? 'selected' : '' %>>
        Data do evento
      </option>
      <option value="titulo"<%= filtros.ordem === 'titulo' ? 'selected' : '' %>>
        Título
      </option>
    </select>
  </label>
  <div class="events-filter-actions">
    <button class="button button-dark small" type="submit">
      Filtrar
    </button>
    <a class="text-link" href="/events">
      Limpar
    </a>
  </div>
</form>
<div class="tabs-row" role="group" aria-label="Filtrar oportunidades">
  <button class="tab active" type="button" data-event-filter="Todos" aria-pressed="true">
    Todos
  </button>
  <button class="tab" type="button" data-event-filter="Batalha" aria-pressed="false">
    Batalhas
  </button>
  <button class="tab" type="button" data-event-filter="Show" aria-pressed="false">
    Shows
  </button>
  <button class="tab" type="button" data-event-filter="Cypher" aria-pressed="false">
    Cyphers
  </button>
  <button class="tab" type="button" data-event-filter="Workshop" aria-pressed="false">
    Workshops
  </button>
</div>
<div class="events-layout">
  <div class="events-list<%= eventos.length === 1 ? ' events-list-single' : '' %>" data-events-list>
    <% eventos.forEach((evento, i) => { %>
      <div class="event-card-wrapper">
        <button class="event-card event-card-trigger" type="button" data-event-card data-event-category="<%= evento.category %>" data-detail-id="<%= evento.id %>" data-detail-demonstracao="<%= evento.demonstracao %>" data-detail-interest-status="<%= evento.interesseStatus ?? '' %>" data-detail-total-interested="<%= evento.totalInteressados %>" data-detail-title="<%= evento.title %>" data-detail-category="<%= evento.category %>" data-detail-date="<%= evento.date %>" data-detail-time="<%= evento.time %>" data-detail-location="<%= evento.location %>" data-detail-org="<%= evento.org %>" data-detail-status="<%= evento.status %>" data-detail-description="<%= evento.description %>" data-detail-format="<%= evento.format %>" data-detail-registration="<%= evento.registration %>" data-detail-prize="<%= evento.prize %>" data-detail-tags="<%= evento.tags.join('|') %>">
          <span class="event-card-band band-<%= evento.color %>">
            <span>
              0<%= i + 1 %>
            </span>
            <span>
              <%= evento.category %>
            </span>
            <% if (evento.demonstracao) { %>
              <span>
                EXEMPLO DEMONSTRATIVO
              </span>
            <% } %>
          </span>
          <span class="event-card-content">
            <span class="event-date-large">
              <strong>
                <%= evento.date.split(' ')[0] %>
              </strong>
              <span>
                <%= evento.date.split(' ')[1] %>
              </span>
            </span>
            <span class="event-main">
              <strong class="event-title">
                <%= evento.title %>
              </strong>
              <span class="event-org">
                <%= evento.org %>
              </span>
              <span class="event-meta">
                <span>
                  <i class="lucide-icon" aria-hidden="true">
                    <%- icones.mapPin %>
                  </i>
                  <%= evento.location %>
                </span>
                <span>
                  <i class="lucide-icon" aria-hidden="true">
                    <%- icones.clock %>
                  </i>
                  <%= evento.status %>
                </span>
              </span>
            </span>
            <span class="event-open-hint">
              <span>
                Ver oportunidade
              </span>
              <i class="lucide-icon" aria-hidden="true">
                <%- icones.arrowUpRight %>
              </i>
            </span>
          </span>
        </button>
        <% if (evento.owned) { %>
          <div class="event-management-actions">
            <a class="text-link" href="/events/<%= encodeURIComponent(evento.id) %>/edit">
              Editar
            </a>
            <form method="post" action="/events/<%= encodeURIComponent(evento.id) %>/delete" onsubmit="return confirm('Excluir este evento?')">
              <button class="text-link danger-link" type="submit">
                Excluir
              </button>
            </form>
          </div>
          <% if (evento.interessados.length) { %>
            <div class="event-interested-list">
              <strong>
                Interesses recebidos (<%= evento.totalInteressados %>)
              </strong>
              <% evento.interessados.forEach(interesse => { %>
                <div class="event-interested-row">
                  <span>
                    <b>
                      <%= interesse.nome %>
                    </b>
                    <small>
                      @<%= interesse.handle %>·<%= interesse.status %>
                    </small>
                  </span>
                  <form method="post" action="/events/<%= encodeURIComponent(evento.id) %>/interests/<%= encodeURIComponent(interesse.usuarioId) %>/status">
                    <select name="status" aria-label="Status de<%= interesse.nome %>">
                      <option value="interessado"<%= interesse.status === 'interessado' ? ' selected' : '' %>>
                        Interessado
                      </option>
                      <option value="inscrito"<%= interesse.status === 'inscrito' ? ' selected' : '' %>>
                        Inscrito
                      </option>
                      <option value="confirmado"<%= interesse.status === 'confirmado' ? ' selected' : '' %>>
                        Confirmado
                      </option>
                      <option value="rejeitado"<%= interesse.status === 'rejeitado' ? ' selected' : '' %>>
                        Rejeitado
                      </option>
                    </select>
                    <button class="text-link" type="submit">
                      Salvar
                    </button>
                  </form>
                </div>
              <% }) %>
            </div>
          <% } %>
        <% } %>
      </div>
    <% }) %>
    <% if (!eventos.length) { %>
    <%- include('../partials/componentes/estado-vazio', {
        classe: 'events-empty-state',
        variacao: 'destaque',
        icone: icones.calendarDays,
        titulo: 'Nenhum evento encontrado',
        descricao: 'Ajuste os filtros ou cadastre uma nova oportunidade para a comunidade.',
        acaoPrincipal: podeGerenciar ? { href: '/events/new', label: 'Cadastrar evento' } : null
      }) %>
  <% } %>
  <% if (eventos.length) { %>
    <div class="events-filter-empty" data-events-filter-empty hidden>
      <span class="lucide-icon" aria-hidden="true">
        <%- icones.calendarDays %>
      </span>
      <strong>
        Nenhum evento nesta categoria
      </strong>
      <p>
        Escolha outra aba ou limpe os filtros para ver mais oportunidades.
      </p>
    </div>
  <% } %>
</div>
<aside class="event-side history-card">
  <div class="history-card-top">
    <span class="history-icon lucide-icon" aria-hidden="true">
      <%- icones.chart %>
    </span>
    <span class="eyebrow">
      HISTÓRICO
    </span>
  </div>
  <h2>
    Seu rastro na cena
  </h2>
  <div class="history-number">
    07
    <span>
      participações
    </span>
  </div>
  <div class="history-meter" role="img" aria-label="Participações distribuídas em três categorias">
    <i>
    </i>
    <i>
    </i>
    <i>
    </i>
  </div>
  <p>
    Seus interesses e participações confirmadas passam a ser registrados nesta área.
  </p>
  <div class="history-categories">
    <span>
      Batalhas
      <b>
        03
      </b>
    </span>
    <span>
      Cyphers
      <b>
        02
      </b>
    </span>
    <span>
      Formação
      <b>
        02
      </b>
    </span>
  </div>
  <small class="history-demo-note">
    O histórico confirmado será ampliado nas próximas etapas.
  </small>
</aside>
</div>
</div>
</main>
</div>
<dialog class="detail-dialog" id="detalhe-oportunidade" aria-labelledby="detalhe-oportunidade-titulo">
<div class="detail-dialog-header">
<span class="detail-kicker" data-event-category-detail>
OPORTUNIDADE
</span>
<button class="icon-button detail-close" type="button" data-dialog-close aria-label="Fechar detalhe">
<span class="lucide-icon" aria-hidden="true">
<%- icones.x %>
</span>
</button>
</div>
<h2 id="detalhe-oportunidade-titulo" data-event-title-detail>
</h2>
<div class="detail-meta">
<span>
<i class="lucide-icon" aria-hidden="true">
<%- icones.users %>
</i>
<b data-event-org-detail>
</b>
</span>
<span>
<i class="lucide-icon" aria-hidden="true">
<%- icones.calendarDays %>
</i>
<b>
<span data-event-date-detail>
</span>
·
<span data-event-time-detail>
</span>
</b>
</span>
<span>
<i class="lucide-icon" aria-hidden="true">
<%- icones.mapPin %>
</i>
<b data-event-location-detail>
</b>
</span>
</div>
<div class="detail-banner">
<span class="lucide-icon" aria-hidden="true">
<%- icones.sparkles %>
</span>
<span data-event-category-detail>
</span>
</div>
<section class="detail-section">
<h3>
Sobre a oportunidade
</h3>
<p data-event-description-detail>
</p>
</section>
<div class="detail-facts">
<div>
<span class="lucide-icon" aria-hidden="true">
<%- icones.mic %>
</span>
<small>
FORMATO
</small>
<b data-event-format-detail>
</b>
</div>
<div>
<span class="lucide-icon" aria-hidden="true">
<%- icones.calendarCheck %>
</span>
<small>
INSCRIÇÕES
</small>
<b data-event-registration-detail>
</b>
</div>
<div>
<span class="lucide-icon" aria-hidden="true">
<%- icones.trophy %>
</span>
<small>
DESTAQUE
</small>
<b data-event-prize-detail>
</b>
</div>
</div>
<div class="detail-tags" data-event-tags-detail>
</div>
<p class="interest-count" role="status">
<span data-event-interest-total>
0
</span>
pessoa(s) demonstraram interesse.
</p>
<p class="interest-explainer" data-event-demo-notice role="status" hidden>
Este evento é um exemplo demonstrativo. Ele não recebe inscrições ou interesses operacionais.
</p>
<div class="detail-actions">
<form method="post" data-interest-form>
<button class="button button-lime" type="submit" data-interest-button aria-pressed="false">
<span class="lucide-icon" aria-hidden="true">
  <%- icones.calendarCheck %>
</span>
<span data-interest-label>
  Demonstrar interesse
</span>
</button>
</form>
<button class="button button-outline" type="button" data-toast="Link copiado nesta demonstração">
<span class="lucide-icon" aria-hidden="true">
<%- icones.share %>
</span>
Compartilhar
</button>
</div>
</dialog>
<%- include('../partials/fim-pagina') %>
