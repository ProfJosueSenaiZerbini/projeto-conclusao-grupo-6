<%- include('../partials/cabecalho', { title, stylesheet }) %>
<div class="app-shell">
<%- include('../partials/barra-lateral', { path }) %>
<main class="main-shell">
<%- include('../partials/barra-superior', { breadcrumb: editando ? 'Beats / Editar' : 'Beats / Cadastrar' }) %>
<div class="page-content work-form-page">
<a href="/beats" class="back-link">
  <span class="lucide-icon" aria-hidden="true">
    <%- icones.arrowLeft %>
  </span>
  Voltar para o Banco de Beats
</a>
<div class="page-header">
  <div>
    <div class="eyebrow">
      <%= editando ? 'ATUALIZAÇÃO DO BEAT' : 'NOVO BEAT' %>
    </div>
    <h1>
      <%= editando ? 'Editar beat' : 'Cadastrar beat' %>
    </h1>
    <p>
      Organize as informações técnicas e as condições de uso do seu instrumental.
    </p>
  </div>
</div>
<% if (erro) { %>
  <div class="form-feedback error-feedback" role="alert">
    <span class="lucide-icon" aria-hidden="true">
      <%- icones.circleHelp %>
    </span>
    <%= erro %>
  </div>
<% } %>
<div class="work-form-notice beat-form-notice">
  <span class="lucide-icon" aria-hidden="true">
    <%- icones.shieldCheck %>
  </span>
  <div>
    <strong>
      Licenciamento transparente
    </strong>
    <p>
      Informe uma condição de uso clara. A venda e o pagamento serão adicionados em etapas próprias.
    </p>
  </div>
</div>
<form class="work-form beat-form" method="post" action="<%= editando ? `/beats/${encodeURIComponent(beatId)}/edit` : '/beats/new' %>">
  <section class="form-section">
    <div class="form-section-heading">
      <span class="form-step">
        01
      </span>
      <div>
        <h2>
          Identificação do beat
        </h2>
        <p>
          Comece pelos dados que ajudam artistas a encontrar o instrumental.
        </p>
      </div>
    </div>
    <div class="form-grid">
      <label class="field-full">
        Título do beat
        <span class="required-mark">
          *
        </span>
        <input name="title" required minlength="2" maxlength="120" placeholder="Ex.: Semáforo quebrado" value="<%= valores.title %>">
      </label>
      <label>
        Gênero
        <span class="optional-mark">
          Opcional
        </span>
        <input name="genre" maxlength="60" placeholder="Ex.: Boom bap" value="<%= valores.genre %>">
      </label>
      <label>
        BPM
        <span class="optional-mark">
          Opcional
        </span>
        <input name="bpm" type="number" min="30" max="300" step="1" placeholder="Ex.: 92" value="<%= valores.bpm %>">
      </label>
      <label>
        Tonalidade
        <span class="optional-mark">
          Opcional
        </span>
        <input name="key" maxlength="30" placeholder="Ex.: Dm" value="<%= valores.key %>">
      </label>
      <label>
        Duração
        <span class="optional-mark">
          Opcional
        </span>
        <input name="duration" pattern="\d{1,2}:[0-5]\d" placeholder="mm:ss — Ex.: 2:48" value="<%= valores.duration %>">
      </label>
    </div>
  </section>
  <section class="form-section">
    <div class="form-section-heading">
      <span class="form-step">
        02
      </span>
      <div>
        <h2>
          Licença e condições de uso
        </h2>
        <p>
          Apresente o que pode ou não ser feito com o instrumental.
        </p>
      </div>
    </div>
    <div class="form-grid">
      <label>
        Licença principal
        <span class="required-mark">
          *
        </span>
        <select name="license" required>
          <% licencasBeat.forEach(licenca => { %>
            <option value="<%= licenca %>"<%= valores.license === licenca ? 'selected' : '' %>>
              <%= licenca %>
            </option>
          <% }) %>
        </select>
      </label>
      <label class="field-full">
        Condições de uso
        <span class="optional-mark">
          Opcional
        </span>
        <textarea name="usage" rows="4" maxlength="500" placeholder="Ex.: permitido usar em demo; crédito obrigatório ao beatmaker.">
          <%= valores.usage %>
        </textarea>
      </label>
      <label class="field-full">
        Descrição
        <span class="optional-mark">
          Opcional
        </span>
        <textarea name="description" rows="4" maxlength="500" placeholder="Descreva a atmosfera, referências e características do beat.">
          <%= valores.description %>
        </textarea>
      </label>
    </div>
  </section>
  <section class="form-section">
    <div class="form-section-heading">
      <span class="form-step">
        03
      </span>
      <div>
        <h2>
          Ofertas de licença
        </h2>
        <p>
          Cadastre uma ou mais opções comerciais. O preço é opcional para ofertas sob consulta.
        </p>
      </div>
    </div>
    <label class="exclusive-toggle">
      <input type="checkbox" name="vendaExclusiva" value="on"<%= valores.vendaExclusiva ? 'checked' : '' %>data-exclusive-toggle>
      <span>
        <strong>
          Este Beat será vendido com exclusividade
        </strong>
        <small>
          Após uma compra exclusiva, o Beat deverá ficar disponível somente para o comprador. O checkout e o registro da compra serão conectados em uma etapa própria.
        </small>
      </span>
    </label>
    <div id="ofertas-beat" class="offer-list">
      <% (valores.ofertas?.length ? valores.ofertas : [{ tipo: 'Não informado', preco: '', descricao: '' }]).forEach((oferta, indice) => { %>
        <div class="offer-card" data-offer-card>
          <div class="offer-card-heading">
            <strong>
              Oferta
              <span data-offer-number>
                <%= indice + 1 %>
              </span>
            </strong>
            <button class="button button-ghost offer-remove" type="button" data-remove-offer<%= indice === 0 ? 'disabled' : '' %>>
              Remover
            </button>
          </div>
          <div class="form-grid">
            <label>
              Tipo de licença
              <select name="ofertaTipo" required>
                <% ['Não informado', 'Licença básica', 'Licença premium', 'Exclusiva'].forEach(tipo => { %>
                  <option value="<%= tipo %>"<%= oferta.tipo === tipo ? 'selected' : '' %>>
                    <%= tipo %>
                  </option>
                <% }) %>
              </select>
            </label>
            <label>
              Preço em R$
              <input name="ofertaPreco" inputmode="decimal" placeholder="Ex.: 149,90" value="<%= oferta.preco %>">
            </label>
            <label class="field-full">
              Descrição da oferta
              <span class="optional-mark">
                Opcional
              </span>
              <input name="ofertaDescricao" maxlength="300" placeholder="Ex.: uso comercial e distribuição permitidos" value="<%= oferta.descricao %>">
            </label>
          </div>
        </div>
      <% }) %>
    </div>
    <button class="button button-outline" type="button" id="adicionar-oferta"<%= valores.vendaExclusiva ? 'hidden' : '' %>>
      Adicionar oferta
    </button>
  </section>
  <div class="work-form-actions">
    <a class="button button-outline" href="/beats">
      Cancelar
    </a>
    <button class="button button-yellow" type="submit">
      <span class="lucide-icon" aria-hidden="true">
        <%- icones.headphones %>
      </span>
      <%= editando ? 'Salvar alterações' : 'Cadastrar beat' %>
    </button>
  </div>
</form>
</div>
</main>
</div>
<script>
(() => {
    const lista = document.querySelector('#ofertas-beat');
    const adicionar = document.querySelector('#adicionar-oferta');
    const exclusivo = document.querySelector('[data-exclusive-toggle]');
    if (!lista || !adicionar) return;

    const sincronizarExclusividade = () => {
      const ativo = exclusivo instanceof HTMLInputElement && exclusivo.checked;
      adicionar.hidden = ativo;
      const cards = [...lista.querySelectorAll('[data-offer-card]')];
      if (ativo && cards.length > 1) cards.slice(1).forEach(card => card.remove());
      const select = lista.querySelector('select[name="ofertaTipo"]');
      if (ativo && select instanceof HTMLSelectElement) select.value = 'Exclusiva';
      atualizar();
    };

    const atualizar = () => {
      const cards = [...lista.querySelectorAll('[data-offer-card]')];
      cards.forEach((card, indice) => {
        const numero = card.querySelector('[data-offer-number]');
        const remover = card.querySelector('[data-remove-offer]');
        if (numero) numero.textContent = String(indice + 1);
        if (remover) remover.disabled = cards.length === 1;
      });
    };

    lista.addEventListener('click', event => {
      const alvo = event.target;
      if (alvo instanceof HTMLElement && alvo.matches('[data-remove-offer]')) {
        alvo.closest('[data-offer-card]')?.remove();
        atualizar();
      }
    });

    adicionar.addEventListener('click', () => {
      const card = lista.querySelector('[data-offer-card]')?.cloneNode(true);
      if (!(card instanceof HTMLElement)) return;
      card.querySelectorAll('input').forEach(input => { input.value = ''; });
      const select = card.querySelector('select');
      if (select instanceof HTMLSelectElement) select.selectedIndex = 0;
      lista.appendChild(card);
      atualizar();
    });
    exclusivo?.addEventListener('change', sincronizarExclusividade);
    sincronizarExclusividade();
  })();
</script>
<%- include('../partials/fim-pagina') %>
