<%- include('../partials/cabecalho', { title, stylesheet }) %>
<div class="app-shell">
<%- include('../partials/barra-lateral', { path }) %>
<main class="main-shell">
<%- include('../partials/barra-superior', { breadcrumb: editando ? 'Oportunidades / Editar' : 'Oportunidades / Cadastrar' }) %>
<div class="page-content work-form-page">
<a href="/events" class="back-link">
  <span class="lucide-icon" aria-hidden="true">
    <%- icones.arrowLeft %>
  </span>
  Voltar para Oportunidades
</a>
<div class="page-header">
  <div>
    <div class="eyebrow">
      <%= editando ? 'ATUALIZAÇÃO DE EVENTO' : 'NOVO EVENTO' %>
    </div>
    <h1>
      <%= editando ? 'Editar evento' : 'Cadastrar evento' %>
    </h1>
    <p>
      Organize uma oportunidade real para a comunidade Cypher encontrar e acompanhar.
    </p>
  </div>
</div>
<% if (erro) { %>
  <div class="form-feedback error-feedback" role="alert">
    <span class="lucide-icon" aria-hidden="true">
      <%- icones.circleHelp %>
    </span>
    <%= erro %>
  </div>
<% } %>
<div class="work-form-notice">
  <span class="lucide-icon" aria-hidden="true">
    <%- icones.calendarCheck %>
  </span>
  <div>
    <strong>
      Evento público
    </strong>
    <p>
      O evento ficará disponível na descoberta de oportunidades. Revise os dados antes de publicar.
    </p>
  </div>
</div>
<form class="work-form" method="post" action="<%= editando ? `/events/${encodeURIComponent(eventoId)}/edit` : '/events/new' %>">
  <section class="form-section">
    <div class="form-section-heading">
      <span class="form-step">
        01
      </span>
      <div>
        <h2>
          Identidade do evento
        </h2>
        <p>
          Comece pelos dados que apresentam a oportunidade.
        </p>
      </div>
    </div>
    <div class="form-grid">
      <label class="field-full">
        Título
        <span class="required-mark">
          *
        </span>
        <input name="titulo" required minlength="2" maxlength="120" value="<%= valores.titulo %>" placeholder="Ex.: Batalha da Praça 011">
      </label>
      <label>
        Categoria
        <span class="required-mark">
          *
        </span>
        <select name="categoria" required>
          <option value="">
            Selecione
          </option>
          <% categoriasEvento.forEach(categoria => { %>
            <option value="<%= categoria %>"<%= valores.categoria === categoria ? 'selected' : '' %>>
              <%= categoria %>
            </option>
          <% }) %>
        </select>
      </label>
      <label>
        Situação
        <span class="required-mark">
          *
        </span>
        <select name="situacao" required>
          <% situacoesEvento.forEach(situacao => { %>
            <option value="<%= situacao %>"<%= valores.situacao === situacao ? 'selected' : '' %>>
              <%= situacao %>
            </option>
          <% }) %>
        </select>
      </label>
      <label>
        Participação
        <span class="required-mark">
          *
        </span>
        <select name="tipoParticipacao" required>
          <option value="aberta"<%= valores.tipoParticipacao === 'aberta' ? 'selected' : '' %>>
            Aberta — participação registrada na hora
          </option>
          <option value="aprovacao"<%= valores.tipoParticipacao === 'aprovacao' ? 'selected' : '' %>>
            Mediante aprovação — solicitar participação
          </option>
        </select>
      </label>
      <label>
        Data
        <span class="required-mark">
          *
        </span>
        <input type="date" name="data" required value="<%= valores.data %>">
      </label>
      <label>
        Horário
        <span class="optional-mark">
          Opcional
        </span>
        <input name="horario" maxlength="20" value="<%= valores.horario %>" placeholder="Ex.: 19h30">
      </label>
      <label class="field-full">
        Local ou link
        <span class="required-mark">
          *
        </span>
        <input name="local" required maxlength="160" value="<%= valores.local %>" placeholder="Ex.: Galpão 9 · Belo Horizonte, MG">
      </label>
    </div>
  </section>
  <section class="form-section">
    <div class="form-section-heading">
      <span class="form-step">
        02
      </span>
      <div>
        <h2>
          Organização
        </h2>
        <p>
          Ajude as pessoas a entenderem quem realiza e como participar.
        </p>
      </div>
    </div>
    <div class="form-grid">
      <label>
        Organizador
        <span class="required-mark">
          *
        </span>
        <input name="organizador" required maxlength="120" value="<%= valores.organizador %>" placeholder="Nome do coletivo ou organização">
      </label>
      <label>
        Formato
        <span class="required-mark">
          *
        </span>
        <input name="formato" required maxlength="120" value="<%= valores.formato %>" placeholder="Ex.: Workshop online · 90 minutos">
      </label>
      <label class="field-full">
        Descrição
        <span class="optional-mark">
          Opcional
        </span>
        <textarea name="descricao" rows="5" maxlength="1000" placeholder="Explique a proposta e para quem é o evento.">
          <%= valores.descricao %>
        </textarea>
      </label>
      <label>
        Inscrições
        <span class="optional-mark">
          Opcional
        </span>
        <input name="inscricao" maxlength="240" value="<%= valores.inscricao %>" placeholder="Ex.: Gratuita · vagas limitadas">
      </label>
      <label>
        Destaque ou prêmio
        <span class="optional-mark">
          Opcional
        </span>
        <input name="premio" maxlength="240" value="<%= valores.premio %>" placeholder="Ex.: Troféu e divulgação">
      </label>
      <label class="field-full">
        Etiquetas
        <span class="optional-mark">
          Separadas por vírgula
        </span>
        <input name="etiquetas" maxlength="260" value="<%= valores.etiquetas %>" placeholder="Ex.: MCs, Presencial, Inscrições abertas">
      </label>
      <label>
        Cor visual
        <span class="required-mark">
          *
        </span>
        <select name="cor" required>
          <% coresEvento.forEach(cor => { %>
            <option value="<%= cor %>"<%= valores.cor === cor ? 'selected' : '' %>>
              <%= cor === 'yellow' ? 'Amarela' : cor === 'green' ? 'Verde' : cor === 'cream' ? 'Creme' : cor === 'blue' ? 'Azul' : cor === 'violet' ? 'Violeta' : 'Vermelha' %>
            </option>
          <% }) %>
        </select>
      </label>
    </div>
  </section>
  <div class="work-form-actions">
    <a class="button button-outline" href="/events">
      Cancelar
    </a>
    <button class="button button-lime" type="submit">
      <span class="lucide-icon" aria-hidden="true">
        <%- icones.circleCheck %>
      </span>
      <%= editando ? 'Salvar alterações' : 'Publicar evento' %>
    </button>
  </div>
</form>
</div>
</main>
</div>
<%- include('../partials/fim-pagina') %>
