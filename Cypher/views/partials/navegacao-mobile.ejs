<%
  const profissional = usuario.tipoConta === 'profissional' && !usuario.demonstracao;
  const destinos = [
    { href: '/descoberta', nome: 'Descoberta', rotas: ['/descoberta', '/'] },
    { href: '/busca', nome: 'Busca', rotas: ['/busca'] },
    profissional
      ? { href: '/espaco-de-trabalho', nome: 'Trabalho', rotas: ['/espaco-de-trabalho', '/minhas-oportunidades'] }
      : { href: '/banco-de-beats', nome: 'Beats', rotas: ['/banco-de-beats'] },
    { href: '/mensagens', nome: 'Mensagens', rotas: ['/mensagens'] },
  ];
  const rotaNavegacao = (typeof caminhoNavegacao === 'string' ? caminhoNavegacao : typeof rotaAtual === 'string' ? rotaAtual : '').split('?')[0];
  const atual = destinos.find(destino => destino.rotas.some(rota =>
    rotaNavegacao === rota || (rota !== '/' && rotaNavegacao.startsWith(rota + '/'))
  ));
%>
<nav class="dc-bottom" aria-label="Atalhos da Cypher">
  <% destinos.forEach(destino => { %>
    <a class="dc-mobile-item" href="<%= destino.href %>"<% if (atual === destino) { %> aria-current="page"<% } %>>
      <span class="dc-mobile-icon" aria-hidden="true"><%- include("componentes/icone-navegacao", { destino: destino.href }) %></span>
      <span class="dc-mobile-label"><%= destino.nome %></span>
    </a>
  <% }) %>
  <button class="dc-mobile-item<%= atual ? '' : ' is-more-section' %>" type="button" data-menu-mobile-open aria-haspopup="dialog" aria-label="Abrir menu da Cypher" aria-controls="menu-cypher-mobile" aria-expanded="false">
    <span class="dc-mobile-icon" aria-hidden="true"><%- icones.menu %></span>
    <span class="dc-mobile-label">Menu</span>
  </button>
</nav>
<%- include("navegacao-conta", { modoMenu: "mobile", path: rotaNavegacao }) %>
