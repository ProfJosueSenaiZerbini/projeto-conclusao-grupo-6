<% if(selo){
  const rotulo = 'Selo profissional de ' + nome;
  let composicaoPublica;
  try {
    if (selo.composicao_json) {
      const composicao = JSON.parse(selo.composicao_json);
      composicao.camadas = composicao.camadas.filter(l => l.mostrar && l.compacta && l.opacidade > 0).map(l => ({ ...l, nome: '' }));
      composicaoPublica = JSON.stringify(composicao);
    }
  } catch {}
%>
  <% if(selo.imagem){ %><img class="cy-selo-marca" src="<%= selo.imagem %>" width="48" height="48" alt="<%= rotulo %>">
  <% } else { %><span class="pf-seal cy-selo-monograma" <% if (composicaoPublica) { %>data-seal-public="<%= composicaoPublica %>" <% } %>data-forma="<%= selo.forma %>" data-cor="<%= selo.cor %>" data-simbolo="<%= selo.simbolo || 'pulso' %>" role="img" aria-label="<%= rotulo %>" title="<%= rotulo %>"><span class="pf-seal-symbol" aria-hidden="true"><%- include('selo-glifo', { simbolo: selo.simbolo }).trim() %></span><span class="pf-seal-letters" aria-hidden="true"><%= selo.letras %></span><span class="pf-seal-rule" aria-hidden="true"></span></span><% } %>
<% } %>
