<% const a = apresentacao;
   const nomeCompleto = a.proprio ? (pessoa.nomeInformado || pessoa.name) : pessoa.name;
   const nome = pessoa.vulgo || nomeCompleto;
   const segundoNome = pessoa.vulgo && pessoa.vulgo.trim().toLocaleLowerCase('pt-BR') !== nomeCompleto.trim().toLocaleLowerCase('pt-BR') ? nomeCompleto : '';
   const retrato = a.foto;
   const capa = a.capa || a.destaque?.imagem;
   const slug = encodeURIComponent(pessoa.handle.replace(/^@/, ''));
   const publica = '/artistas/' + slug;
   const temPublico = !a.proprio || pessoa.profilePublic;
%>
<article class="pf-identity" aria-labelledby="artista-nome">
  <div class="pf-cover<%= capa ? ' has-art' : '' %><%= a.selo ? ' pf-cover-com-selo' : '' %>">
    <% if (capa) { %><img class="pf-cover-art" src="<%= capa %>" alt="" fetchpriority="high"><% } %>
    <div class="pf-signature">
      <div class="pf-portrait" aria-hidden="true"><% if (retrato) { %><img src="<%= retrato %>" alt="" fetchpriority="high"><% } else { %><span><%= pessoa.initials %></span><% } %></div>
      <div class="pf-names"><h2 id="artista-nome"><%= nome %></h2>
        <% if (pessoa.handle !== nome) { %><p class="pf-handle"><%= pessoa.handle %></p><% } %>
        <% if (segundoNome) { %><p class="pf-fullname"><%= segundoNome %></p><% } %>
        <% if (pessoa.categories.length) { %><ul class="pf-roles" aria-label="Atuações profissionais"><% for (const c of pessoa.categories) { %><li><%= pessoa.rotulosCategorias[c] || c %></li><% } %></ul><% } %>
      </div>
    </div>
    <% if (a.selo) { %>
      <div class="pf-selo-assinatura">
        <div class="pf-selo-suporte"><%- include("selo-assinatura", { selo: a.selo, nome }) %></div>
        <span class="pf-selo-legenda" aria-hidden="true">Selo profissional</span>
        <% if (a.outraPessoa) { %><%- include("denunciar-item", { tipo: "selo", id: a.selo.id, rotulo: "Denunciar este selo" }) %><% } %>
      </div>
    <% } %>
    <% if (a.destaque) { %><a class="pf-cover-credit" href="<%= a.destaque.url %>"><%- icones.disc %><span><small>Do acervo</small><strong><%= a.destaque.titulo %></strong></span></a><% } %>
  </div>
  <div class="pf-identity-foot">
    <div class="pf-intro">
      <% if (pessoa.biography && (a.aba !== 'sobre' || pessoa.biography.length <= 165)) { %>
        <p><%= pessoa.biography.length > 165 ? pessoa.biography.slice(0,162).replace(/\s+\S*$/, '') + '…' : pessoa.biography %>
        <% if (pessoa.biography.length > 165) { %><a class="pf-inline" href="<%= a.url('sobre') %>">Ler biografia</a><% } %></p>
      <% } %>
      <div class="pf-meta">
        <% if (pessoa.city) { %><span><%- icones.mapPin %><%= pessoa.city %></span><% } %>
        <% if (pessoa.availability) { %><span><%- icones.briefcase %><%= pessoa.availabilityLabel %></span><% } %>
        <% if (a.rep) { %><a href="<%= a.url('avaliacoes') %>"><span aria-hidden="true">☆</span><%= a.rep.media === null ? a.rep.estado : a.rep.media.toFixed(1).replace('.',',') + ' / 5 · ' + a.rep.avaliacoes + ' avaliações' %></a><% } %>
      </div>
    </div>
    <div class="pf-actions">
      <% if (a.editavel) { %><a class="pf-button primary" href="/perfil?editar=1#editar-perfil"><%- icones.pen %>Editar perfil</a><% } %>
      <% if (a.outraPessoa) { %><%- include('acoes-conteudo',{tipo:'perfil',id:pessoa.id}) %><% } %>
      <% if (a.conversa) { %><a class="pf-button" href="/mensagens/<%= encodeURIComponent(a.conversa) %>"><%- icones.messageCircle %> Mandar mensagem</a>
      <% } else if (a.iniciarConversa) { %><form method="post" action="/mensagens/iniciar"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="alvo_id" value="<%= pessoa.id %>"><button class="pf-button" type="submit"><%- icones.messageCircle %> Mandar mensagem</button></form>
      <% } else if (a.outraPessoa && pessoa.contact) { %><a class="pf-button" href="<%= a.url('sobre').split('#')[0] %>#contato">Contato</a><% } %>
      <% if (temPublico) { %>
        <button class="pf-button pf-share" type="button" data-share-profile="<%= publica %>"><span class="pf-share-icon" aria-hidden="true"><%- icones.share %></span><span data-share-label>Compartilhar perfil</span></button>
        <span class="pf-sr" data-share-status role="status"></span>
      <% } %>
      <% if (a.outraPessoa) { %><%- include("denunciar-item",{tipo:"perfil",id:pessoa.id,rotulo:"Denunciar este perfil"}) %><% } %>
      <% if ((a.editavel && temPublico) || a.propor || a.representar || (!a.proprio && !a.outraPessoa && typeof usuario !== 'undefined' && usuario.id === pessoa.id)) { %>
        <details class="pf-menu"><summary class="pf-button" aria-label="Mais ações do perfil"><%- icones.more %></summary>
          <div class="pf-menu-list">
            <% if (a.editavel) { %>
              <% if (temPublico) { %><a href="<%= publica %>">Ver perfil público</a><% } %>
            <% } %>
            <% if (!a.proprio && !a.outraPessoa && typeof usuario !== 'undefined' && usuario.id === pessoa.id) { %><a href="/perfil">Voltar ao meu perfil</a><% } %>
            <% if (a.propor) { %><a href="/colaboracoes/novo?destinatario=<%= encodeURIComponent(pessoa.handle) %>">Propor colaboração</a><% } %>
            <% if (a.representar) { %><a href="/representacoes?destinatario=<%= encodeURIComponent(pessoa.handle) %>">Propor representação</a><% } %>
          </div>
        </details>
      <% } %>
    </div>
  </div>
</article>
<% if (temPublico) { %>
  <dialog class="pf-share-dialog" aria-labelledby="pf-share-titulo" data-share-dialog>
    <form method="dialog"><h3 id="pf-share-titulo">Compartilhar perfil</h3><label>Endereço do perfil<input type="url" readonly data-share-url></label><button type="submit" class="pf-button">Fechar</button></form>
  </dialog>
<% } %>
