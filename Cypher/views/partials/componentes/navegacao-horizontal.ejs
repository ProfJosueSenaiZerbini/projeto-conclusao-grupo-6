<div class="dc-rail-nav" role="group" aria-label="<%= rotulo %>" hidden>
  <button class="dc-feature-arrow dc-rail-prev" type="button" tabindex="-1" aria-label="Voltar em <%= titulo %>" aria-controls="<%= faixa %>"><%- icones.arrowLeft %></button>
  <button class="dc-feature-arrow dc-rail-next" type="button" tabindex="-1" aria-label="Avançar em <%= titulo %>" aria-controls="<%= faixa %>"><%- icones.arrowRight %></button>
  <span class="dc-rail-progress" aria-hidden="true"><span></span></span>
</div>
