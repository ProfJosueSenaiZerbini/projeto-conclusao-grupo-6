<%
  const iniciaisSelo = selo?.letras || (usuario.initials || '').normalize('NFC').replace(/[^\p{L}0-9]/gu, '').slice(0, 3);
  const formaAtual = selo?.forma || 'orbita';
  const corAtual = selo?.cor || 'oliva';
  const simboloAtual = selo?.simbolo || 'estrela';
  const glifo = simbolo => include('selo-glifo', { simbolo }).trim();
  const previaSelo = classe => include('selo-previa', { classe, iniciaisSelo, formaAtual, corAtual, simboloAtual, rotulo: 'Prévia do selo: ' + (iniciaisSelo || 'sem iniciais') });
%>
<section id="profile-editor-selo" class="pf-seal-editor pf-seal-studio" aria-labelledby="meu-selo">
  <% if (seloResultado === 'salvo' && selo) { %>
    <div class="pf-seal-reveal" role="status"><span class="pf-seal-reveal-icon" aria-hidden="true">✦</span><div><strong>Seu selo está no ar.</strong><span>A nova versão já aparece no perfil.</span></div><a href="/perfil">Ver meu perfil ↗</a></div>
  <% } else if (seloResultado === 'retirado') { %>
    <div class="pf-seal-reveal" role="status"><span class="pf-seal-reveal-icon" aria-hidden="true">✓</span><div><strong>Selo retirado do perfil.</strong><span>Você pode criar outro quando quiser.</span></div></div>
  <% } %>
  <div class="pf-seal-studio-heading">
    <div><span class="pf-seal-eyebrow">ESTÚDIO DE IDENTIDADE</span><h3 id="meu-selo">Selo profissional</h3><p>Crie a assinatura que aparece no seu perfil e nos créditos. Comece por um modelo ou monte o selo do zero.</p></div>
    <a class="pf-inline" href="/selos/solicitacoes">Solicitar uso de marca própria ↗</a>
  </div>
  <% if (selo?.imagem) { %>
    <div class="pf-seal-approved"><%- include('selo-assinatura', { selo, nome: usuario.name || usuario.handle }) %><p><strong>Sua marca aprovada está em uso.</strong> A prévia abaixo é de um selo novo. Publicá-lo substitui a marca que aparece no perfil.</p></div>
  <% } %>
  <link rel="stylesheet" href="/css/selo-estudio.css">
  <link rel="stylesheet" href="/css/selo-biblioteca.css">
  <div data-selo-estudio hidden
    data-config="<%= JSON.stringify({ formasSelo, coresSelo, recursosEstudio, autor: usuario.id, iniciaisSelo, formaAtual, corAtual, simboloAtual, composicao: selo?.composicao_json || null, imagem: selo?.imagem || null, nome: usuario.name || usuario.handle }) %>">
  </div>
  <script type="module" src="/js/selo-estudio.js"></script>
  <form class="profile-edit-form pf-seal-studio-layout" action="/perfil/selo" method="post" data-seal-editor>
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="pf-seal-stage" aria-label="Prévia ao vivo do selo">
      <div class="pf-seal-stage-body">
      <div class="pf-seal-stage-top"><span>ESTÚDIO DE SELOS</span><span class="pf-seal-stage-live"><i></i> PRÉVIA AO VIVO</span></div>
      <div class="pf-seal-stage-art"><%- previaSelo('pf-seal-hero') %></div>
      <div class="pf-seal-stage-caption"><span>COMPOSIÇÃO</span><strong data-seal-forma-label><%= formasSelo[formaAtual] %></strong></div>
      <div class="pf-seal-context"><span>EM TAMANHO DE PERFIL</span><div><%- previaSelo('pf-seal-context-mark') %><span><strong><%= usuario.name || usuario.handle || 'Seu perfil' %></strong><small>Profissional na Cypher</small></span></div></div>
      </div>
    </div>
    <div class="pf-seal-controls">
      <div class="pf-seal-mobile-preview"><%- previaSelo('pf-seal-context-mark') %><strong>Prévia ao vivo</strong></div>
      <fieldset class="pf-seal-step">
        <legend class="pf-seal-step-title"><span aria-hidden="true">01</span> Forma</legend>
        <div class="pf-seal-formas"><% for (const [id, nome] of Object.entries(formasSelo)) { %>
          <label class="pf-seal-forma-option"><input type="radio" name="forma" value="<%= id %>" data-label="<%= nome %>" <%= formaAtual === id ? 'checked' : '' %>><span class="pf-seal pf-seal-forma-sample" data-forma="<%= id %>" aria-hidden="true"></span><span><%= nome %></span></label>
        <% } %></div>
      </fieldset>
      <div class="pf-seal-step">
        <h4 class="pf-seal-step-title"><span aria-hidden="true">02</span> Monograma</h4>
        <label class="pf-seal-monogram">Letras ou números<input name="letras" value="<%= iniciaisSelo %>" maxlength="3" required aria-describedby="selo-instrucao" autocomplete="off"><small id="selo-instrucao">Use de 1 a 3 letras ou números.</small></label>
      </div>
      <fieldset class="pf-seal-step">
        <legend class="pf-seal-step-title"><span aria-hidden="true">03</span> Símbolo</legend>
        <div class="pf-seal-simbolos"><% for (const [id, nome] of Object.entries(simbolosSelo)) { %>
          <label class="pf-seal-symbol-option"><input type="radio" name="simbolo" value="<%= id %>" <%= simboloAtual === id ? 'checked' : '' %>><span aria-hidden="true"><%- glifo(id) || '—' %></span><small><%= nome %></small></label>
        <% } %></div>
      </fieldset>
      <fieldset class="pf-seal-step">
        <legend class="pf-seal-step-title"><span aria-hidden="true">04</span> Paleta</legend>
        <div class="pf-seal-cores"><% for (const [id, nome] of Object.entries(coresSelo)) { %>
          <label class="pf-seal-color-option" data-cor="<%= id %>"><input type="radio" name="cor" value="<%= id %>" <%= corAtual === id ? 'checked' : '' %>><span class="pf-seal-color-sample" aria-hidden="true"></span><span><%= nome %></span></label>
        <% } %></div>
      </fieldset>
      <div class="profile-edit-actions pf-seal-actions">
        <button class="button button-lime" type="submit"><%= selo ? 'Atualizar meu selo' : 'Criar meu selo' %> <span aria-hidden="true">↗</span></button>
        <button class="button button-outline" type="button" data-seal-surprise hidden>Sortear combinação</button>
        <button class="button button-outline" type="reset" data-seal-reset hidden>Desfazer alterações</button>
        <% if (selo) { %><details class="pf-seal-remove-confirm"><summary>Retirar selo do perfil</summary><p>O selo deixa de aparecer no perfil e nos créditos até você publicar outro.</p><button class="button button-outline" type="submit" name="acao" value="retirar" formnovalidate>Confirmar retirada</button></details><% } %>
      </div>
    </div>
  </form>
</section>
