<% const iniciaisSelo = selo?.letras || usuario.initials.slice(0,3); const formaAtual = selo?.forma || 'orbita'; const corAtual = selo?.cor || 'oliva'; const simboloAtual = selo?.simbolo || 'estrela'; const glifosSelo = {pulso:'⌁', estrela:'✦', raio:'ϟ', alvo:'◎', onda:'≈', flor:'✳'}; %>
<section id="profile-editor-selo" class="pf-seal-editor pf-seal-studio" aria-labelledby="meu-selo">
  <% if (seloResultado === 'salvo' && selo) { %><div class="pf-seal-reveal" role="status"><span class="pf-seal-reveal-icon" aria-hidden="true">✦</span><div><strong>Seu selo está no ar.</strong><span>Essa assinatura agora acompanha sua presença na Cypher. Confira a versão final abaixo.</span></div><a href="/profile">Ver no meu perfil ↗</a></div><% } else if (seloResultado === 'retirado') { %><div class="pf-seal-reveal" role="status"><span class="pf-seal-reveal-icon" aria-hidden="true">✓</span><div><strong>Selo retirado do perfil.</strong><span>Quando quiser, crie uma nova assinatura aqui.</span></div></div><% } %>
  <div class="pf-seal-studio-heading"><div><span class="pf-seal-eyebrow">IDENTIDADE / 01</span><h4 id="meu-selo">Seu nome. Sua marca.</h4><p>Monte um selo com a sua energia. Ele acompanha sua assinatura pelo perfil e pela Cypher.</p></div><a class="pf-inline" href="/selos/solicitacoes">Já tem marca própria? Solicite o uso ↗</a></div>
  <form class="profile-edit-form pf-seal-studio-layout" action="/profile/selo" method="post" data-seal-editor>
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="pf-seal-stage" aria-label="Prévia ao vivo do selo">
      <div class="pf-seal-stage-top"><span><%= seloResultado === 'salvo' ? 'SUA ASSINATURA / ATIVA' : 'ESTÚDIO DE SELOS' %></span><span class="pf-seal-stage-live"><i></i> <%= seloResultado === 'salvo' ? 'NO PERFIL' : 'AO VIVO' %></span></div>
      <div class="pf-seal-stage-art"><span class="pf-seal pf-seal-hero" data-seal-preview data-forma="<%= formaAtual %>" data-cor="<%= corAtual %>" data-simbolo="<%= simboloAtual %>" role="img" aria-label="Prévia do selo"><span class="pf-seal-symbol" aria-hidden="true"><%= glifosSelo[simboloAtual] || glifosSelo.pulso %></span><span class="pf-seal-letters" aria-hidden="true"><%= iniciaisSelo %></span><span class="pf-seal-rule" aria-hidden="true"></span></span></div>
      <div class="pf-seal-stage-caption"><span>ASSINATURA AUTORAL</span><strong data-seal-forma-label><%= formasSelo[formaAtual] || formasSelo.disco %></strong></div>
      <div class="pf-seal-context"><span>COMO APARECE NO PERFIL</span><div><span class="pf-seal pf-seal-context-mark" data-seal-preview data-forma="<%= formaAtual %>" data-cor="<%= corAtual %>" data-simbolo="<%= simboloAtual %>" role="img" aria-label="Prévia do selo em tamanho de perfil"><span class="pf-seal-symbol" aria-hidden="true"><%= glifosSelo[simboloAtual] || glifosSelo.pulso %></span><span class="pf-seal-letters" aria-hidden="true"><%= iniciaisSelo %></span><span class="pf-seal-rule" aria-hidden="true"></span></span><span><strong><%= usuario.nome || 'Seu perfil' %></strong><small>Profissional na Cypher</small></span></div></div>
    </div>
    <div class="pf-seal-controls">
      <div class="pf-seal-step"><div class="pf-seal-step-title"><span>01</span><div><strong>Escolha a composição</strong><small>Cada estrutura tem uma presença diferente.</small></div></div><div class="pf-seal-formas"><% for (const [id, nome] of Object.entries(formasSelo)) { %><label class="pf-seal-forma-option"><input type="radio" name="forma" value="<%= id %>" <%= formaAtual === id ? 'checked' : '' %>><span class="pf-seal-forma-sample" data-forma="<%= id %>" aria-hidden="true"><i></i></span><span><%= nome %></span></label><% } %></div></div>
      <div class="pf-seal-step"><div class="pf-seal-step-title"><span>02</span><div><strong>Defina a assinatura</strong><small>Suas iniciais no centro da peça.</small></div></div><label class="pf-seal-monogram">Letras ou números<input name="letras" value="<%= iniciaisSelo %>" maxlength="3" required aria-describedby="selo-instrucao" autocomplete="off"><small id="selo-instrucao">Até 3 caracteres. A prévia muda enquanto você digita.</small></label></div>
      <div class="pf-seal-step"><div class="pf-seal-step-title"><span>03</span><div><strong>Adicione um símbolo</strong><small>Um detalhe que vira sua assinatura.</small></div></div><div class="pf-seal-simbolos"><% for (const [id, nome] of Object.entries(simbolosSelo)) { %><label class="pf-seal-symbol-option"><input type="radio" name="simbolo" value="<%= id %>" <%= simboloAtual === id ? 'checked' : '' %>><span aria-hidden="true"><%= glifosSelo[id] %></span><small><%= nome %></small></label><% } %></div></div>
      <div class="pf-seal-step"><div class="pf-seal-step-title"><span>04</span><div><strong>Dê cor à sua marca</strong><small>Paletas pensadas para aparecer bem em todo lugar.</small></div></div><div class="pf-seal-cores"><% for (const [id, nome] of Object.entries(coresSelo)) { %><label class="pf-seal-color-option" data-cor="<%= id %>"><input type="radio" name="cor" value="<%= id %>" <%= corAtual === id ? 'checked' : '' %>><span class="pf-seal-color-sample" aria-hidden="true"></span><span><%= nome %></span></label><% } %></div></div>
      <div class="profile-edit-actions pf-seal-actions"><button class="button button-lime" type="submit"><%= selo ? 'Atualizar meu selo' : 'Criar meu selo' %> <span aria-hidden="true">↗</span></button><button class="button button-outline pf-seal-surprise" type="button" data-seal-surprise>Me surpreenda ✦</button><% if (selo) { %><button class="button button-outline pf-seal-remove" name="acao" value="retirar" formnovalidate>Retirar selo</button><% } %></div>
    </div>
  </form>
</section>
