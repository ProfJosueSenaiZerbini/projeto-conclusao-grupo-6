<header class="topbar">
  <button class="icon-button mobile-menu" type="button" data-sidebar-open aria-label="Abrir menu de navegação">
    <span class="lucide-icon" aria-hidden="true">
      <%- icones.menu %>
    </span>
  </button>
  <div class="breadcrumbs">
    <span>
      Workspace
    </span>
    <span class="breadcrumb-separator" aria-hidden="true">
      /
    </span>
    <strong>
      <%= breadcrumb %>
    </strong>
  </div>
  <div class="topbar-actions">
    <% if (typeof showSearch !== 'undefined' && showSearch) { %>
      <a class="topbar-search" href="/search">
        <span class="lucide-icon" aria-hidden="true">
          <%- icones.search %>
        </span>
        Buscar pessoas
      </a>
    <% } %>
    <% if (authenticated && typeof notificacoesRecentes !== 'undefined') { %>
      <div class="notifications-menu" data-notifications>
        <button class="icon-button notifications-trigger" type="button" data-notifications-trigger aria-label="Abrir notificações" aria-expanded="false" aria-controls="notifications-panel" >
          <span class="lucide-icon" aria-hidden="true">
            <%- icones.bell %>
          </span>
          <% if (quantidadeNotificacoesNaoLidas > 0) { %>
            <span class="notifications-count" aria-label="<%= quantidadeNotificacoesNaoLidas %>&#32;não lidas">
              <%= quantidadeNotificacoesNaoLidas > 99 ? '99+' : quantidadeNotificacoesNaoLidas %>
            </span>
          <% } %>
        </button>
        <div class="notifications-panel" id="notifications-panel" data-notifications-panel hidden>
          <div class="notifications-panel-header">
            <div>
              <span class="eyebrow">
                ATIVIDADE
              </span>
              <h2>
                Notificações
              </h2>
            </div>
            <form method="post" action="/notificacoes/marcar-todas-lidas" data-notifications-read-all>
              <button type="submit" class="notifications-read-all"<%= quantidadeNotificacoesNaoLidas === 0 ? ' disabled' : '' %>>
                Marcar todas como lidas
              </button>
            </form>
          </div>
          <div class="notifications-list" data-notifications-list>
            <% if (notificacoesRecentes.length === 0) { %>
              <div class="notifications-empty">
                <span class="lucide-icon" aria-hidden="true">
                  <%- icones.bell %>
                </span>
                <strong>
                  Não há notificações ainda
                </strong>
                <p>
                  Você receberá notificações quando houver uma nova atividade relevante.
                </p>
              </div>
            <% } else { %>
              <% notificacoesRecentes.forEach(notificacao => { %>
                <article class="notification-item<%= notificacao.lida ? '' : ' is-unread' %>" data-notification-item data-notification-id="<%= notificacao.id %>">
                  <a href="<%= notificacao.url || '/notificacoes' %>" class="notification-link">
                    <span class="notification-dot" aria-hidden="true">
                    </span>
                    <span class="notification-copy">
                      <strong>
                        <%= notificacao.titulo %>
                      </strong>
                      <% if (notificacao.mensagem) { %>
                        <span>
                          <%= notificacao.mensagem %>
                        </span>
                      <% } %>
                      <small>
                        <%= notificacao.dataRelativa %>
                      </small>
                    </span>
                  </a>
                  <% if (!notificacao.lida) { %>
                    <form method="post" action="/notificacoes/<%= notificacao.id %>/lida" data-notification-read>
                      <button type="submit" class="notification-read" aria-label="Marcar como lida" title="Marcar como lida">
                        <span class="lucide-icon" aria-hidden="true">
                          <%- icones.check %>
                        </span>
                      </button>
                    </form>
                  <% } %>
                </article>
              <% }) %>
            <% } %>
          </div>
          <a class="notifications-see-all" href="/notificacoes">
            Ver todas as notificações
            <span aria-hidden="true">
              ↗
            </span>
          </a>
        </div>
      </div>
    <% } %>
    <a class="topbar-avatar" href="/profile" aria-label="Abrir perfil de<%= usuario.name %>" title="Perfil de<%= usuario.name %>">
      <%= usuario.initials %>
    </a>
  </div>
</header>
