<!DOCTYPE html>
<html lang="pt-BR">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>CYPHER — Perfil de <%= typeof perfil !=='undefined' && perfil.nome ? perfil.nome : 'Marina Costa' %>
  </title>
  <!-- CSS da página (peça em seguida) -->
  <link rel="stylesheet" href="/css/perfil.css">
  <!-- Fonte Inter -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap"
    rel="stylesheet">
</head>

<body class="dashboard-page profile-page">

  <div class="app-layout">

    <!-- SIDEBAR DE NAVEGAÇÃO LATERAL -->
    <aside class="sidebar">
      <div class="sidebar-header">
        <a href="/dashboard" class="brand-logo-link">
          <span class="brand-title">CYPHER</span>
        </a>

        <div class="workspace-selector">
          <div class="workspace-info">
            <span class="workspace-dot"></span>
            <span class="workspace-name">Espaço de trabalho</span>
          </div>
          <svg class="chevron-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
            stroke-width="2">
            <polyline points="6 9 12 15 18 9" />
          </svg>
        </div>
      </div>

      <nav class="sidebar-nav">
        <div class="nav-section">
          <span class="nav-section-title">NAVEGAR</span>
          <a href="/dashboard" class="nav-link">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" />
              <polyline points="9 22 9 12 15 12 15 22" />
            </svg>
            <span>Início</span>
          </a>
          <a href="/artistas" class="nav-link">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="11" cy="11" r="8" />
              <line x1="21" y1="21" x2="16.65" y2="16.65" />
            </svg>
            <span>Buscar pessoas</span>
          </a>
          <a href="/oportunidades" class="nav-link">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="2" y="7" width="20" height="14" rx="2" ry="2" />
              <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16" />
            </svg>
            <span>Oportunidades</span>
          </a>
          <a href="/obras" class="nav-link">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M9 18V5l12-2v13" />
              <circle cx="6" cy="18" r="3" />
              <circle cx="18" cy="16" r="3" />
            </svg>
            <span>Obras e créditos</span>
          </a>
          <a href="/beats" class="nav-link">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5" />
              <path d="M19.07 4.93a10 10 0 0 1 0 14.14" />
              <path d="M15.54 8.46a5 5 0 0 1 0 7.07" />
            </svg>
            <span>Banco de Beats</span>
          </a>
        </div>

        <div class="nav-section">
          <span class="nav-section-title">SEU ESPAÇO</span>
          <a href="/perfil" class="nav-link active">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
              <circle cx="12" cy="7" r="4" />
            </svg>
            <span>Meu perfil</span>
          </a>
          <a href="/configuracoes" class="nav-link">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="3" />
              <path
                d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z" />
            </svg>
            <span>Configurações</span>
          </a>
        </div>
      </nav>

      <div class="sidebar-footer">
        <div class="reputation-card">
          <div class="reputation-header">
            <span class="reputation-label">REPUTAÇÃO PROFISSIONAL</span>
          </div>
          <div class="reputation-score">
            <span class="score-number">
              <%= typeof perfil !=='undefined' && perfil.reputacao ? perfil.reputacao : '78' %>
            </span>
            <span class="score-total">/100</span>
          </div>
          <div class="reputation-bar">
            <div class="reputation-fill"
              style="width: <%= typeof perfil !== 'undefined' && perfil.reputacao ? perfil.reputacao : 78 %>%;"></div>
          </div>
        </div>

        <div class="user-profile-summary">
          <div class="user-avatar">
            <span>
              <%= typeof perfil !=='undefined' && perfil.nome ? perfil.nome.substring(0,2).toUpperCase() : 'MC' %>
            </span>
          </div>
          <div class="user-meta">
            <span class="user-name">
              <%= typeof perfil !=='undefined' && perfil.nome ? perfil.nome : 'Marina Costa' %>
            </span>
            <span class="user-role">
              <%= typeof perfil !=='undefined' && perfil.categoria ? perfil.categoria : 'Rapper / MC' %>
            </span>
          </div>
          <a href="/logout" class="btn-logout" title="Sair">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" />
              <polyline points="16 17 21 12 16 7" />
              <line x1="21" y1="12" x2="9" y2="12" />
            </svg>
          </a>
        </div>
      </div>
    </aside>

    <!-- ÁREA DE CONTEÚDO PRINCIPAL -->
    <main class="main-content">

      <!-- HEADER / BANNER DE CAPA DO PERFIL -->
      <section class="profile-hero-card">
        <div class="profile-cover"></div>

        <div class="profile-header-body">
          <div class="profile-avatar-wrapper">
            <div class="profile-avatar-large">
              <span>
                <%= typeof perfil !=='undefined' && perfil.nome ? perfil.nome.substring(0,2).toUpperCase() : 'MC' %>
              </span>
            </div>
          </div>

          <div class="profile-main-info">
            <div class="profile-title-row">
              <div>
                <h1 class="profile-name">
                  <%= typeof perfil !=='undefined' && perfil.nome ? perfil.nome : 'Marina Costa' %>
                </h1>
                <span class="profile-tagline">
                  <%= typeof perfil !=='undefined' && perfil.categoria ? perfil.categoria : 'Rapper / MC & Compositora'
                    %> · <%= typeof perfil !=='undefined' && perfil.cidade ? perfil.cidade : 'São Paulo, SP' %>
                </span>
              </div>

              <div class="profile-actions">
                <% if (typeof eProprioPerfil !=='undefined' && eProprioPerfil) { %>
                  <a href="/configuracoes" class="btn-primary-gold">Editar Perfil</a>
                  <% } else { %>
                    <a href="/conectar" class="btn-primary-gold">Conectar</a>
                    <a href="/mensagem" class="btn-secondary-outline">Enviar Mensagem</a>
                    <% } %>
              </div>
            </div>

            <!-- Métricas Rápidas -->
            <div class="profile-stats-bar">
              <div class="stat-item">
                <span class="stat-value">
                  <%= typeof perfil !=='undefined' && perfil.numObras ? perfil.numObras : '12' %>
                </span>
                <span class="stat-label">Obras registradas</span>
              </div>
              <div class="stat-divider"></div>
              <div class="stat-item">
                <span class="stat-value">
                  <%= typeof perfil !=='undefined' && perfil.numConexoes ? perfil.numConexoes : '142' %>
                </span>
                <span class="stat-label">Conexões na cena</span>
              </div>
              <div class="stat-divider"></div>
              <div class="stat-item">
                <span class="stat-value">
                  <%= typeof perfil !=='undefined' && perfil.reputacao ? perfil.reputacao : '78' %>/100
                </span>
                <span class="stat-label">Reputação CYPHER</span>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- CONTEÚDO PRINCIPAL DO PERFIL (COLUNA DUPLA) -->
      <div class="profile-grid">

        <!-- COLUNA ESQUERDA: BIOGRAFIA E INFORMAÇÕES -->
        <div class="profile-column-left">

          <div class="content-panel">
            <div class="panel-header">
              <div>
                <span class="panel-kicker">SOBRE O ARTISTA</span>
                <h3 class="panel-title">Trajetória & Visão</h3>
              </div>
            </div>

            <p class="profile-bio-text">
              <%= typeof perfil !=='undefined' && perfil.bio ? perfil.bio
                : 'Atuante no Boom Bap e Trap desde 2018. Foco em composições com forte carga social e lírica afiada. Buscando produtores e beatmakers para o lançamento do próximo EP visual.'
                %>
            </p>

            <div class="skills-tags-container">
              <span class="skill-tag">Composição</span>
              <span class="skill-tag">Flow & Rima</span>
              <span class="skill-tag">Freestyle</span>
              <span class="skill-tag">Direção Artística</span>
            </div>
          </div>

          <!-- Redes e Links Úteis -->
          <div class="content-panel">
            <div class="panel-header">
              <div>
                <span class="panel-kicker">LINKS EXTERNOS</span>
                <h3 class="panel-title">Onde encontrar</h3>
              </div>
            </div>

            <div class="social-links-list">
              <a href="#" class="social-link-item" target="_blank" rel="noopener">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M9 18V5l12-2v13" />
                  <circle cx="6" cy="18" r="3" />
                  <circle cx="18" cy="16" r="3" />
                </svg>
                <span>Spotify / Plural</span>
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <line x1="7" y1="17" x2="17" y2="7" />
                  <polyline points="7 7 17 7 17 17" />
                </svg>
              </a>
              <a href="#" class="social-link-item" target="_blank" rel="noopener">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <rect x="2" y="2" width="20" height="20" rx="5" ry="5" />
                  <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z" />
                  <line x1="17.5" y1="6.5" x2="17.51" y2="6.5" />
                </svg>
                <span>Instagram</span>
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <line x1="7" y1="17" x2="17" y2="7" />
                  <polyline points="7 7 17 7 17 17" />
                </svg>
              </a>
              <a href="#" class="social-link-item" target="_blank" rel="noopener">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path
                    d="M22.54 6.42a2.78 2.78 0 0 0-1.94-2C18.88 4 12 4 12 4s-6.88 0-8.6.46a2.78 2.78 0 0 0-1.94 2A29 29 0 0 0 1 11.75a29 29 0 0 0 .46 5.33A2.78 2.78 0 0 0 3.4 19c1.72.46 8.6.46 8.6.46s6.88 0 8.6-.46a2.78 2.78 0 0 0 1.94-2 29 29 0 0 0 .46-5.25 29 29 0 0 0-.46-5.33z" />
                  <polygon points="9.75 15.02 15.5 11.75 9.75 8.48 9.75 15.02" />
                </svg>
                <span>YouTube / Clipes</span>
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <line x1="7" y1="17" x2="17" y2="7" />
                  <polyline points="7 7 17 7 17 17" />
                </svg>
              </a>
            </div>
          </div>

        </div>

        <!-- COLUNA DIREITA: OBRAS E BEATS CADASTRADOS -->
        <div class="profile-column-right">

          <div class="content-panel">
            <div class="panel-header">
              <div>
                <span class="panel-kicker">PORTFÓLIO & DISCOGRAFIA</span>
                <h3 class="panel-title">Obras e Créditos Verificados</h3>
              </div>
            </div>

            <div class="profile-works-list">
              <% if (typeof obras !=='undefined' && obras.length> 0) { %>
                <% obras.forEach(function(obra) { %>
                  <div class="work-card-item">
                    <div class="work-icon-box">
                      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                        stroke-width="2">
                        <path d="M9 18V5l12-2v13" />
                        <circle cx="6" cy="18" r="3" />
                        <circle cx="18" cy="16" r="3" />
                      </svg>
                    </div>
                    <div class="work-details">
                      <h4 class="work-title">
                        <%= obra.titulo %>
                      </h4>
                      <span class="work-role">Função: <%= obra.funcao %> · Lançamento: <%= obra.ano %></span>
                    </div>
                    <span class="work-badge">Verificado</span>
                  </div>
                  <% }); %>
                    <% } else { %>
                      <!-- Fallback visual para demonstração -->
                      <div class="work-card-item">
                        <div class="work-icon-box">
                          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                            stroke-width="2">
                            <path d="M9 18V5l12-2v13" />
                            <circle cx="6" cy="18" r="3" />
                            <circle cx="18" cy="16" r="3" />
                          </svg>
                        </div>
                        <div class="work-details">
                          <h4 class="work-title">Esquina da Resistência</h4>
                          <span class="work-role">Função: Letrista e MC principal · Lançamento: 2024</span>
                        </div>
                        <span class="work-badge">Verificado</span>
                      </div>

                      <div class="work-card-item">
                        <div class="work-icon-box">
                          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                            stroke-width="2">
                            <path d="M9 18V5l12-2v13" />
                            <circle cx="6" cy="18" r="3" />
                            <circle cx="18" cy="16" r="3" />
                          </svg>
                        </div>
                        <div class="work-details">
                          <h4 class="work-title">Noites de Concreto</h4>
                          <span class="work-role">Função: Co-autora · Lançamento: 2023</span>
                        </div>
                        <span class="work-badge">Verificado</span>
                      </div>
                      <% } %>
            </div>
          </div>

        </div>

      </div>

    </main>
  </div>

  <!-- NAVIGATION MOBILE -->
  <nav class="bottom-nav">
    <a href="/dashboard" class="bottom-nav-item">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" />
        <polyline points="9 22 9 12 15 12 15 22" />
      </svg>
      <span>Início</span>
    </a>
    <a href="/artistas" class="bottom-nav-item">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <circle cx="11" cy="11" r="8" />
        <line x1="21" y1="21" x2="16.65" y2="16.65" />
      </svg>
      <span>Buscar</span>
    </a>
    <a href="/obras" class="bottom-nav-item">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M9 18V5l12-2v13" />
        <circle cx="6" cy="18" r="3" />
        <circle cx="18" cy="16" r="3" />
      </svg>
      <span>Obras</span>
    </a>
    <a href="/perfil" class="bottom-nav-item active">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
        <circle cx="12" cy="7" r="4" />
      </svg>
      <span>Perfil</span>
    </a>
  </nav>

</body>

</html>