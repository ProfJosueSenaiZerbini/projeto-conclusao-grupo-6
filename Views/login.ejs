<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CYPHER — Access Hub</title>
    <!-- CSS da página -->
    <link rel="stylesheet" href="/css/login.css">
    <!-- Fonte Inter para tipografia moderna -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
</head>
<body class="login-page">

    <!-- Header fixo com a marca em destaque -->
    <header class="top-bar">
        <span class="top-brand">CYPHER</span>
    </header>

    <!-- Container Principal de Autenticação -->
    <main class="auth-wrapper">
        <div class="auth-card">
            
            <!-- ÁREA DA LOGO E HERO DA MARCA -->
            <div class="brand-header">
                <div class="logo-container">
                    <img src="/images/logo-cypher.svg" alt="Cypher Logo" class="brand-logo" onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';">
                    
                    <!-- Box visual para visualização caso a logo ainda não esteja na pasta de imagens -->
                    <div class="logo-box-fallback">
                        <svg class="fallback-icon" width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/>
                        </svg>
                        <span class="fallback-text">LOGO</span>
                    </div>
                </div>
                <h2 class="auth-subtitle">Conectando as ruas ao mundo!</h2>
            </div>

            <!-- Feedback de Alertas do Backend via EJS -->
            <% if (typeof error !== 'undefined' && error) { %>
                <div class="alert alert-error" role="alert">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="10"/>
                        <line x1="12" y1="8" x2="12" y2="12"/>
                        <line x1="12" y1="16" x2="12.01" y2="16"/>
                    </svg>
                    <span><%= error %></span>
                </div>
            <% } %>

            <% if (typeof success !== 'undefined' && success) { %>
                <div class="alert alert-success" role="alert">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
                        <polyline points="22 4 12 14.01 9 11.01"/>
                    </svg>
                    <span><%= success %></span>
                </div>
            <% } %>

            <!-- Formulário Principais de Acesso -->
            <form action="/login" method="POST" class="auth-form" novalidate>
                
                <!-- Campo E-mail -->
                <div class="input-group">
                    <label for="email" class="input-label">Email</label>
                    <div class="input-field-wrapper">
                        <input 
                            type="email" 
                            id="email" 
                            name="email" 
                            class="input-field" 
                            placeholder="cypher@exemplo.com" 
                            value="<%= typeof oldInput !== 'undefined' ? oldInput.email : '' %>"
                            required
                            autocomplete="email"
                        >
                    </div>
                </div>

                <!-- Campo Senha -->
                <div class="input-group">
                    <label for="senha" class="input-label">Senha</label>
                    <div class="input-field-wrapper password-group">
                        <input 
                            type="password" 
                            id="senha" 
                            name="senha" 
                            class="input-field" 
                            placeholder="••••••••••••" 
                            required
                            autocomplete="current-password"
                        >
                        <div class="password-icon-box" aria-hidden="true">
                            <svg class="eye-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
                                <circle cx="12" cy="12" r="3"/>
                            </svg>
                        </div>
                    </div>
                </div>

                <!-- Botões de Ação Primária -->
                <div class="action-buttons">
                    <button type="submit" class="btn btn-solid">
                        <span>Entrar</span>
                    </button>
                    
                    <a href="/cadastro" class="btn btn-outline">
                        <span>Criar</span>
                    </a>
                </div>

                <!-- Link de Recuperação -->
                <div class="forgot-wrapper">
                    <a href="/esqueci-senha" class="forgot-link">Esqueceu a Senha?</a>
                </div>

                <!-- Separador Estilizado -->
                <div class="auth-divider">
                    <span class="divider-line"></span>
                    <span class="divider-text">OU</span>
                    <span class="divider-line"></span>
                </div>

                <!-- Acesso Convidado -->
                <div class="guest-wrapper">
                    <a href="/explorar" class="btn btn-guest">
                        <span>Continuar como convidado.</span>
                    </a>
                </div>

            </form>
        </div>
    </main>

    <!-- Bottom Navigation Bar (Mobile) -->
    <nav class="bottom-nav">
        <a href="/login" class="bottom-nav-item active">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"/>
                <polyline points="10 17 15 12 10 7"/>
                <line x1="15" y1="12" x2="3" y2="12"/>
            </svg>
            <span>Entrar</span>
        </a>
        <a href="/explorar" class="bottom-nav-item">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
                <circle cx="12" cy="7" r="4"/>
            </svg>
            <span>Convidado</span>
        </a>
    </nav>

</body>
</html>