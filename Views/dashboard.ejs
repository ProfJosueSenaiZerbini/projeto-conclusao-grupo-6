<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CYPHER — Dashboard</title>
    <!-- CSS da página (peça em seguida) -->
    <link rel="stylesheet" href="/css/dashboard.css">
    <!-- Fonte Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap"
        rel="stylesheet">
</head>

<body class="dashboard-page">

    <!-- ESTRUTURA DE LAYOUT MAIN APP (SIDEBAR + CONTEÚDO) -->
    <div class="app-layout">

        <!-- ÁREA DE CONTEÚDO PRINCIPAL (MAIN CONTENT) -->
        <main class="main-content">

            <!-- BARRA DE CABEÇALHO DO PAINEL -->
            <header class="content-header">
                <div class="welcome-block">
                    <h1 class="welcome-title">A cena se move quando a gente se conecta.</h1>
                    <p class="welcome-subtitle">Bom te ver, <%= typeof usuario !=='undefined' && usuario.nome ?
                            usuario.nome.split(' ')[0] : ' Marina' %>. Aqui está o que está acontecendo no seu espaço.
                    </p>
                </div>

                <div class="quick-search-box">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="11" cy="11" r="8" />
                        <line x1="21" y1="21" x2="16.65" y2="16.65" />
                    </svg>
                    <input type="text" placeholder="Busca rápida..." class="quick-search-input">
                    <kbd class="search-shortcut">⌘ K</kbd>
                </div>
            </header>

            <!-- SEÇÃO DE CARDS HERO SUPERIORES -->
            <section class="hero-grid">

                <!-- Card Principal de Ação (Verde Destaque) -->
                <div class="hero-card action-banner">
                    <div class="banner-tag">
                        <span>SEU CICLO</span>
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                            stroke-width="2">
                            <line x1="7" y1="17" x2="17" y2="7" />
                            <polyline points="7 7 17 7 17 17" />
                        </svg>
                    </div>

                    <h2 class="banner-headline">Descobrir.<br>Conectar.<br>Criar.</h2>

                    <div class="banner-footer">
                        <div class="step-indicator">
                            <span class="step-badge">01</span>
                            <div class="step-text">
                                <span class="step-label">Próximo passo</span>
                                <span class="step-title">Encontrar colaboradores</span>
                            </div>
                        </div>
                        <a href="/artistas" class="btn-banner-action">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                stroke-width="2">
                                <line x1="5" y1="12" x2="19" y2="12" />
                                <polyline points="12 5 19 12 12 19" />
                            </svg>
                        </a>
                    </div>
                </div>

                <!-- Coluna de Cards de Métricas (Amarelo / Grafite) -->
                <div class="metrics-column">
                    <div class="metric-card gold-card">
                        <div class="metric-icon">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                stroke-width="2">
                                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
                                <polyline points="14 2 14 8 20 8" />
                            </svg>
                        </div>
                        <span class="metric-title">Obras em andamento</span>
                        <div class="metric-value-box">
                            <span class="metric-number">
                                <%= typeof obrasContador !=='undefined' ? obrasContador : '03' %>
                            </span>
                            <span class="metric-badge">+1 este mês</span>
                        </div>
                    </div>

                    <div class="metric-card dark-card">
                        <div class="metric-icon">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                stroke-width="2">
                                <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" />
                                <circle cx="9" cy="7" r="4" />
                                <path d="M23 21v-2a4 4 0 0 0-3-3.87" />
                                <path d="M16 3.13a4 4 0 0 1 0 7.75" />
                            </svg>
                        </div>
                        <span class="metric-title">Conexões profissionais</span>
                        <div class="metric-value-box">
                            <span class="metric-number">
                                <%= typeof conexoesContador !=='undefined' ? conexoesContador : '28' %>
                            </span>
                            <span class="metric-subtext">4 aguardando resposta</span>
                        </div>
                    </div>
                </div>

                <!-- Card de Ideia do Dia -->
                <div class="hero-card quote-card">
                    <div class="quote-header">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                            stroke-width="2">
                            <polygon
                                points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" />
                        </svg>
                        <span>IDEIA DO DIA</span>
                    </div>
                    <blockquote class="quote-content">
                        “Crédito bem organizado abre portas que o talento sozinho não abre.”
                    </blockquote>
                    <span class="quote-author">— Cypher Central</span>
                </div>

            </section>

            <!-- SEÇÃO DE ATENÇÃO (EVENTOS + SUGESTÕES DE CONEXÃO) -->
            <section class="attention-section">
                <div class="section-title-row">
                    <div>
                        <span class="section-kicker">SEU MAPA AGORA</span>
                        <h2 class="section-heading">O que pede sua atenção</h2>
                    </div>
                    <a href="/explorar" class="link-view-all">
                        <span>Ver tudo</span>
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                            stroke-width="2">
                            <line x1="7" y1="17" x2="17" y2="7" />
                            <polyline points="7 7 17 7 17 17" />
                        </svg>
                    </a>
                </div>

                <div class="attention-grid">

                    <!-- Card: Próximos Eventos -->
                    <div class="content-panel">
                        <div class="panel-header">
                            <div>
                                <span class="panel-kicker">PRÓXIMOS EVENTOS</span>
                                <h3 class="panel-title">Na sua rota</h3>
                            </div>
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                stroke-width="2">
                                <rect x="3" y="4" width="18" height="18" rx="2" ry="2" />
                                <line x1="16" y1="2" x2="16" y2="6" />
                                <line x1="8" y1="2" x2="8" y2="6" />
                                <line x1="3" y1="10" x2="21" y2="10" />
                            </svg>
                        </div>

                        <div class="events-list">
                            <% if (typeof eventos !=='undefined' && eventos.length> 0) { %>
                                <% eventos.forEach(function(evento) { %>
                                    <div class="event-item">
                                        <div class="event-date-badge">
                                            <span class="date-day">
                                                <%= evento.dia %>
                                            </span>
                                            <span class="date-month">
                                                <%= evento.mes %>
                                            </span>
                                        </div>
                                        <div class="event-details">
                                            <h4 class="event-name">
                                                <%= evento.titulo %>
                                            </h4>
                                            <span class="event-location">
                                                <%= evento.categoria %> · <%= evento.local %>
                                            </span>
                                        </div>
                                        <a href="/eventos/<%= evento.id_evento %>" class="btn-event-link">
                                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none"
                                                stroke="currentColor" stroke-width="2">
                                                <polyline points="9 18 15 12 9 6" />
                                            </svg>
                                        </a>
                                    </div>
                                    <% }); %>
                                        <% } else { %>
                                            <!-- Fallback visual para demonstração -->
                                            <div class="event-item">
                                                <div class="event-date-badge">
                                                    <span class="date-day">18</span>
                                                    <span class="date-month">OUT</span>
                                                </div>
                                                <div class="event-details">
                                                    <h4 class="event-name">Batalha da Praça 011</h4>
                                                    <span class="event-location">Batalha · Praça Roosevelt - São
                                                        Paulo</span>
                                                </div>
                                                <a href="/eventos/1" class="btn-event-link">
                                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none"
                                                        stroke="currentColor" stroke-width="2">
                                                        <polyline points="9 18 15 12 9 6" />
                                                    </svg>
                                                </a>
                                            </div>

                                            <div class="event-item">
                                                <div class="event-date-badge">
                                                    <span class="date-day">25</span>
                                                    <span class="date-month">OUT</span>
                                                </div>
                                                <div class="event-details">
                                                    <h4 class="event-name">Cypher Subsolo #08</h4>
                                                    <span class="event-location">Cypher · Galpão 9 - Belo
                                                        Horizonte</span>
                                                </div>
                                                <a href="/eventos/2" class="btn-event-link">
                                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none"
                                                        stroke="currentColor" stroke-width="2">
                                                        <polyline points="9 18 15 12 9 6" />
                                                    </svg>
                                                </a>
                                            </div>
                                            <% } %>
                        </div>

                        <div class="panel-footer">
                            <a href="/oportunidades" class="panel-link">
                                <span>Explorar oportunidades</span>
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                    stroke-width="2">
                                    <line x1="7" y1="17" x2="17" y2="7" />
                                    <polyline points="7 7 17 7 17 17" />
                                </svg>
                            </a>
                        </div>
                    </div>

                    <!-- Card: Pessoas para Conhecer (Sugestão de Conexões) -->
                    <div class="content-panel">
                        <div class="panel-header">
                            <div>
                                <span class="panel-kicker">PESSOAS PARA CONHECER</span>
                                <h3 class="panel-title">Conexões que fazem sentido</h3>
                            </div>
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                stroke-width="2">
                                <path
                                    d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z" />
                            </svg>
                        </div>

                        <div class="connections-list">
                            <% if (typeof sugestoesConexoes !=='undefined' && sugestoesConexoes.length> 0) { %>
                                <% sugestoesConexoes.forEach(function(conexao) { %>
                                    <div class="connection-item">
                                        <div class="user-avatar-small">
                                            <span>
                                                <%= conexao.iniciais %>
                                            </span>
                                        </div>
                                        <div class="connection-details">
                                            <h4 class="connection-name">
                                                <%= conexao.nome %>
                                            </h4>
                                            <span class="connection-role">
                                                <%= conexao.categoria %> · <%= conexao.cidade %>
                                            </span>
                                        </div>
                                        <a href="/artistas/<%= conexao.id_usuario %>" class="btn-connect-icon"
                                            title="Ver perfil">
                                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none"
                                                stroke="currentColor" stroke-width="2">
                                                <line x1="7" y1="17" x2="17" y2="7" />
                                                <polyline points="7 7 17 7 17 17" />
                                            </svg>
                                        </a>
                                    </div>
                                    <% }); %>
                                        <% } else { %>
                                            <!-- Fallback visual para demonstração -->
                                            <div class="connection-item">
                                                <div class="user-avatar-small gold-avatar">
                                                    <span>NS</span>
                                                </div>
                                                <div class="connection-details">
                                                    <h4 class="connection-name">Nina Sincera</h4>
                                                    <span class="connection-role">Rapper / MC · São Paulo, SP</span>
                                                </div>
                                                <a href="/artistas/1" class="btn-connect-icon" title="Ver perfil">
                                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none"
                                                        stroke="currentColor" stroke-width="2">
                                                        <line x1="7" y1="17" x2="17" y2="7" />
                                                        <polyline points="7 7 17 7 17 17" />
                                                    </svg>
                                                </a>
                                            </div>

                                            <div class="connection-item">
                                                <div class="user-avatar-small green-avatar">
                                                    <span>K4</span>
                                                </div>
                                                <div class="connection-details">
                                                    <h4 class="connection-name">Kota 47</h4>
                                                    <span class="connection-role">Beatmaker · Belo Horizonte, MG</span>
                                                </div>
                                                <a href="/artistas/2" class="btn-connect-icon" title="Ver perfil">
                                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none"
                                                        stroke="currentColor" stroke-width="2">
                                                        <line x1="7" y1="17" x2="17" y2="7" />
                                                        <polyline points="7 7 17 7 17 17" />
                                                    </svg>
                                                </a>
                                            </div>

                                            <div class="connection-item">
                                                <div class="user-avatar-small dark-avatar">
                                                    <span>LG</span>
                                                </div>
                                                <div class="connection-details">
                                                    <h4 class="connection-name">Léo Goma</h4>
                                                    <span class="connection-role">Produtor musical · Rio de Janeiro,
                                                        RJ</span>
                                                </div>
                                                <a href="/artistas/3" class="btn-connect-icon" title="Ver perfil">
                                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none"
                                                        stroke="currentColor" stroke-width="2">
                                                        <line x1="7" y1="17" x2="17" y2="7" />
                                                        <polyline points="7 7 17 7 17 17" />
                                                    </svg>
                                                </a>
                                            </div>
                                            <% } %>
                        </div>

                        <div class="panel-footer">
                            <a href="/artistas" class="panel-link">
                                <span>Buscar na cena</span>
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                    stroke-width="2">
                                    <line x1="7" y1="17" x2="17" y2="7" />
                                    <polyline points="7 7 17 7 17 17" />
                                </svg>
                            </a>
                        </div>
                    </div>

                </div>
            </section>

            <!-- BARRA INFERIOR DE MAPA DE PROCESSO (CICLO CYPHER) -->
            <section class="cypher-cycle-section">
                <span class="cycle-kicker">O CICLO CYPHER</span>
                <h3 class="cycle-heading">Da oportunidade à reputação</h3>

                <div class="cycle-stepper">
                    <div class="cycle-step active">
                        <span class="step-num">01</span>
                        <span class="step-name">Descobrir oportunidades</span>
                    </div>
                    <div class="cycle-step active">
                        <span class="step-num">02</span>
                        <span class="step-name">Encontrar profissionais</span>
                    </div>
                    <div class="cycle-step">
                        <span class="step-num">03</span>
                        <span class="step-name">Formar conexões</span>
                    </div>
                    <div class="cycle-step">
                        <span class="step-num">04</span>
                        <span class="step-name">Desenvolver projetos</span>
                    </div>
                    <div class="cycle-step">
                        <span class="step-num">05</span>
                        <span class="step-name">Organizar obras</span>
                    </div>
                    <div class="cycle-step">
                        <span class="step-num">06</span>
                        <span class="step-name">Construir reputação</span>
                    </div>
                </div>
            </section>

        </main>
    </div>

    <!-- BOTTOM NAV (BARRA INFERIOR APENAS NO DISPOSITIVO MOBILE) -->
    <nav class="bottom-nav">
        <a href="/dashboard" class="bottom-nav-item active">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" />
                <polyline points="9 22 9 12 15 12 15 22" />
            </svg>
            <span>Início</span>
        </a>
        <a href="/artistas" class="bottom-nav-item">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="11" cy="11" r="8" />
                <line x1="21" y1="21" x2="16.65" y2="16.65" />
            </svg>
            <span>Buscar</span>
        </a>
        <a href="/obras" class="bottom-nav-item">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M9 18V5l12-2v13" />
                <circle cx="6" cy="18" r="3" />
                <circle cx="18" cy="16" r="3" />
            </svg>
            <span>Obras</span>
        </a>
        <a href="/perfil" class="bottom-nav-item">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
                <circle cx="12" cy="7" r="4" />
            </svg>
            <span>Perfil</span>
        </a>
    </nav>

</body>

</html>